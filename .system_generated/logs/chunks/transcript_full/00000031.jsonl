  border-radius: 8px;\n      padding: 10px 12px;\n      color: #334155;\n      font-size: 11.5px;\n      line-height: 1.5;\n    }\n    body.dark-mode .text-content {\n      background: rgba(255, 255, 255, 0.03);\n      border-color: rgba(255, 255, 255, 0.08);\n      color: #cbd5e1;\n    }\n\n    .citation-box {\n      background: rgba(132, 164, 139, 0.12);\n      border: 1px solid rgba(132, 164, 139, 0.35);\n      border-radius: 8px;\n      padding: 10px 12px;\n      color: #2e5a36;\n      font-size: 11px;\n      line-height: 1.4;\n      font-style: italic;\n    }\n    body.dark-mode .citation-box {\n      color: #a4c3b2;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 14px;\n      left: 14px;\n      right: 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .status-badge {\n      padding: 8px 16px;\n      color: #475569;\n      font-size: 10.5px;\n      letter-spacing: 0.3px;\n      pointer-events: auto;\n    }\n    body.dark-mode .status-badge {\n      color: #94a3b8;\n    }\n    .status-badge b {\n      color: #0f172a;\n      font-family: monospace;\n    }\n    body.dark-mode .status-badge b {\n      color: #84a48b;\n    }\n  </style>\n</head>\n<body class=\"dark-mode\">\n\n  <canvas id=\"viewport\"></canvas>\n\n  <!-- Header Panel -->\n  <div class=\"top-header\">\n    <div class=\"glass-panel brand-title\">\n      <span>🚥 ECOSISTEMA RADIAL DE NUBES Y BUBULAS: KENNEDY - CORABASTOS - ZONA FRANCA</span>\n    </div>\n\n    <div class=\"nav-group\">\n      <button class=\"btn-flat\" onclick=\"toggleDarkMode()\">🌓 Cambiar Fondo (Claro / OLED)</button>\n      <button class=\"btn-flat\" onclick=\"resetCamera()\">Restablecer Vista 3D</button>\n    </div>\n  </div>\n\n  <!-- Inspector Pop-up -->\n  <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid rgba(0,0,0,0.08); padding-bottom:8px;\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Título de Actor / Nodo</div>\n        <div class=\"node-subtitle\" id=\"mNodeCategory\">Cluster Radial</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div style=\"font-size:10px; text-transform:uppercase; color:#64748b; font-weight:800;\">Función Operativa en la Red</div>\n    <div class=\"text-content\" id=\"mNodeDesc\">Descripción detallada.</div>\n\n    <div style=\"font-size:10px; text-transform:uppercase; color:#64748b; font-weight:800;\">📜 Cita Técnica Oficial</div>\n    <div class=\"citation-box\" id=\"mNodeCitation\">Cita oficial.</div>\n\n    <div style=\"display:flex; justify-content:flex-end; margin-top:6px;\">\n      <button class=\"btn-flat\" onclick=\"closeInspector()\">Cerrar</button>\n    </div>\n  </div>\n\n  <!-- Bottom Legend Bar -->\n  <div class=\"bottom-bar\">\n    <div class=\"glass-panel status-badge\">\n      Anillos Radial Ecosistémico: <b>Macro Periferia Regional • Eje Logístico Fontibón • Arterias Kennedy • Núcleo Corabastos</b>\n    </div>\n    <div class=\"glass-panel status-badge\">\n      💡 Inspirado exactamente en la infografía radial de esferas y burbujas • Clic para Ficha • Drag 3D\n    </div>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    let isDark = true;\n    let rotX = 0.25, rotY = 0.45, zoom = 480;\n    let targetRotX = 0.25, targetRotY = 0.45, targetZoom = 480;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n    let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0, clickStartX = 0, clickStartY = 0;\n    let hoveredNode = null, selectedNode = null;\n\n    function toggleDarkMode() {\n      isDark = !isDark;\n      document.body.classList.toggle('dark-mode', isDark);\n    }\n\n    // Dataset adaptado del ecosistema de Kennedy-Corabastos-Zona Franca conservando exactamente la estética radial de burbujas/nubes\n    const rawNodesData = [\n      // NODO NÚCLEO CENTRAL\n      { id: 'CORE', label: 'Ecosistema Agroalimentario & Logístico', category: 'Núcleo Central', color: '#E7C878', desc: 'Centro neurálgico de abastecimiento alimentario y redistribución logística del Borde Occidental de Bogotá D.C.', citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.', x: 0, y: 0, z: 0, radius: 46 },\n\n      // CLUSTER 1: MACRO REGIONAL (Boyacá, Tolima, Meta, Calle 13)\n      { id: 'REG_MAIN', label: 'Región Central & Accesos Periféricos', category: 'Macro Regional', color: '#E69888', desc: 'Proveedor primario de carga agrícola e insumos pecuarios procesados en tractocamiones pesados C3-S3.', citation: 'SDM (2019) Estudio Origen-Destino de Carga.', x: -200, y: -190, z: -40, radius: 34 },\n      { id: 'REG_CALLE13', label: 'Corredor Calle 13 / Autosur', category: 'Macro Regional', color: '#E69888', desc: 'Punto de ingreso del 68% de los alimentos de la capital y canalización de tráfico de carga intermunicipal.', citation: 'Decreto 319 de 2006 (Plan Maestro de Movilidad).', x: -270, y: -240, z: -60, radius: 24 },\n      { id: 'REG_PRODUCT', label: 'Productores Boyacá/Meta/Tolima', category: 'Macro Regional', color: '#E69888', desc: 'Centros de despacho de alimentos perecederos y grano seco desde la Región Central.', citation: 'SDDE & CCB (2021) Diagnóstico de Cadena de Suministro.', x: -290, y: -140, z: -80, radius: 22 },\n\n      // CLUSTER 2: HUB LOGÍSTICO FONTIBÓN (Zona Franca, Av. Centenario)\n      { id: 'LOG_MAIN', label: 'Cluster Zona Franca de Bogotá', category: 'Hub Logístico', color: '#C96349', desc: 'Hub de empaques, secos, mercancía industrializada de importación e intermediación logística.', citation: 'SDDE & Cámara de Comercio de Bogotá (2021).', x: 200, y: -190, z: -40, radius: 34 },\n      { id: 'LOG_CENTENARIO', label: 'Av. Centenario ⇄ Av. Cali', category: 'Hub Logístico', color: '#C96349', desc: 'Corredor de conexión pesada bidireccional entre las industrias de Fontibón y los acopios de Kennedy.', citation: 'SDM (2022) Caracterización de Flujos Logísticos.', x: 280, y: -240, z: -60, radius: 24 },\n      { id: 'LOG_EMPAQUES', label: 'Procesamiento Secos & Empaques', category: 'Hub Logístico', color: '#C96349', desc: 'Suministro masivo de empaques plásticos y costalería requerida para el embalaje en Corabastos.', citation: 'SDDE (2021) Diagnóstico Logística Urbana.', x: 270, y: -130, z: -80, radius: 22 },\n\n      // CLUSTER 3: ARTERIAS URBANAS KENNEDY (Av. Américas, Av. Tintal, TransMilenio)\n      { id: 'URB_MAIN', label: 'Arterias Urbanas Kennedy', category: 'Arterias Distritales', color: '#E7C878', desc: 'Malla vial colectora y distribuidora distrital que absorbe el flujo masivo de carga y pasajeros.', citation: 'IDU (2021) Informe de Capacidad Operativa en Kennedy.', x: 220, y: 140, z: 60, radius: 34 },\n      { id: 'URB_AMERICAS', label: 'Nodo Banderas / Av. Américas', category: 'Arterias Distritales', color: '#E7C878', desc: 'Confluencia de rutas troncales de TransMilenio, alimentadores, transporte particular y camiones.', citation: 'IDU (2021) Capacidad Operativa Kennedy.', x: 300, y: 80, z: 40, radius: 24 },\n      { id: 'URB_TINTAL', label: 'Corredor Av. Tintal / Av. Cepeda', category: 'Arterias Distritales', color: '#E7C878', desc: 'Vía de penetración urbana afectada por retención en cola (Spillback) de hasta 3 km.', citation: 'SDM (2020) PMT Operación Agroalimentaria.', x: 310, y: 190, z: 80, radius: 24 },\n\n      // CLUSTER 4: NÚCLEO HIPERLOCAL CORABASTOS (Puertas 6, 7 y 8, Básculas, Malla Peri-Corabastos)\n      { id: 'CORE_MAIN', label: 'Central Mayorista Corabastos', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Punto de recepción y comercialización final de carga agroalimentaria de la capital.', citation: 'Resolución SDM 184 de 2018 (Reglamento Interno).', x: -220, y: 140, z: 60, radius: 34 },\n      { id: 'CORE_PUERTAS', label: 'Básculas Puertas 6, 7 y 8', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Embudos de control de pesaje e inspección que originan la cola de retención exterior.', citation: 'POT Decreto 555 de 2021 (Actuación Estratégica Chucua de la Vaca).', x: -300, y: 80, z: 40, radius: 24 },\n      { id: 'CORE_MALLA', label: 'Malla Vial Local Peri-Corabastos', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Espacio público con velocidad media < 5 km/h por parqueo informal y bicipatines cargadores.', citation: 'Corabastos S.A. & SDM (2018).', x: -310, y: 190, z: 80, radius: 24 }\n    ];\n\n    const edges = [\n      { source: 'CORE', target: 'REG_MAIN' },\n      { source: 'CORE', target: 'LOG_MAIN' },\n      { source: 'CORE', target: 'URB_MAIN' },\n      { source: 'CORE', target: 'CORE_MAIN' },\n\n      { source: 'REG_MAIN', target: 'REG_CALLE13' },\n      { source: 'REG_MAIN', target: 'REG_PRODUCT' },\n\n      { source: 'LOG_MAIN', target: 'LOG_CENTENARIO' },\n      { source: 'LOG_MAIN', target: 'LOG_EMPAQUES' },\n\n      { source: 'URB_MAIN', target: 'URB_AMERICAS' },\n      { source: 'URB_MAIN', target: 'URB_TINTAL' },\n\n      { source: 'CORE_MAIN', target: 'CORE_PUERTAS' },\n      { source: 'CORE_MAIN', target: 'CORE_MALLA' },\n\n      // Interconexiones transversales\n      { source: 'LOG_MAIN', target: 'CORE_MAIN' },\n      { source: 'REG_MAIN', target: 'LOG_MAIN' },\n      { source: 'URB_MAIN', target: 'CORE_MAIN' },\n      { source: 'CORE_PUERTAS', target: 'URB_TINTAL' }\n    ];\n\n    let nodes = [];\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function initTopology() {\n      const nodeMap = new Map();\n      nodes = rawNodesData.map((d, idx) => {\n        const n = { ...d, nodeId: idx };\n        nodeMap.set(d.id, n);\n        return n;\n      });\n\n      edges.forEach(e => {\n        e.sourceNode = nodeMap.get(e.source);\n        e.targetNode = nodeMap.get(e.target);\n      });\n    }\n\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 600;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    function resetCamera() {\n      targetRotX = 0.25; targetRotY = 0.45; targetZoom = 480; targetPanX = 0; targetPanY = 0;\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      document.getElementById('mNodeTitle').innerText = node.label;\n      document.getElementById('mNodeCategory').innerText = `Cluster: ${node.category}`;\n      document.getElementById('mNodeDesc').innerText = node.desc;\n      document.getElementById('mNodeCitation').innerText = node.citation;\n      document.getElementById('nodeInspector').style.display = 'flex';\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function render() {\n      const w = canvas.width, h = canvas.height;\n\n      rotX += (targetRotX - rotX) * 0.12;\n      rotY += (targetRotY - rotY) * 0.12;\n      zoom += (targetZoom - zoom) * 0.12;\n      panX += (targetPanX - panX) * 0.12;\n      panY += (targetPanY - panY) * 0.12;\n\n      ctx.fillStyle = isDark ? '#000000' : '#f8fafc';\n      ctx.fillRect(0, 0, w, h);\n\n      // Project Nodes\n      nodes.forEach(n => {\n        n.proj = project(n.x, n.y, n.z, w, h);\n      });\n\n      // Render Edges\n      edges.forEach(e => {\n        const s = e.sourceNode, t = e.targetNode;\n        if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n        const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n        const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(s.proj.x, s.proj.y);\n        ctx.lineTo(t.proj.x, t.proj.y);\n        ctx.strokeStyle = (isHov || isSel) ? (isDark ? '#E7C878' : '#0284c7') : (isDark ? 'rgba(255, 255, 255, 0.18)' : 'rgba(0, 0, 0, 0.12)');\n        ctx.lineWidth = (isHov || isSel) ? 3 : 1.4;\n        ctx.stroke();\n        ctx.restore();\n      });\n\n      // Sort Nodes by Z Depth\n      const sorted = [...nodes].filter(n => n.proj && n.proj.visible).sort((a, b) => a.proj.z - b.proj.z);\n\n      // Render Soft Pastel Spheres / Bubbles exactly like the Valparaíso Infographic Style\n      sorted.forEach(n => {\n        const px = Math.round(n.proj.x);\n        const py = Math.round(n.proj.y);\n        const scale = n.proj.scale || 1.0;\n        const rad = Math.max(14, Math.round(n.radius * scale));\n\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n\n        ctx.save();\n        \n        // Sphere Radial Gradient\n        const grad = ctx.createRadialGradient(px - rad * 0.35, py - rad * 0.35, rad * 0.1, px, py, rad);\n        grad.addColorStop(0, isDark ? '#ffffff' : '#ffffff');\n        grad.addColorStop(0.45, n.color);\n        grad.addColorStop(1, isDark ? '#050505' : '#cbd5e1');\n\n        ctx.fillStyle = grad;\n        ctx.beginPath();\n        ctx.arc(px, py, rad, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Stroke\n        ctx.strokeStyle = (isHov || isSel) ? (isDark ? '#ffffff' : '#0f172a') : (isDark ? 'rgba(255,255,255,0.45)' : 'rgba(0,0,0,0.18)');\n        ctx.lineWidth = (isHov || isSel) ? 3.5 : 1.5;\n        ctx.stroke();\n\n        // Node Label Floating Box\n        ctx.font = isHov || isSel ? 'bold 11px -apple-system, sans-serif' : '10px -apple-system, sans-serif';\n        ctx.fillStyle = isDark ? (isHov || isSel ? '#ffffff' : '#e2e8f0') : (isHov || isSel ? '#0f172a' : '#334155');\n        ctx.textAlign = 'center';\n        ctx.fillText(n.label, px, py + rad + 14);\n\n        ctx.restore();\n      });\n\n      requestAnimationFrame(render);\n    }\n\n    // Controls\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true; mouseBtn = e.button;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX, dy = e.clientY - lastY;\n        if (mouseBtn === 0) {\n          targetRotY += dx * 0.004;\n          targetRotX += dy * 0.004;\n        } else if (mouseBtn === 2) {\n          targetPanX += dx; targetPanY += dy;\n        }\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const mx = e.clientX, my = e.clientY;\n        let closest = null, minDist = 38;\n        nodes.forEach(n => {\n          if (!n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    initTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Adaptación del diseño radial de esferas e infografía al Ecosistema de Movilidad y Carga de Kennedy - Corabastos - Zona Franca en un visor 3D interactivo con alternancia de fondo (Claro / Dark OLED).","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\red_ecosistema_kennedy.html","toolAction":"Creating interactive radial ecosystem network for Kennedy","toolSummary":"Create Kennedy radial network html"}}]}
