    </div>\n275:     <div class=\"glass-panel status-badge\">\n276:       💡 Inspirado exactamente en la infografía radial de esferas y burbujas • Clic para Ficha • Drag 3D\n277:     </div>\n278:   </div>\n279: \n280:   <script>\n281:     const canvas = document.getElementById('viewport');\n282:     const ctx = canvas.getContext('2d');\n283: \n284:     let isDark = true;\n285:     let rotX = 0.25, rotY = 0.45, zoom = 480;\n286:     let targetRotX = 0.25, targetRotY = 0.45, targetZoom = 480;\n287:     let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n288:     let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0, clickStartX = 0, clickStartY = 0;\n289:     let hoveredNode = null, selectedNode = null;\n290: \n291:     function toggleDarkMode() {\n292:       isDark = !isDark;\n293:       document.body.classList.toggle('dark-mode', isDark);\n294:     }\n295: \n296:     // Dataset adaptado del ecosistema de Kennedy-Corabastos-Zona Franca conservando exactamente la estética radial de burbujas/nubes\n297:     const rawNodesData = [\n298:       // NODO NÚCLEO CENTRAL\n299:       { id: 'CORE', label: 'Ecosistema Agroalimentario & Logístico', category: 'Núcleo Central', color: '#E7C878', desc: 'Centro neurálgico de abastecimiento alimentario y redistribución logística del Borde Occidental de Bogotá D.C.', citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.', x: 0, y: 0, z: 0, radius: 46 },\n300: \n301:       // CLUSTER 1: MACRO REGIONAL (Boyacá, Tolima, Meta, Calle 13)\n302:       { id: 'REG_MAIN', label: 'Región Central & Accesos Periféricos', category: 'Macro Regional', color: '#E69888', desc: 'Proveedor primario de carga agrícola e insumos pecuarios procesados en tractocamiones pesados C3-S3.', citation: 'SDM (2019) Estudio Origen-Destino de Carga.', x: -200, y: -190, z: -40, radius: 34 },\n303:       { id: 'REG_CALLE13', label: 'Corredor Calle 13 / Autosur', category: 'Macro Regional', color: '#E69888', desc: 'Punto de ingreso del 68% de los alimentos de la capital y canalización de tráfico de carga intermunicipal.', citation: 'Decreto 319 de 2006 (Plan Maestro de Movilidad).', x: -270, y: -240, z: -60, radius: 24 },\n304:       { id: 'REG_PRODUCT', label: 'Productores Boyacá/Meta/Tolima', category: 'Macro Regional', color: '#E69888', desc: 'Centros de despacho de alimentos perecederos y grano seco desde la Región Central.', citation: 'SDDE & CCB (2021) Diagnóstico de Cadena de Suministro.', x: -290, y: -140, z: -80, radius: 22 },\n305: \n306:       // CLUSTER 2: HUB LOGÍSTICO FONTIBÓN (Zona Franca, Av. Centenario)\n307:       { id: 'LOG_MAIN', label: 'Cluster Zona Franca de Bogotá', category: 'Hub Logístico', color: '#C96349', desc: 'Hub de empaques, secos, mercancía industrializada de importación e intermediación logística.', citation: 'SDDE & Cámara de Comercio de Bogotá (2021).', x: 200, y: -190, z: -40, radius: 34 },\n308:       { id: 'LOG_CENTENARIO', label: 'Av. Centenario ⇄ Av. Cali', category: 'Hub Logístico', color: '#C96349', desc: 'Corredor de conexión pesada bidireccional entre las industrias de Fontibón y los acopios de Kennedy.', citation: 'SDM (2022) Caracterización de Flujos Logísticos.', x: 280, y: -240, z: -60, radius: 24 },\n309:       { id: 'LOG_EMPAQUES', label: 'Procesamiento Secos & Empaques', category: 'Hub Logístico', color: '#C96349', desc: 'Suministro masivo de empaques plásticos y costalería requerida para el embalaje en Corabastos.', citation: 'SDDE (2021) Diagnóstico Logística Urbana.', x: 270, y: -130, z: -80, radius: 22 },\n310: \n311:       // CLUSTER 3: ARTERIAS URBANAS KENNEDY (Av. Américas, Av. Tintal, TransMilenio)\n312:       { id: 'URB_MAIN', label: 'Arterias Urbanas Kennedy', category: 'Arterias Distritales', color: '#E7C878', desc: 'Malla vial colectora y distribuidora distrital que absorbe el flujo masivo de carga y pasajeros.', citation: 'IDU (2021) Informe de Capacidad Operativa en Kennedy.', x: 220, y: 140, z: 60, radius: 34 },\n313:       { id: 'URB_AMERICAS', label: 'Nodo Banderas / Av. Américas', category: 'Arterias Distritales', color: '#E7C878', desc: 'Confluencia de rutas troncales de TransMilenio, alimentadores, transporte particular y camiones.', citation: 'IDU (2021) Capacidad Operativa Kennedy.', x: 300, y: 80, z: 40, radius: 24 },\n314:       { id: 'URB_TINTAL', label: 'Corredor Av. Tintal / Av. Cepeda', category: 'Arterias Distritales', color: '#E7C878', desc: 'Vía de penetración urbana afectada por retención en cola (Spillback) de hasta 3 km.', citation: 'SDM (2020) PMT Operación Agroalimentaria.', x: 310, y: 190, z: 80, radius: 24 },\n315: \n316:       // CLUSTER 4: NÚCLEO HIPERLOCAL CORABASTOS (Puertas 6, 7 y 8, Básculas, Malla Peri-Corabastos)\n317:       { id: 'CORE_MAIN', label: 'Central Mayorista Corabastos', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Punto de recepción y comercialización final de carga agroalimentaria de la capital.', citation: 'Resolución SDM 184 de 2018 (Reglamento Interno).', x: -220, y: 140, z: 60, radius: 34 },\n318:       { id: 'CORE_PUERTAS', label: 'Básculas Puertas 6, 7 y 8', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Embudos de control de pesaje e inspección que originan la cola de retención exterior.', citation: 'POT Decreto 555 de 2021 (Actuación Estratégica Chucua de la Vaca).', x: -300, y: 80, z: 40, radius: 24 },\n319:       { id: 'CORE_MALLA', label: 'Malla Vial Local Peri-Corabastos', category: 'Núcleo Hiperlocal', color: '#84A48B', desc: 'Espacio público con velocidad media < 5 km/h por parqueo informal y bicipatines cargadores.', citation: 'Corabastos S.A. & SDM (2018).', x: -310, y: 190, z: 80, radius: 24 }\n320:     ];\n321: \n322:     const edges = [\n323:       { source: 'CORE', target: 'REG_MAIN' },\n324:       { source: 'CORE', target: 'LOG_MAIN' },\n325:       { source: 'CORE', target: 'URB_MAIN' },\n326:       { source: 'CORE', target: 'CORE_MAIN' },\n327: \n328:       { source: 'REG_MAIN', target: 'REG_CALLE13' },\n329:       { source: 'REG_MAIN', target: 'REG_PRODUCT' },\n330: \n331:       { source: 'LOG_MAIN', target: 'LOG_CENTENARIO' },\n332:       { source: 'LOG_MAIN', target: 'LOG_EMPAQUES' },\n333: \n334:       { source: 'URB_MAIN', target: 'URB_AMERICAS' },\n335:       { source: 'URB_MAIN', target: 'URB_TINTAL' },\n336: \n337:       { source: 'CORE_MAIN', target: 'CORE_PUERTAS' },\n338:       { source: 'CORE_MAIN', target: 'CORE_MALLA' },\n339: \n340:       // Interconexiones transversales\n341:       { source: 'LOG_MAIN', target: 'CORE_MAIN' },\n342:       { source: 'REG_MAIN', target: 'LOG_MAIN' },\n343:       { source: 'URB_MAIN', target: 'CORE_MAIN' },\n344:       { source: 'CORE_PUERTAS', target: 'URB_TINTAL' }\n345:     ];\n346: \n347:     let nodes = [];\n348: \n349:     function resize() {\n350:       canvas.width = window.innerWidth;\n351:       canvas.height = window.innerHeight;\n352:     }\n353:     window.addEventListener('resize', resize);\n354:     resize();\n355: \n356:     function initTopology() {\n357:       const nodeMap = new Map();\n358:       nodes = rawNodesData.map((d, idx) => {\n359:         const n = { ...d, nodeId: idx };\n360:         nodeMap.set(d.id, n);\n361:         return n;\n362:       });\n363: \n364:       edges.forEach(e => {\n365:         e.sourceNode = nodeMap.get(e.source);\n366:         e.targetNode = nodeMap.get(e.target);\n367:       });\n368:     }\n369: \n370:     function project(x, y, z, w, h) {\n371:       const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n372:       const x1 = x * cosY + z * sinY;\n373:       const z1 = -x * sinY + z * cosY;\n374: \n375:       const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n376:       const y2 = y * cosX - z1 * sinX;\n377:       const z2 = y * sinX + z1 * cosX;\n378: \n379:       const cx = x1 + panX;\n380:       const cy = y2 + panY;\n381: \n382:       const dist = 600;\n383:       const scale = zoom / (z2 + dist);\n384: \n385:       return {\n386:         x: w / 2 + cx * scale,\n387:         y: h / 2 + cy * scale,\n388:         z: z2,\n389:         scale,\n390:         visible: (z2 + dist) > 10\n391:       };\n392:     }\n393: \n394:     function resetCamera() {\n395:       targetRotX = 0.25; targetRotY = 0.45; targetZoom = 480; targetPanX = 0; targetPanY = 0;\n396:     }\n397: \n398:     function openInspector(node) {\n399:       selectedNode = node;\n400:       document.getElementById('mNodeTitle').innerText = node.label;\n401:       document.getElementById('mNodeCategory').innerText = `Cluster: ${node.category}`;\n402:       document.getElementById('mNodeDesc').innerText = node.desc;\n403:       document.getElementById('mNodeCitation').innerText = node.citation;\n404:       document.getElementById('nodeInspector').style.display = 'flex';\n405:     }\n406: \n407:     function closeInspector() {\n408:       selectedNode = null;\n409:       document.getElementById('nodeInspector').style.display = 'none';\n410:     }\n411: \n412:     function render() {\n413:       const w = canvas.width, h = canvas.height;\n414: \n415:       rotX += (targetRotX - rotX) * 0.12;\n416:       rotY += (targetRotY - rotY) * 0.12;\n417:       zoom += (targetZoom - zoom) * 0.12;\n418:       panX += (targetPanX - panX) * 0.12;\n419:       panY += (targetPanY - panY) * 0.12;\n420: \n421:       ctx.fillStyle = isDark ? '#000000' : '#f8fafc';\n422:       ctx.fillRect(0, 0, w, h);\n423: \n424:       // Project Nodes\n425:       nodes.forEach(n => {\n426:         n.proj = project(n.x, n.y, n.z, w, h);\n427:       });\n428: \n429:       // Render Edges\n430:       edges.forEach(e => {\n431:         const s = e.sourceNode, t = e.targetNode;\n432:         if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n433: \n434:         const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n435:         const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n436: \n437:         ctx.save();\n438:         ctx.beginPath();\n439:         ctx.moveTo(s.proj.x, s.proj.y);\n440:         ctx.lineTo(t.proj.x, t.proj.y);\n441:         ctx.strokeStyle = (isHov || isSel) ? (isDark ? '#E7C878' : '#0284c7') : (isDark ? 'rgba(255, 255, 255, 0.18)' : 'rgba(0, 0, 0, 0.12)');\n442:         ctx.lineWidth = (isHov || isSel) ? 3 : 1.4;\n443:         ctx.stroke();\n444:         ctx.restore();\n445:       });\n446: \n447:       // Sort Nodes by Z Depth\n448:       const sorted = [...nodes].filter(n => n.proj && n.proj.visible).sort((a, b) => a.proj.z - b.proj.z);\n449: \n450:       // Render Soft Pastel Spheres / Bubbles exactly like the Valparaíso Infographic Style\n451:       sorted.forEach(n => {\n452:         const px = Math.round(n.proj.x);\n453:         const py = Math.round(n.proj.y);\n454:         const scale = n.proj.scale || 1.0;\n455:         const rad = Math.max(14, Math.round(n.radius * scale));\n456: \n457:         const isHov = hoveredNode && hoveredNode.id === n.id;\n458:         const isSel = selectedNode && selectedNode.id === n.id;\n459: \n460:         ctx.save();\n461:         \n462:         // Sphere Radial Gradient\n463:         const grad = ctx.createRadialGradient(px - rad * 0.35, py - rad * 0.35, rad * 0.1, px, py, rad);\n464:         grad.addColorStop(0, isDark ? '#ffffff' : '#ffffff');\n465:         grad.addColorStop(0.45, n.color);\n466:         grad.addColorStop(1, isDark ? '#050505' : '#cbd5e1');\n467: \n468:         ctx.fillStyle = grad;\n469:         ctx.beginPath();\n470:         ctx.arc(px, py, rad, 0, Math.PI * 2);\n471:         ctx.fill();\n472: \n473:         // Stroke\n474:         ctx.strokeStyle = (isHov || isSel) ? (isDark ? '#ffffff' : '#0f172a') : (isDark ? 'rgba(255,255,255,0.45)' : 'rgba(0,0,0,0.18)');\n475:         ctx.lineWidth = (isHov || isSel) ? 3.5 : 1.5;\n476:         ctx.stroke();\n477: \n478:         // Node Label Floating Box\n479:         ctx.font = isHov || isSel ? 'bold 11px -apple-system, sans-serif' : '10px -apple-system, sans-serif';\n480:         ctx.fillStyle = isDark ? (isHov || isSel ? '#ffffff' : '#e2e8f0') : (isHov || isSel ? '#0f172a' : '#334155');\n481:         ctx.textAlign = 'center';\n482:         ctx.fillText(n.label, px, py + rad + 14);\n483: \n484:         ctx.restore();\n485:       });\n486: \n487:       requestAnimationFrame(render);\n488:     }\n489: \n490:     // Controls\n491:     canvas.addEventListener('mousedown', e => {\n492:       isMouseDown = true; mouseBtn = e.button;\n493:       lastX = e.clientX; lastY = e.clientY;\n494:       clickStartX = e.clientX; clickStartY = e.clientY;\n495:     });\n496: \n497:     window.addEventListener('mouseup', e => {\n498:       isMouseDown = false;\n499:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n500:       if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n501:         openInspector(hoveredNode);\n502:       }\n503:     });\n504: \n505:     canvas.addEventListener('mousemove', e => {\n506:       if (isMouseDown) {\n507:         const dx = e.clientX - lastX, dy = e.clientY - lastY;\n508:         if (mouseBtn === 0) {\n509:           targetRotY += dx * 0.004;\n510:           targetRotX += dy * 0.004;\n511:         } else if (mouseBtn === 2) {\n512:           targetPanX += dx; targetPanY += dy;\n513:         }\n514:         lastX = e.clientX; lastY = e.clientY;\n515:       } else {\n516:         const mx = e.clientX, my = e.clientY;\n517:         let closest = null, minDist = 38;\n518:         nodes.forEach(n => {\n519:           if (!n.proj || !n.proj.visible) return;\n520:           const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n521:           if (d < minDist) { minDist = d; closest = n; }\n522:         });\n523:         hoveredNode = closest;\n524:       }\n525:     });\n526: \n527:     canvas.addEventListener('contextmenu', e => e.preventDefault());\n528:     canvas.addEventListener('wheel', e => {\n529:       e.preventDefault();\n530:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n531:       targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n532:     }, { passive: false });\n533: \n534:     initTopology();\n535:     requestAnimationFrame(render);\n536:   </script>\n537: </body>\n538: </html>\n539: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
