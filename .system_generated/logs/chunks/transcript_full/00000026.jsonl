 === 0 ? radius * Math.sin(a) : 0;\n2143:             const p = project(px, py, pz, w, h);\n2144:             if (p.visible) {\n2145:               if (first) { ctx.moveTo(p.x, p.y); first = false; }\n2146:               else { ctx.lineTo(p.x, p.y); }\n2147:             }\n2148:           }\n2149:           ctx.stroke();\n2150:         });\n2151:       }\n2152: \n2153:       nodes.forEach((n, idx) => {\n2154:         if (!n.active) return;\n2155: \n2156:         let rx = n.ox !== undefined ? n.ox : n.x;\n2157:         let ry = n.oy !== undefined ? n.oy : n.y;\n2158:         let rz = n.oz !== undefined ? n.oz : n.z;\n2159: \n2160:         n.x += (rx - n.x) * 0.08;\n2161:         n.y += (ry - n.y) * 0.08;\n2162:         n.z += (rz - n.z) * 0.08;\n2163: \n2164:         if (opts.pulseMotion && !n.isRoot) {\n2165:           const wave = Math.sin(animTime * 1.8 + idx * 0.3) * 2;\n2166:           n.renderX = n.x + (n.x / 200) * wave;\n2167:           n.renderY = n.y + (n.y / 200) * wave;\n2168:           n.renderZ = n.z + (n.z / 200) * wave;\n2169:         } else {\n2170:           n.renderX = n.x; n.renderY = n.y; n.renderZ = n.z;\n2171:         }\n2172: \n2173:         if (n.currentSize !== undefined && n.targetSize !== undefined) {\n2174:           n.currentSize += (n.targetSize - n.currentSize) * 0.15;\n2175:         } else {\n2176:           n.currentSize = n.targetSize || 8;\n2177:         }\n2178: \n2179:         n.proj = project(n.renderX, n.renderY, n.renderZ, w, h);\n2180:       });\n2181: \n2182:       if (opts.showEdges) {\n2183:         ctx.lineWidth = 1;\n2184:         edges.forEach(e => {\n2185:           if (!e.active) return;\n2186:           const s = nodes[e.source];\n2187:           const t = nodes[e.target];\n2188: \n2189:           if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n2190: \n2191:           const isHov = hoveredNode && (e.source === hoveredNode.id || e.target === hoveredNode.id);\n2192:           const isSel = selectedNode && (e.source === selectedNode.id || e.target === selectedNode.id);\n2193:           const isSrch = searchedId !== null && (e.source === searchedId || e.target === searchedId);\n2194: \n2195:           if (isHov || isSel || isSrch) {\n2196:             ctx.strokeStyle = '#84a48b';\n2197:             ctx.lineWidth = 3.5;\n2198:             ctx.shadowColor = '#84a48b';\n2199:             ctx.shadowBlur = 10;\n2200:           } else {\n2201:             ctx.strokeStyle = selectedNode ? 'rgba(60, 15, 30, 0.15)' : palette.edge;\n2202:             ctx.lineWidth = 1;\n2203:             ctx.shadowBlur = 0;\n2204:           }\n2205: \n2206:           ctx.beginPath();\n2207:           ctx.moveTo(s.proj.x, s.proj.y);\n2208:           ctx.lineTo(t.proj.x, t.proj.y);\n2209:           ctx.stroke();\n2210:           ctx.shadowBlur = 0;\n2211:         });\n2212:       }\n2213: \n2214:       // RENDER SPECIFIC ACCURATE REAL SPECIES PHOTOS IN 3D\n2215:       const sorted = [...nodes].filter(n => n.active && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n2216: \n2217:       sorted.forEach(n => {\n2218:         if (!n.proj.visible) return;\n2219: \n2220:         const px = Math.round(n.proj.x);\n2221:         const py = Math.round(n.proj.y);\n2222:         const isHov = hoveredNode && hoveredNode.id === n.id;\n2223:         const isSel = selectedNode && selectedNode.id === n.id;\n2224:         const isSrch = searchedId === n.id;\n2225: \n2226:         const alphaDepth = Math.max(0.35, Math.min(1.0, (n.proj.z + 500) / 800));\n2227:         let rad = Math.max(8, Math.round(n.currentSize * n.proj.scale * 0.95));\n2228:         if (isHov || isSel || isSrch) rad += 5;\n2229: \n2230:         // Clip Circular Real Photo Frame\n2231:         ctx.save();\n2232:         ctx.globalAlpha = (selectedNode && !isSel && !selectedNode.neighbors.includes(n)) ? alphaDepth * 0.25 : alphaDepth;\n2233: \n2234:         ctx.beginPath();\n2235:         ctx.arc(px, py, rad, 0, Math.PI * 2);\n2236:         ctx.clip();\n2237: \n2238:         if (n.imgObj && n.imgObj.complete && n.imgObj.naturalWidth !== 0) {\n2239:           ctx.drawImage(n.imgObj, px - rad, py - rad, rad * 2, rad * 2);\n2240:         } else {\n2241:           ctx.fillStyle = palette.catColors[n.cat];\n2242:           ctx.fillRect(px - rad, py - rad, rad * 2, rad * 2);\n2243:         }\n2244:         ctx.restore();\n2245: \n2246:         // Border Ring\n2247:         ctx.save();\n2248:         ctx.globalAlpha = alphaDepth;\n2249:         ctx.beginPath();\n2250:         ctx.arc(px, py, rad + 1, 0, Math.PI * 2);\n2251:         ctx.strokeStyle = (isHov || isSel || isSrch) ? '#ffffff' : palette.catColors[n.cat];\n2252:         ctx.lineWidth = (isHov || isSel || isSrch) ? 3 : 2;\n2253:         ctx.stroke();\n2254:         ctx.restore();\n2255: \n2256:         // Label on Hover\n2257:         if (isHov || isSel || isSrch) {\n2258:           ctx.save();\n2259:           ctx.globalAlpha = 1.0;\n2260:           ctx.font = \"11px ui-monospace, monospace\";\n2261:           ctx.fillStyle = \"#ffffff\";\n2262:           ctx.shadowColor = \"#000000\";\n2263:           ctx.shadowBlur = 4;\n2264:           ctx.fillText(`${n.label} [${n.taxaId}]`, px + rad + 6, py + 3);\n2265:           ctx.restore();\n2266:         }\n2267:       });\n2268: \n2269:       requestAnimationFrame(render);\n2270:     }\n2271: \n2272:     // --- MOUSE & DOUBLE CLICK HANDLERS ---\n2273:     canvas.addEventListener('mousedown', e => {\n2274:       isMouseDown = true;\n2275:       mouseBtn = e.button;\n2276:       lastX = e.clientX;\n2277:       lastY = e.clientY;\n2278:       clickStartX = e.clientX;\n2279:       clickStartY = e.clientY;\n2280:     });\n2281: \n2282:     window.addEventListener('mouseup', e => {\n2283:       isMouseDown = false;\n2284:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n2285: \n2286:       if (dragDist < 5 && mouseBtn === 0) {\n2287:         if (hoveredNode) {\n2288:           openInspector(hoveredNode);\n2289:         }\n2290:       }\n2291:     });\n2292: \n2293:     // DOBLE CLIC PARA OCULTAR NODO DE LA RED\n2294:     canvas.addEventListener('dblclick', e => {\n2295:       if (hoveredNode) {\n2296:         hideNodeByDoubleClick(hoveredNode);\n2297:       }\n2298:     });\n2299: \n2300:     canvas.addEventListener('mousemove', e => {\n2301:       if (isMouseDown) {\n2302:         const dx = e.clientX - lastX;\n2303:         const dy = e.clientY - lastY;\n2304:         if (mouseBtn === 0) {\n2305:           velY = dx * 0.003;\n2306:           velX = dy * 0.003;\n2307:           targetRotY += velY; targetRotX += velX;\n2308:         } else if (mouseBtn === 2) {\n2309:           targetPanX += dx; targetPanY += dy;\n2310:         }\n2311:         lastX = e.clientX; lastY = e.clientY;\n2312:       } else {\n2313:         const mx = e.clientX;\n2314:         const my = e.clientY;\n2315: \n2316:         let closest = null;\n2317:         let minDist = 14;\n2318: \n2319:         nodes.forEach(n => {\n2320:           if (!n.active || !n.proj || !n.proj.visible) return;\n2321:           const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n2322:           if (d < minDist) {\n2323:             minDist = d;\n2324:             closest = n;\n2325:           }\n2326:         });\n2327: \n2328:         if (closest !== hoveredNode) {\n2329:           hoveredNode = closest;\n2330:         }\n2331:       }\n2332:     });\n2333: \n2334:     canvas.addEventListener('contextmenu', e => e.preventDefault());\n2335:     canvas.addEventListener('wheel', e => {\n2336:       e.preventDefault();\n2337:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n2338:       targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n2339:     }, { passive: false });\n2340: \n2341:     // Init\n2342:     buildTopology();\n2343:     requestAnimationFrame(render);\n2344:   </script>\n2345: </body>\n2346: </html>\n2347: \nThe above content does NOT sho