   justify-content: center;\n      font-weight: 900;\n      font-size: 11px;\n      color: #ffffff;\n      flex-shrink: 0;\n    }\n\n    .badge-count {\n      font-size: 10px;\n      background: rgba(0, 0, 0, 0.6);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      color: #94a3b8;\n      padding: 2px 7px;\n      border-radius: 10px;\n      font-family: monospace;\n    }\n\n    .toggle-box {\n      width: 14px;\n      height: 14px;\n      border-radius: 3px;\n      border: 1.5px solid #64748b;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.15s ease;\n    }\n    .toggle-box.checked {\n      background: #E7C878;\n      border-color: #E7C878;\n    }\n    .toggle-box.checked::after {\n      content: '✓';\n      font-size: 10px;\n      color: #000000;\n      font-weight: 900;\n    }\n\n    /* Pop-Up Node Inspector Modal */\n    .node-inspector {\n      position: absolute;\n      top: 62px;\n      right: 12px;\n      width: 360px;\n      max-height: calc(100vh - 120px);\n      overflow-y: auto;\n      padding: 16px;\n      z-index: 120;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .inspector-header {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n      padding-bottom: 8px;\n    }\n\n    .node-title {\n      font-size: 14px;\n      font-weight: 800;\n      color: #E7C878;\n    }\n    .node-subtitle {\n      font-size: 10px;\n      color: #94a3b8;\n      font-family: monospace;\n      margin-top: 2px;\n    }\n\n    .btn-close {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-size: 12px;\n      color: #cbd5e1;\n    }\n    .btn-close:hover {\n      background: rgba(255, 0, 85, 0.3);\n      color: #ffffff;\n    }\n\n    .data-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 8px;\n    }\n\n    .metric-card {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 8px;\n    }\n\n    .metric-val {\n      font-size: 12px;\n      font-weight: 700;\n      color: #84a48b;\n      font-family: monospace;\n    }\n    .metric-lbl {\n      font-size: 9px;\n      color: #64748b;\n      text-transform: uppercase;\n    }\n\n    .sec-header {\n      font-size: 10px;\n      text-transform: uppercase;\n      letter-spacing: 0.8px;\n      color: #64748b;\n      margin-bottom: 4px;\n      font-weight: 700;\n    }\n\n    .text-content {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 8px 10px;\n      color: #cbd5e1;\n      font-size: 11px;\n      line-height: 1.45;\n    }\n\n    .text-content.alert {\n      background: rgba(201, 99, 73, 0.12);\n      border-color: rgba(201, 99, 73, 0.35);\n      color: #e69888;\n    }\n\n    .citation-box {\n      background: rgba(132, 164, 139, 0.1);\n      border: 1px solid rgba(132, 164, 139, 0.3);\n      border-radius: 6px;\n      padding: 8px 10px;\n      color: #a4c3b2;\n      font-size: 10.5px;\n      line-height: 1.4;\n      font-style: italic;\n    }\n\n    .neighbor-scroll {\n      max-height: 140px;\n      overflow-y: auto;\n      background: rgba(0, 0, 0, 0.4);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      border-radius: 6px;\n    }\n\n    .neighbor-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 6px 10px;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n      cursor: pointer;\n    }\n    .neighbor-row:hover {\n      background: rgba(132, 164, 139, 0.15);\n      color: #84a48b;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .status-badge {\n      padding: 6px 14px;\n      color: #94a3b8;\n      font-size: 10px;\n      letter-spacing: 0.4px;\n      pointer-events: auto;\n    }\n    .status-badge b {\n      color: #84a48b;\n      font-family: monospace;\n    }\n\n    /* Sub-Network Pop-Up Canvas Overlay */\n    .subnetwork-modal {\n      position: fixed;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background: rgba(0, 0, 0, 0.88);\n      backdrop-filter: blur(12px);\n      z-index: 9000;\n      display: none;\n      align-items: center;\n      justify-content: center;\n    }\n    .subnetwork-card {\n      width: 88vw;\n      height: 88vh;\n      max-width: 1200px;\n      max-height: 850px;\n      background: #000000;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 12px;\n      box-shadow: 0 20px 50px rgba(0,0,0,0.95);\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      position: relative;\n    }\n    .subnetwork-header {\n      padding: 14px 20px;\n      background: #050505;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .subnetwork-canvas-wrap {\n      flex: 1;\n      position: relative;\n      background: #000000;\n    }\n\n    /* High-End OLED Pitch Black Welcome Modal */\n    .welcome-overlay {\n      position: fixed;\n      top: 0; left: 0; width: 100vw; height: 100vh;\n      background: rgba(0, 0, 0, 0.95);\n      backdrop-filter: blur(24px);\n      -webkit-backdrop-filter: blur(24px);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 9999;\n    }\n    .welcome-modal {\n      width: 92%;\n      max-width: 1100px;\n      max-height: 90vh;\n      background: #050505;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 18px;\n      box-shadow: 0 30px 90px #000000;\n      padding: 26px;\n      overflow-y: auto;\n      color: #f1f5f9;\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n    .welcome-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n      padding-bottom: 16px;\n    }\n    .matrioshka-diagram-box {\n      background: #0a0a0c;\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 12px;\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- 3D Canvas Viewport -->\n  <canvas id=\"viewport\"></canvas>\n\n  <!-- Top Navigation Header -->\n  <div class=\"top-header\">\n    <div class=\"glass-panel brand-title\">\n      <span>🚥 RED MATRIOSHKA: KENNEDY - CORABASTOS - ZONA FRANCA</span>\n    </div>\n\n    <div class=\"nav-group\">\n      <button class=\"btn-flat active\" onclick=\"openWelcomeModal()\">\n        <span>📐 Modelo Matrioshka & Documento Maestro</span>\n      </button>\n\n      <button class=\"btn-flat\" id=\"btnToggleSide\" onclick=\"toggleSideDrawer()\">\n        <span>Filtro de Niveles Jerárquicos</span>\n      </button>\n\n      <button class=\"btn-flat\" onclick=\"resetCamera()\">\n        <span>Restablecer Vista 3D</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- Left Side Drawer (Niveles Matrioshka) -->\n  <div class=\"glass-panel side-drawer\" id=\"sideDrawer\">\n    <div style=\"font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:4px; display:flex; justify-content:space-between;\">\n      <span>Niveles Matrioshka Anidados</span>\n      <span style=\"font-size:8px; color:#475569;\">Doble Clic = Ocultar</span>\n    </div>\n\n    <!-- Nivel 1 -->\n    <div class=\"level-card\" style=\"--level-color:#C96349;\" onclick=\"toggleLevel(1)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#C96349;\">N1</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Macro Periferia Regional</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\">Boyacá, Meta, Tolima, Cundinamarca</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel1\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 2 -->\n    <div class=\"level-card\" style=\"--level-color:#E69888;\" onclick=\"toggleLevel(2)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#E69888;\">N2</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Eje Logístico Inter-Local</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\">Fontibón (Zona Franca) ⇄ Kennedy</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel2\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 3 -->\n    <div class=\"level-card\" style=\"--level-color:#E7C878;\" onclick=\"toggleLevel(3)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#E7C878;\">N3</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Arterias Urbanas Distritales</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\">Av. Cali, Av. Américas, Av. El Tintal</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel3\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 4 -->\n    <div class=\"level-card\" style=\"--level-color:#84A48B;\" onclick=\"toggleLevel(4)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#84A48B;\">N4</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Núcleo Hiperlocal Corabastos</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\">Puertas 6, 7, 8 & Malla Vial Peri-Corabastos</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel4\"></div>\n      </div>\n    </div>\n\n    <!-- Enlaces y Dinámica -->\n    <div style=\"margin-top:10px; padding-top:10px; border-top:1px solid rgba(255,255,255,0.08);\">\n      <div style=\"font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:6px;\">\n        Mecanismos de Fricción Vial:\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:4px; font-size:9.5px; color:#cbd5e1;\">\n        <div>🚚 <b>E1 (A1 ⇄ A2):</b> 68% Ingreso Alimentario Distrital</div>\n        <div>🏭 <b>E2 (B1 ⇄ B2):</b> Suministro Logístico Insumos / Secos</div>\n        <div>🚌 <b>E3 (B2 ⇄ C1):</b> Fricción Transporte Pesado ⇄ TransMilenio</div>\n        <div>⏳ <b>E4 (C2 ⇄ D1):</b> Retención Spillback por Báscula (Colas 3km)</div>\n        <div>🛺 <b>E5 (D1 ⇄ D2):</b> Degradación V &lt; 5km/h por Carga Informal</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Pop-Up Node Inspector Modal -->\n  <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div class=\"inspector-header\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Puertas Corabastos (6, 7 y 8)</div>\n        <div class=\"node-subtitle\" id=\"mNodeCode\">Nivel 4 (Núcleo) • ID: D1</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div class=\"data-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-lbl\">Categoría Infraestructural</div>\n        <div class=\"metric-val\" id=\"mCategory\" style=\"color:#E7C878;\">Embudos / Puntos de Pesaje</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-lbl\">Nivel Matrioshka</div>\n        <div class=\"metric-val\" id=\"mLevel\">4 (Núcleo Hiperlocal)</div>\n      </div>\n    </div>\n\n    <div class=\"sec-header\">Función Operativa en la Red Logística</div>\n    <div class=\"text-content\" id=\"mFunction\">Taquillas y básculas que originan la cola de retención (spillback).</div>\n\n    <div class=\"sec-header\">Mecanismo de Fricción & Impacto</div>\n    <div class=\"text-content alert\" id=\"mImpact\">Genera retención en cola sobre la red vial distrital exterior.</div>\n\n    <div class=\"sec-header\">📜 Cita Técnica Oficial Obligatoria</div>\n    <div class=\"citation-box\" id=\"mCitation\">SDM & POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.</div>\n\n    <div class=\"sec-header\" id=\"mNeighborHeader\">Conexiones Bidireccionales Directas</div>\n    <div class=\"neighbor-scroll\" id=\"mNeighborList\"></div>\n\n    <div style=\"display:flex; flex-direction:column; gap:6px; margin-top:6px;\">\n      <button class=\"btn-flat\" style=\"justify-content:center; background:rgba(231,200,120,0.15); border-color:#E7C878; color:#ffffff; font-weight:700;\" onclick=\"openSubNetworkModal()\">\n        🌐 Ver Sub-Red Directa de Congestión\n      </button>\n\n      <div style=\"display:flex; gap:6px;\">\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center;\" onclick=\"focusSelectedNode()\">Centrar Cámara</button>\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,0,85,0.2); border-color:#ff0055; color:#ffffff;\" onclick=\"hideCurrentNode()\">Ocultar Nodo</button>\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.2); color:#cbd5e1;\" onclick=\"closeInspector()\">Cerrar</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sub-Network 2D Graph Interactive Modal Popup -->\n  <div class=\"subnetwork-modal\" id=\"subnetworkModal\" style=\"display:none;\">\n    <div class=\"subnetwork-card\">\n      <div class=\"subnetwork-header\">\n        <div style=\"display:flex; align-items:center; gap:8px;\">\n          <span style=\"font-weight:800; font-size:13px; color:#E7C878;\" id=\"subModalTitle\">Sub-Red Directa de Congestión</span>\n          <span style=\"font-size:10px; color:#94a3b8; font-family:monospace;\" id=\"subModalCode\">[D1]</span>\n        </div>\n        <div class=\"btn-close\" onclick=\"closeSubNetworkModal()\">×</div>\n      </div>\n      <div class=\"subnetwork-canvas-wrap\">\n        <canvas id=\"subCanvas\"></canvas>\n      </div>\n      <div style=\"padding:8px 14px; background:#050505; border-top:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:space-between; font-size:10px; color:#94a3b8;\">\n        <span>💡 Visualización descentralizada multi-hub de flujos de carga y retención de colas.</span>\n        <span style=\"color:#E7C878; font-weight:700;\">Modelo System Dynamics Spillback</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- OLED Pitch Black Welcome & Master Document Modal -->\n  <div class=\"welcome-overlay\" id=\"welcomeModalOverlay\" style=\"display:flex;\">\n    <div class=\"welcome-modal\">\n      <div class=\"welcome-header\">\n        <div>\n          <div style=\"font-size:16px; font-weight:900; color:#E7C878; letter-spacing:0.5px; display:flex; align-items:center; gap:8px;\">\n            🚥 RED DE CONGESTIÓN VIAL Y LOGÍSTICA MATRIOSHKA: KENNEDY - CORABASTOS - ZONA FRANCA\n          </div>\n          <div style=\"font-size:11px; color:#94a3b8; margin-top:2px;\">Modelo Anidado Jerárquico de 4 Niveles | Bogotá D.C. - Cundinamarca</div>\n        </div>\n        <button class=\"btn-flat active\" style=\"padding:8px 18px; font-weight:800; font-size:12px; background:linear-gradient(135deg, #E7C878, #C96349); color:#000000; border:none;\" onclick=\"closeWelcomeModal()\">\n          Ingresar al Visor 3D →\n        </button>\n      </div>\n\n      <div class=\"matrioshka-diagram-box\">\n        <div style=\"font-size:12px; font-weight:800; color:#84A48B; text-transform:uppercase;\">1. Arquitectura Jerárquica del Sistema (Matrioshka)</div>\n        <div style=\"font-family:monospace; font-size:10.5px; line-height:1.5; color:#cbd5e1; background:rgba(0,0,0,0.6); padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,0.1);\">\n+-----------------------------------------------------------------------------------+<br>\n| 🔴 NIVEL 1: MACRO PERIFERIA REGIONAL (Cundinamarca, Boyacá, Meta, Tolima)          |<br>\n|   +---------------------------------------------------------------------------+   |<br>\n|   | 🟠 NIVEL 2: EJE LOGÍSTICO INTER-LOCAL (Fontibón / Zona Franca ⇄ Kennedy)  |   |<br>\n|   |   +-------------------------------------------------------------------+   |   |<br>\n|   |   | 🟡 NIVEL 3: ARTERIAS URBANAS DISTRITALES (Av. Cali / Av. Américas)|   |   |<br>\n|   |   |   +-----------------------------------------------------------+   |   |   |<br>\n|   |   |   | 🟢 NIVEL 4: NÚCLEO HIPERLOCAL (Puertas Corabastos / Malla)|   |   |   |<br>\n|   |   |   +-----------------------------------------------------------+   |   |   |<br>\n|   |   +-------------------------------------------------------------------+   |   |<br>\n|   +---------------------------------------------------------------------------+   |<br>\n+-----------------------------------------------------------------------------------+\n        </div>\n      </div>\n\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:16px;\">\n        <div class=\"matrioshka-diagram-box\">\n          <div style=\"font-size:11.5px; font-weight:800; color:#E69888;\">2. Bucle de Retención (Spillback Loop)</div>\n          <div style=\"font-size:10.5px; color:#cbd5e1; line-height:1.45;\">\n            Retraso en Báscula <b>[D1]</b> ➔ Genera Colas en Red Local <b>[D2]</b> ➔ Bloquea Av. Cali <b>[C2]</b> ➔ Satura Calle 13 <b>[B2]</b> ➔ Colapsa Acceso Regional <b>[A2]</b>.\n          </div>\n        </div>\n\n        <div class=\"matrioshka-diagram-box\">\n          <div style=\"font-size:11.5px; font-weight:800; color:#E7C878;\">3. Bucle de Fricción Logística (Inter-Local Loop)</div>\n          <div style=\"font-size:10.5px; color:#cbd5e1; line-height:1.45;\">\n            Demanda Insumos Zona Franca <b>[B1]</b> ⇄ Flujo Carga ⇄ Redistribución en Kennedy <b>[D1]</b>. La falta de un corredor segregado hace competir tractocamiones con el transporte masivo urbano.\n          </div>\n        </div>\n      </div>\n\n      <div style=\"display:flex; justify-content:space-between; align-items:center; border-top:1px solid rgba(255,255,255,0.1); padding-top:12px;\">\n        <span style=\"font-size:10.5px; color:#94a3b8;\">📜 Todos los enlaces cuentan con respaldo técnico formal (SDM, IDU, SDDE, POT Decreto 555 de 2021).</span>\n        <button class=\"btn-flat active\" style=\"padding:8px 20px; font-size:12px; font-weight:800; background:linear-gradient(135deg, #E7C878, #C96349); color:#000000; border:none;\" onclick=\"closeWelcomeModal()\">\n          Entendido, Explorar Red 3D\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Bottom Bar -->\n  <div class=\"bottom-bar\">\n    <div class=\"glass-panel status-badge\">\n      Nodos Matrioshka: <b>8</b> | Enlaces Logísticos: <b>5</b> | Citas Oficiales: <b>100% Verificadas</b>\n    </div>\n    <div class=\"glass-panel status-badge\">\n      💡 Clic simple: Ver Ficha & Cita Técnica • Doble Clic: Ocultar Nodo\n    </div>\n  </div>\n\n  <script>\n    const opts = {\n      autoRotate: true,\n      showSphere: true,\n      showEdges: true,\n      pulseMotion: true,\n      levels: { 1: true, 2: true, 3: true, 4: true }\n    };\n\n    const palette = {\n      bg: '#000000',\n      sphere: 'rgba(255, 255, 255, 0.12)',\n      sphereEquator: 'rgba(255, 255, 255, 0.3)',\n      edge: 'rgba(231, 200, 120, 0.45)',\n      levelColors: {\n        1: '#C96349', // Nivel 1: Macro Periferia (Terracotta)\n        2: '#E69888', // Nivel 2: Eje Logístico Inter-Local (Rose)\n        3: '#E7C878', // Nivel 3: Arterias Urbanas (Buttercup Yellow)\n        4: '#84A48B'  // Nivel 4: Núcleo Hiperlocal (Spanish Green)\n      }\n    };\n\n    // Node Master Dataset strictly following Specifications\n    const rawNodesData = [\n      {\n        id: 'A1',\n        name: 'Región Central (Boyacá, Tolima, Meta)',\n        level: 1,\n        catName: 'Origen/Destino Regional',\n        function: 'Proveedor primario de carga agrícola y pecuaria hacia la capital.',\n        impact: 'Ingreso del 68% del abastecimiento alimentario en tractocamiones (C3-S3, C2-S2).',\n        citation: 'Secretaría Distrital de Movilidad (SDM). (2019). Estudio de Origen-Destino de Carga para Bogotá D.C. y la Región. / Plan Maestro de Movilidad (Decreto 319 de 2006).',\n        x: -240, y: -160, z: -180\n      },\n      {\n        id: 'A2',\n        name: 'Accesos Periféricos (Calle 13 / Autosur)',\n        level: 1,\n        catName: 'Corredor de Entrada Distrital',\n        function: 'Canalización de tráfico pesado regional hacia la malla urbana distrital.',\n        impact: 'Saturación en bordes de entrada por mezcla de carga pesada y tráfico intermunicipal.',\n        citation: 'SDM. (2019). Estudio Origen-Destino de Carga / Plan de Ordenamiento Territorial (POT Decreto 555 de 2021).',\n        x: -180, y: -100, z: -100\n      },\n      {\n        id: 'B1',\n        name: 'Cluster Zona Franca de Bogotá',\n        level: 2,\n        catName: 'Hub Logístico y Manufacturero',\n        function: 'Procesamiento de empaques, secos, mercancía importada y bienes industrializados.',\n        impact: 'Generación constante de viajes pesados e insumos hacia Corabastos y redes minoristas.',\n        citation: 'Secretaría Distrital de Desarrollo Económico (SDDE) & CCB. (2021). Diagnóstico de Logística Urbana y Cadena de Suministro de Alimentos para Bogotá.',\n        x: 180, y: -120, z: -120\n      },\n      {\n        id: 'B2',\n        name: 'Corredor Av. Centenario ⇄ Av. Cali',\n        level: 2,\n        catName: 'Arteria Logística Compartida',\n        function: 'Canal de interconexión bidireccional pesado entre Fontibón y Kennedy.',\n        impact: 'Fricción continua entre camiones de gran tonelaje y transporte público.',\n        citation: 'SDM. (2022). Caracterización de Flujos Logísticos en el Borde Occidental de Bogotá.',\n        x: 120, y: -40, z: -40\n      },\n      {\n        id: 'C1',\n        name: 'Nodo Av. Las Américas ⇄ Banderas',\n        level: 3,\n        catName: 'Intersección Arterial Mixta',\n        function: 'Confluencia masiva de SITP, TransMilenio, autos particulares y transporte de carga.',\n        impact: 'Conflicto vehicular de fricción media-alta en horas pico por congestión de carriles.',\n        citation: 'Instituto de Desarrollo Urbano (IDU). (2021). Informe de Capacidad Operativa y Congestión de Vías Arterias de la Localidad de Kennedy.',\n        x: -80, y: 80, z: 60\n      },\n      {\n        id: 'C2',\n        name: 'Corredor Av. El Tintal / Av. Cepeda',\n        level: 3,\n        catName: 'Vía Distrital Distribuidora',\n        function: 'Tránsito de penetración local y atrape de camiones de gran tonelaje.',\n        impact: 'Receptor directo de la cola de retención (spillback) proveniente de Corabastos.',\n        citation: 'Alcaldía Mayor de Bogotá. (2021). POT Decreto 555 de 2021 (Actuación Estratégica Chucua de la Vaca). / SDM (2020).',\n        x: 0, y: 120, z: 100\n      },\n      {\n        id: 'D1',\n        name: 'Puertas de Acceso Corabastos (6, 7 y 8)',\n        level: 4,\n        catName: 'Embudos / Puntos de Pesaje',\n        function: 'Taquillas y básculas que originan la cola de retención (spillback).',\n        impact: 'Demoras en pesaje e inspección provocan filas de hasta 3 km sobre la red exterior.',\n        citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca / SDM. (2020). Evaluación de PMT para la Operación Agroalimentaria en Patio Bonito.',\n        x: 80, y: 180, z: 160\n      },\n      {\n        id: 'D2',\n        name: 'Malla Vial Local Peri-Corabastos',\n        level: 4,\n        catName: 'Espacio Público Informado',\n        function: 'Parqueo en vía informal, maniobras de carretilleros y carga menor.',\n        impact: 'Degradación de la velocidad media a menos de 5 km/h por descargue sobre vía.',\n        citation: 'Corabastos S.A. & SDM. (2018). Reglamento Interno de Operación Logística y Tránsito (Resolución SDM 184 de 2018).',\n        x: 160, y: 220, z: 220\n      }\n    ];\n\n    // Master Edges with Official Citations\n    const rawEdgesData = [\n      {\n        id: 'E1', source: 'A1', target: 'A2',\n        name: 'E1: Abastecimiento Regional',\n        desc: 'Ingreso del 68% del abastecimiento alimentario en tractocamiones (C3-S3, C2-S2) y retorno de vacíos.',\n        citation: 'SDM (2019) Estudio Origen-Destino de Carga / Decreto 319 de 2006.'\n      },\n      {\n        id: 'E2', source: 'B1', target: 'B2',\n        name: 'E2: Conexión Insumos Zona Franca',\n        desc: 'Traslado de empaques, plásticos y secos hacia Corabastos y despacho hacia Fontibón.',\n        citation: 'SDDE & CCB (2021) Diagnóstico Logística Urbana / SDM (2022).'\n      },\n      {\n        id: 'E3', source: 'B2', target: 'C1',\n        name: 'E3: Fricción Logístico-Urbana',\n        desc: 'Conflicto entre transporte pesado, TransMilenio y particulares en arterias de Kennedy.',\n        citation: 'IDU (2021) Informe de Capacidad Operativa en Kennedy.'\n      },\n      {\n        id: 'E4', source: 'C2', target: 'D1',\n        name: 'E4: Retención Spillback Corabastos',\n        desc: 'Demoras en pesaje [D1] originan colas de hasta 3 km sobre Av. Tintal / Av. Cali.',\n        citation: 'POT Decreto 555 de 2021 (Actuación Chucua de la Vaca) / SDM (2020).'\n      },\n      {\n        id: 'E5', source: 'D1', target: 'D2',\n        name: 'E5: Carga Informal y Espacio Público',\n        desc: 'Degradación de velocidad < 5 km/h por bicipatines, carretilleros y descargue en vía.',\n        citation: 'Corabastos S.A. & SDM (Resolución SDM 184 de 2018).'\n      }\n    ];\n\n    let nodes = [];\n    let edges = [];\n    let hoveredNode = null;\n    let selectedNode = null;\n    let animTime = 0;\n\n    let rotX = 0.3, rotY = 0.6, zoom = 460;\n    let targetRotX = 0.3, targetRotY = 0.6, targetZoom = 460;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n\n    let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0;\n    let velX = 0, velY = 0.002;\n    let clickStartX = 0, clickStartY = 0;\n\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    function openWelcomeModal() {\n      document.getElementById('welcomeModalOverlay').style.display = 'flex';\n    }\n    function closeWelcomeModal() {\n      document.getElementById('welcomeModalOverlay').style.display = 'none';\n    }\n\n    function toggleSideDrawer() {\n      document.getElementById('sideDrawer').classList.toggle('collapsed');\n      document.getElementById('btnToggleSide').classList.toggle('active');\n    }\n\n    function resetCamera() {\n      targetRotX = 0.3; targetRotY = 0.6; targetZoom = 460; targetPanX = 0; targetPanY = 0;\n    }\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function toggleLevel(lvl) {\n      opts.levels[lvl] = !opts.levels[lvl];\n      const toggleEl = document.getElementById(`toggleLevel${lvl}`);\n      if (toggleEl) toggleEl.classList.toggle('checked', opts.levels[lvl]);\n      recalculateActiveNodes();\n    }\n\n    function buildTopology() {\n      nodes = rawNodesData.map((d, idx) => ({\n        id: d.id,\n        nodeId: idx,\n        label: d.name,\n        level: d.level,\n        catName: d.catName,\n        function: d.function,\n        impact: d.impact,\n        citation: d.citation,\n        x: d.x, y: d.y, z: d.z,\n        ox: d.x, oy: d.y, oz: d.z,\n        active: true,\n        hiddenByUser: false,\n        degree: 0,\n        neighbors: []\n      }));\n\n      const nodeMap = new Map(nodes.map(n => [n.id, n]));\n\n      edges = rawEdgesData.map(e => ({\n        id: e.id,\n        sourceNode: nodeMap.get(e.source),\n        targetNode: nodeMap.get(e.target),\n        source: nodeMap.get(e.source).nodeId,\n        target: nodeMap.get(e.target).nodeId,\n        name: e.name,\n        desc: e.desc,\n        citation: e.citation,\n        active: true\n      }));\n\n      recalculateActiveNodes();\n    }\n\n    function recalculateActiveNodes() {\n      nodes.forEach(n => {\n        n.active = opts.levels[n.level] === true && !n.hiddenByUser;\n        n.degree = 0;\n        n.neighbors = [];\n      });\n\n      edges.forEach(e => {\n        const s = e.sourceNode;\n        const t = e.targetNode;\n        if (s && t && s.active && t.active) {\n          s.degree++; t.degree++;\n          s.neighbors.push(t);\n          t.neighbors.push(s);\n          e.active = true;\n        } else {\n          e.active = false;\n        }\n      });\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      const modal = document.getElementById('nodeInspector');\n\n      document.getElementById('mNodeTitle').innerText = node.label;\n      document.getElementById('mNodeCode').innerText = `Nivel Matrioshka ${node.level} • ID: ${node.id}`;\n      document.getElementById('mCategory').innerText = node.catName;\n      document.getElementById('mCategory').style.color = palette.levelColors[node.level];\n      document.getElementById('mLevel').innerText = `Nivel ${node.level}`;\n      document.getElementById('mFunction').innerText = node.function;\n      document.getElementById('mImpact').innerText = node.impact;\n      document.getElementById('mCitation').innerText = node.citation;\n\n      document.getElementById('mNeighborHeader').innerText = `Conexiones Bidireccionales (${node.degree})`;\n      const listEl = document.getElementById('mNeighborList');\n      listEl.innerHTML = '';\n\n      edges.forEach(e => {\n        if (e.sourceNode.id === node.id || e.targetNode.id === node.id) {\n          const nb = e.sourceNode.id === node.id ? e.targetNode : e.sourceNode;\n          const item = document.createElement('div');\n          item.className = 'neighbor-row';\n          item.innerHTML = `\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span><b>[${nb.id}]</b> ${nb.label}</span>\n              <span style=\"font-size:8.5px; color:#94a3b8;\">${e.name}</span>\n            </div>\n            <span style=\"color:#E7C878; font-size:9px; font-family:monospace;\">Nivel ${nb.level}</span>\n          `;\n          item.onclick = (evt) => {\n            evt.stopPropagation();\n            openInspector(nb);\n          };\n          listEl.appendChild(item);\n        }\n      });\n\n      modal.style.display = 'flex';\n      focusSelectedNode(node);\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function focusSelectedNode(node) {\n      const target = node || selectedNode;\n      if (!target) return;\n      targetPanX = -target.x * 0.85;\n      targetPanY = -target.y * 0.85;\n      targetZoom = 700;\n    }\n\n    function hideCurrentNode() {\n      if (selectedNode) {\n        selectedNode.hiddenByUser = true;\n        closeInspector();\n        recalculateActiveNodes();\n      }\n    }\n\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 650;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    function render() {\n      animTime += 0.012;\n      const w = canvas.width;\n      const h = canvas.height;\n\n      rotX += (targetRotX - rotX) * 0.1;\n      rotY += (targetRotY - rotY) * 0.1;\n      zoom += (targetZoom - zoom) * 0.1;\n      panX += (targetPanX - panX) * 0.1;\n      panY += (targetPanY - panY) * 0.1;\n\n      if (opts.autoRotate && !isMouseDown && !selectedNode) {\n        targetRotY += (velY || 0.002);\n      } else if (!isMouseDown && !selectedNode) {\n        targetRotY += velY; targetRotX += velX;\n        velX *= 0.92; velY *= 0.92;\n      }\n\n      ctx.fillStyle = palette.bg;\n      ctx.fillRect(0, 0, w, h);\n\n      if (opts.showSphere) {\n        const radius = 280;\n        const steps = 40;\n        ctx.lineWidth = 1;\n\n        for (let i = 1; i < 5; i++) {\n          const phi = (i / 5) * Math.PI;\n          const rLat = radius * Math.sin(phi);\n          const yLat = radius * Math.cos(phi);\n\n          ctx.strokeStyle = palette.sphere;\n          ctx.beginPath();\n          let first = true;\n          for (let j = 0; j <= steps; j++) {\n            const theta = (j / steps) * Math.PI * 2;\n            const px = rLat * Math.cos(theta);\n            const pz = rLat * Math.sin(theta);\n            const p = project(px, yLat, pz, w, h);\n            if (p.visible) {\n              if (first) { ctx.moveTo(p.x, p.y); first = false; }\n              else { ctx.lineTo(p.x, p.y); }\n            }\n          }\n          ctx.stroke();\n        }\n      }\n\n      nodes.forEach((n) => {\n        if (!n.active) return;\n        const wave = Math.sin(animTime * 1.5 + n.nodeId * 0.5) * 3;\n        n.renderX = n.x + wave;\n        n.renderY = n.y + wave;\n        n.renderZ = n.z;\n        n.proj = project(n.renderX, n.renderY, n.renderZ, w, h);\n      });\n\n      if (opts.showEdges) {\n        edges.forEach(e => {\n          if (!e.active) return;\n          const s = e.sourceNode;\n          const t = e.targetNode;\n\n          if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n          const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n          const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n          ctx.save();\n          if (isHov || isSel) {\n            ctx.strokeStyle = '#E7C878';\n            ctx.lineWidth = 3.5;\n            ctx.shadowColor = '#E7C878';\n            ctx.shadowBlur = 10;\n          } else {\n            ctx.strokeStyle = palette.edge;\n            ctx.lineWidth = 1.8;\n            ctx.shadowBlur = 0;\n          }\n\n          ctx.beginPath();\n          ctx.moveTo(s.proj.x, s.proj.y);\n          ctx.lineTo(t.proj.x, t.proj.y);\n          ctx.stroke();\n\n          // Flow Direction Indicator Badge\n          const mx = (s.proj.x + t.proj.x) / 2;\n          const my = (s.proj.y + t.proj.y) / 2;\n          ctx.font = '9px monospace';\n          ctx.fillStyle = isHov || isSel ? '#E7C878' : '#94a3b8';\n          ctx.fillText(e.id, mx - 6, my - 4);\n\n          ctx.restore();\n        });\n      }\n\n      const sorted = [...nodes].filter(n => n.active && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n\n      sorted.forEach(n => {\n        if (!n.proj.visible) return;\n\n        const px = Math.round(n.proj.x);\n        const py = Math.round(n.proj.y);\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n\n        const rad = isHov || isSel ? 18 : 14;\n        const levelColor = palette.levelColors[n.level] || '#E7C878';\n\n        ctx.save();\n        ctx.beginPath();\n        ctx.arc(px, py, rad, 0, Math.PI * 2);\n        ctx.fillStyle = levelColor;\n        ctx.fill();\n\n        ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : '#000000';\n        ctx.lineWidth = 2.5;\n        ctx.stroke();\n\n        ctx.font = 'bold 11px monospace';\n        ctx.fillStyle = '#000000';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(n.id, px, py);\n\n        // Always show label in 3D\n        ctx.font = 'bold 11px ui-monospace, monospace';\n        ctx.fillStyle = '#ffffff';\n        ctx.textAlign = 'left';\n        ctx.shadowColor = '#000000';\n        ctx.shadowBlur = 6;\n        ctx.fillText(`${n.label} [N${n.level}]`, px + rad + 6, py + 3);\n\n        ctx.restore();\n      });\n\n      requestAnimationFrame(render);\n    }\n\n    // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n    let subCanvasAnim = null;\n    function openSubNetworkModal() {\n      if (!selectedNode) return;\n      const subModal = document.getElementById('subnetworkModal');\n      document.getElementById('subModalTitle').innerText = `Sub-Red Matrioshka: ${selectedNode.label}`;\n      document.getElementById('subModalCode').innerText = `[${selectedNode.id}] Nivel ${selectedNode.level}`;\n      subModal.style.display = 'flex';\n      renderSubNetworkCanvas();\n    }\n\n    function closeSubNetworkModal() {\n      document.getElementById('subnetworkModal').style.display = 'none';\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n    }\n\n    function renderSubNetworkCanvas() {\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const centerNode = selectedNode;\n      if (!centerNode) return;\n\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      const activeNeighbors = centerNode.neighbors || [];\n      const totalActive = activeNeighbors.length;\n\n      function loopSub() {\n        sctx.fillStyle = '#000000';\n        sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n\n        // Draw Center Focal Hub\n        sctx.save();\n        sctx.beginPath();\n        sctx.arc(cx, cy, 24, 0, Math.PI * 2);\n        sctx.fillStyle = palette.levelColors[centerNode.level];\n        sctx.fill();\n        sctx.strokeStyle = '#ffffff';\n        sctx.lineWidth = 3;\n        sctx.stroke();\n\n        sctx.font = 'bold 12px monospace';\n        sctx.fillStyle = '#000000';\n        sctx.textAlign = 'center';\n        sctx.textBaseline = 'middle';\n        sctx.fillText(centerNode.id, cx, cy);\n\n        sctx.font = 'bold 12px monospace';\n        sctx.fillStyle = '#ffffff';\n        sctx.textAlign = 'left';\n        sctx.fillText(`${centerNode.label} [N${centerNode.level}]`, cx + 32, cy + 4);\n        sctx.restore();\n\n        // Draw Sub Neighbors in Circle\n        activeNeighbors.forEach((nb, idx) => {\n          const angle = (idx / Math.max(1, totalActive)) * Math.PI * 2 - Math.PI / 2;\n          const radius = 180;\n          const nx = cx + Math.cos(angle) * radius;\n          const ny = cy + Math.sin(angle) * radius;\n\n          // Edge\n          sctx.save();\n          sctx.beginPath();\n          sctx.moveTo(cx, cy);\n          sctx.lineTo(nx, ny);\n          sctx.strokeStyle = palette.levelColors[nb.level];\n          sctx.lineWidth = 2.5;\n          sctx.stroke();\n          sctx.restore();\n\n          // Node\n          sctx.save();\n          sctx.beginPath();\n          sctx.arc(nx, ny, 16, 0, Math.PI * 2);\n          sctx.fillStyle = palette.levelColors[nb.level];\n          sctx.fill();\n          sctx.strokeStyle = '#ffffff';\n          sctx.lineWidth = 2;\n          sctx.stroke();\n\n          sctx.font = 'bold 10px monospace';\n          sctx.fillStyle = '#000000';\n          sctx.textAlign = 'center';\n          sctx.textBaseline = 'middle';\n          sctx.fillText(nb.id, nx, ny);\n\n          sctx.font = '10px monospace';\n          sctx.fillStyle = '#ffffff';\n          sctx.textAlign = 'left';\n          sctx.fillText(`${nb.label} (N${nb.level})`, nx + 22, ny + 3);\n          sctx.restore();\n        });\n\n        subCanvasAnim = requestAnimationFrame(loopSub);\n      }\n\n      loopSub();\n    }\n\n    // Mouse Controls\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true;\n      mouseBtn = e.button;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('dblclick', () => {\n      if (hoveredNode) {\n        hoveredNode.hiddenByUser = true;\n        closeInspector();\n        recalculateActiveNodes();\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX;\n        const dy = e.clientY - lastY;\n        if (mouseBtn === 0) {\n          velY = dx * 0.003; velX = dy * 0.003;\n          targetRotY += velY; targetRotX += velX;\n        } else if (mouseBtn === 2) {\n          targetPanX += dx; targetPanY += dy;\n        }\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const mx = e.clientX, my = e.clientY;\n        let closest = null, minDist = 22;\n        nodes.forEach(n => {\n          if (!n.active || !n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    // Init\n    buildTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>","Description":"Create 3D Matrioshka Traffic Congestion & Logistics Network for Kennedy - Corabastos - Zona Franca","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\red_congestion_matrioshka.html","toolAction":"Creating standalone HTML interactive 3D Matrioshka Network","toolSummary":"Write red_congestion_matrioshka.html"}}]}
