ido') || query.includes('contaminacion')) {\n1590:         targetTaxon = nodes.find(n => n.alert.includes('Alta') || n.alert.includes('Peligro'));\n1591:         botMsg = `Las principales presiones antropogénicas registradas son el ruido vehicular continuous (>75dB en Av. Cali) y la eutrofización hídrica en La Vaca. Un taxón altamente vulnerable es <b>${targetTaxon ? targetTaxon.label : 'Tingua bogotana'}</b>.`;\n1592:       } else {\n1593:         // Fallback: select most connected species matching topic\n1594:         targetTaxon = [...nodes].filter(n => n.active).sort((a, b) => b.degree - a.degree)[0];\n1595:         botMsg = `Entendido. He analizado la topología del enjambre para tu consulta. Te ubico en el taxón con mayor centralidad biótica: <b>${targetTaxon ? targetTaxon.label : 'Especie Principal'}</b> con ${targetTaxon ? targetTaxon.degree : 0} interacciones activas.`;\n1596:       }\n1597: \n1598:       setTimeout(() => {\n1599:         const bBubble = document.createElement('div');\n1600:         bBubble.className = 'msg-bubble msg-bot';\n1601:         bBubble.innerHTML = botMsg;\n1602:         chatBody.appendChild(bBubble);\n1603:         chatBody.scrollTop = chatBody.scrollHeight;\n1604: \n1605:         if (targetTaxon) {\n1606:           openInspector(targetTaxon);\n1607:         }\n1608:       }, 300);\n1609:     }\n1610: \n1611:     function showToast(msg) {\n1612:       const toast = document.getElementById('toastNotify');\n1613:       toast.innerText = msg;\n1614:       toast.style.display = 'block';\n1615:       setTimeout(() => { toast.style.display = 'none'; }, 2500);\n1616:     }\n1617: \n1618:     function toggleCat(catId) {\n1619:       opts.cats[catId] = !opts.cats[catId];\n1620:       const toggleEl = document.getElementById(`toggleCat${catId}`);\n1621:       if (toggleEl) toggleEl.classList.toggle('checked', opts.cats[catId]);\n1622:       recalculateDegreesAndSizes();\n1623:     }\n1624: \n1625:     function toggleSideDrawer() {\n1626:       document.getElementById('sideDrawer').classList.toggle('collapsed');\n1627:       document.getElementById('btnToggleSide').classList.toggle('active');\n1628:     }\n1629: \n1630:     function resetCamera() {\n1631:       targetRotX = 0.25; targetRotY = 0.55; targetZoom = 420; targetPanX = 0; targetPanY = 0;\n1632:     }\n1633: \n1634:     function setLayout(mode) {\n1635:       opts.layoutMode = mode;\n1636:       nodes.forEach((n, idx) => {\n1637:         if (mode === 'clustered') {\n1638:           // Fully Decentralized 4-Cluster Organic Multi-Hub (Flora, Avifauna, Micro, Fauna)\n1639:           const centers = {\n1640:             0: { x: -240, y: -90, z: -120 }, // Flora Hub\n1641:             1: { x: 240, y: -90, z: 120 },   // Avifauna Hub\n1642:             2: { x: -240, y: 150, z: 120 },   // Microorganismos Hub\n1643:             3: { x: 240, y: 150, z: -120 }    // Herpetos / MIA Hub\n1644:           };\n1645:           const center = centers[n.cat] || { x: 0, y: 0, z: 0 };\n1646:           const a = idx * 2.39996 + (n.cat * Math.PI / 2); // Decentralized Golden Angle Offset per category\n1647:           const r = 50 + (idx % 15) * 8;\n1648:           n.ox = center.x + Math.cos(a) * r;\n1649:           n.oy = center.y + Math.sin(a * 1.3) * (r * 0.7);\n1650:           n.oz = center.z + Math.sin(a) * r;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
