e }\n1758:     };\n1759: \n1760:     function toggleSubInteraction(typeId) {\n1761:       subOpts.interactions[typeId] = !subOpts.interactions[typeId];\n1762:       const btn = document.getElementById(`subInterToggle${typeId}`);\n1763:       if (btn) btn.classList.toggle('active', subOpts.interactions[typeId]);\n1764:       renderSubNetworkCanvas();\n1765:     }\n1766: \n1767:     function getInteractionType(nodeA, nodeB, idx) {\n1768:       if (nodeA.cat === 0 && nodeB.cat === 1) return 5; // Visita Floral\n1769:       if (nodeA.cat === 1 && nodeB.cat === 0) return 2; // Dispersión\n1770:       if (nodeA.cat === 1 && nodeB.cat === 3) return 0; // Depredación\n1771:       if (nodeA.cat === 3 && nodeB.cat === 0) return 1; // Herbivoría\n1772:       if (nodeA.cat === 0 && nodeB.cat === 0) return 8; // Alelopatía\n1773:       if (nodeA.cat === 2) return 3; // Mutualismo\n1774:       return (idx + nodeA.id) % 9;\n1775:     }\n1776: \n1777:     function openSubNetworkModal() {\n1778:       if (!selectedNode) return;\n1779:       const subModal = document.getElementById('subnetworkModal');\n1780:       document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n1781:       document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n1782:       subModal.style.display = 'flex';\n1783:       renderSubNetworkCanvas();\n1784:     }\n1785: \n1786:     function closeSubNetworkModal() {\n1787:       document.getElementById('subnetworkModal').style.display = 'none';\n1788:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1789:     }\n1790: \n1791:     let subState = {\n1792:       nodes: [],\n1793:       links: []\n1794:     };\n1795: \n1796:     function renderSubNetworkCanvas() {\n1797:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1798: \n1799:       const subCanvas = document.getElementById('subCanvas');\n1800:       const wrap = subCanvas.parentElement;\nThe above content does NOT show the