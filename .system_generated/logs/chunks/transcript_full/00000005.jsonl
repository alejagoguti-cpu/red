    if (closest !== hoveredNode) {\n          hoveredNode = closest;\n        }\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    // Init\n    buildTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Guarantees 100% of nodes render actual species photographs/illustrations directly on 3D canvas with standalone SVG fallback generator so no node shows text fallbacks.","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\hyperbolic_3d_network.html","toolAction":"Writing 100% 3D image photo nodes update","toolSummary":"Ensure 100% of 181 3D nodes render species photos directly without text fallbacks"}}]}
