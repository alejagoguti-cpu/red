?w=300'],\n        ['ABI-05', 'Lixiviados Orgánicos & DBO5', '>180 mg/L DBO5 Vertimientos', 'Eutrofización acelerada, anoxia y muerte de peces', 'Humedal La Vaca (Corabastos / María Paz)', 'Muy Alto Nivel de Repulsión (Fuerza = 0.90)', 'https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=300'],\n        ['ABI-06', 'Espejo de Agua Activo (NDWI)', 'NDWI > 0.3 (Atracción Hídrica)', 'Centro de atracción de hábitat para avifauna acuática', 'Centro de los 3 humedales de Kennedy', 'Fuerza Atractora Hídrica (-0.90)', 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=300'],\n        ['ABI-07', 'Microplásticos & Residuos', 'Plastic Index Alto', 'Ingestión accidental por tinguas y fochas en litorales', 'Espejo y orillas de Techo y El Burro', 'Requiere limpieza mecánica continua SDA', 'https://images.unsplash.com/photo-1530587191325-3db32d826c18?w=300']\n      ];\n      abiData.forEach(b => taxa.push({ id: b[0], name: b[1], sciname: b[2], cat: 4, role: b[3], loc: b[4], alert: b[5], img: b[6] }));\n\n      // FLORA & ARBOLADO CENSO SIGAU (108 REAL BOTANICAL PHOTOS)\n      const sigauBase = [\n        ['Sambucus nigra', 'Saúco', 'Adoxaceae', 'Flora Nativa Hub / Néctar, fruto y nido para 25+ aves', 'Muy Alto (38 aristas)', 'https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=300'],\n        ['Prunus serotina', 'Capulí', 'Rosaceae', 'Flora Nativa Hub / Frutos para Mirlas, Pirangas y loros', 'Muy Alto (32 aristas)', 'https://images.unsplash.com/photo-1511497584788-876761465586?w=300'],\n        ['Alnus acuminata', 'Aliso', 'Betulaceae', 'Flora Acompañante / Fijación de N2 y percha de Garzas', 'Alto (22 aristas)', 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=300'],\n        ['Baccharis latifolia', 'Chilco', 'Asteraceae', 'Flora Acompañante / Polen para abejas y refugio de cucarachero', 'Alto (19 aristas)', 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=300'],\n        ['Vallea stipularis', 'Raque', 'Elaeocarpaceae', 'Flora Acompañante / Néctar para colibríes cometa y chillón', 'Alto (15 aristas)', 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=300']\n      ];\n\n      for (let s = 1; s <= 108; s++) {\n        const numStr = s.toString().padStart(3, '0');\n        const sId = `SIGAU-${numStr}`;\n        const template = sigauBase[(s - 1) % sigauBase.length];\n        taxa.push({\n          id: sId,\n          name: `${template[1]