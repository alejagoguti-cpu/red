eanTitle}</text>\n      </svg>`;\n      return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);\n    }\n\n    const imageCache = {};\n\n    function getPreloadedImage(url, taxonId, speciesName, cat) {\n      const fallbackUrl = generateSpeciesSvgDataUri(taxonId, speciesName, cat);\n      const srcUrl = url || fallbackUrl;\n      if (imageCache[taxonId]) return imageCache[taxonId];\n\n      const img = new Image();\n      img.crossOrigin = 'Anonymous';\n      img.src = srcUrl;\n      // Fallback if external photo blocks CORS or fails to load\n      img.onerror = () => {\n        img.src = fallbackUrl;\n      };\n      imageCache[taxonId] = img;\n      return img;\n    }","StartLine":848,"TargetContent":"    // High-Tech Scientific Badge Generator for nodes (Strictly NO ICONS or visual symbols)\n    function generateSpeciesSvgDataUri(taxonId, speciesName, cat) {\n      const colors = {\n        0: ['#003318', '#00ff88', '#10B981'], // Flora\n        1: ['#002233', '#00ffff', '#38BDF8'], // Avifauna\n        2: ['#33001a', '#ff007f', '#F43F5E'], // Micro\n        3: ['#332c00', '#ffee33', '#FACC15'], // Herpetos / MIA\n        4: ['#33000a', '#ff0033', '#EF4444'], // Abióticos\n        5: ['#332200', '#ffaa00', '#F59E0B']  // Core\n      };\n      const c = colors[cat] || colors[0];\n      const initials = taxonId.split('-')[0];\n      const codeNum = taxonId.split('-')[1] || '';\n\n      const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"128\" height=\"128\" viewBox=\"0 0 64 64\">\n        <rect width=\"64\" height=\"64\" rx=\"32\" fill=\"${c[0]}\"/>\n        <circle cx=\"32\" cy=\"32\" r=\"29\" stroke=\"${c[1]}\" stroke-width=\"2\" fill=\"none\" opacity=\"0.8\"/>\n        <circle cx=\"32\" cy=\"32\" r=\"23\" stroke=\"${c[1]}\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\" opacity=\"0.4\"/>\n        <text x=\"32\" y=\"28\" font-family=\"ui-monospace, monospace\" font-size=\"10\" font-weight=\"900\" fill=\"${c[1]}\" text-anchor=\"middle\" l