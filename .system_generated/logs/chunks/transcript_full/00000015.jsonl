{\n1223:         userMsg = '¿Por qué existen estas relaciones entre vegetación y registros locales?';\n1224:         const floraNodes = nodes.filter(n => n.cat === 0 && n.active);\n1225:         floraNodes.sort((a, b) => b.degree - a.degree);\n1226:         targetTaxon = floraNodes[0];\n1227:         botMsg = `Se deben a la presencia de nodos de flora nativa estructural (como <b>${targetTaxon ? targetTaxon.label : 'Saúco'}</b>), los cuales actúan como 'Hubs' de alimento (néctar/frutos) y refugio exclusivo para la avifauna y herpetofauna de la cuenca hídrica de Kennedy.`;\n1228:       } else if (questionId === 3) {\n1229:         userMsg = 'Conjetura: ¿Qué observaciones son datos vs hipótesis que requieren verificación?';\n1230:         targetTaxon = nodes.find(n => n.taxaId === 'AVE-01' || n.alert.includes('En Peligro'));\n1231:         botMsg = `<b>Observaciones respaldadas por datos:</b> Presencia y nidos censados de <i>${targetTaxon ? targetTaxon.label : 'Tingua bogotana'}</i> en juncales. <b>Hipótesis por verificar:</b> Grado de inhibición del canto de cortejo a niveles de ruido vehicular >75 dB(A) en el corredor Av. Cali.`;\n1232:       } else if (questionId === 4) {\n1233:         userMsg = 'Problemática de fondo: ¿Qué dependencias favorecen o amenazan la sostenibilidad?';\n1234:         targetTaxon = nodes.find(n => n.cat === 2);\n1235:         botMsg = `La dependencia crítica es el equilibrio entre la flora filtradora (Enea/Junco) y microorganismos nitrificantes (como <i>${targetTaxon ? targetTaxon.label : 'Nitrosomonas'}</i>). La amenaza de fondo radica en la eutrofización acelerada por vertimientos orgánicos en La Vaca y Techo.`;\n1236:       } else if (questionId === 5) {\n1237:         userMsg = 'Simulación de Agentes (ABM): ¿Qué entidades actúan como agentes de enjambre?';\n1238:         targetTaxon = nodes.find(n => n.cat === 1);\n1239:         botMsg = `Para la simulación ABM (Agent-Based Modeling), los taxones de avifauna móvil (ej. <i>${targetTaxon ? targetTaxon.label : 'Tinguas/Mirlas'}</i>) actúan como <b>agentes autónomos de enjambre</b> que responden a vectores de atracción hídrica (NDWI) y repulsión por ruido/concreto (NDBI).`;\n1240:       }\n1241: \n1242:       // Append User message\n1243:       const uBubble = document.createElement('div');\n1244:       uBubble.className = 'msg-bubble msg-user';\n1245:       uBubble.innerText = userMsg;\n1246:       chatBody.appendChild(uBubble);\n1247: \n1248:       // Append Bot message\n1249:       setTimeout(() => {\n1250:         const bBubble = document.createElement('div');\n1251:         bBubble.className = 'msg-bubble msg-bot';\n1252:         bBubble.innerHTML = botMsg;\n1253:         chatBody.appendChild(bBubble);\n1254:         chatBody.scrollTop = chatBody.scrollHeight;\n1255: \n1256:         if (targetTaxon) {\n1257:           openInspector(targetTaxon);\n1258:         }\n1259:       }, 250);\n1260: \n1261:       chatBody.scrollTop = chatBody.scrollHeight;\n1262:     }\n1263: \n1264:     function sendCustomChatMessage() {\n1265:       const input = document.getElementById('chatInput');\n1266:       const text = input.value.trim();\n1267:       if (!text) return;\n1268: \n1269:       const chatBody = document.getElementById('chatBody');\n1270: \n1271:       // Append User Message\n1272:       const uBubble = document.createElement('div');\n1273:       uBubble.className = 'msg-bubble msg-user';\n1274:       uBubble.innerText = text;\n1275:       chatBody.appendChild(uBubble);\n1276: \n1277:       input.value = '';\n1278:       chatBody.scrollTop = chatBody.scrollHeight;\n1279: \n1280:       // Intelligent Bio-statistical query matching\n1281:       const query = text.toLowerCase();\n1282:       let targetTaxon = nodes.find(n => n.active && (\n1283:         n.label.toLowerCase().includes(query) ||\n1284:         n.sciname.toLowerCase().includes(query) ||\n1285:         n.taxaId.toLowerCase().includes(query) ||\n1286:         n.role.toLowerCase().includes(query)\n1287:       ));\n1288: \n1289:       let botMsg = '';\n1290:       if (targetTaxon) {\n1291:         botMsg = `Analizando <b>${targetTaxon.label}</b> (<i>${targetTaxon.sciname}</i>, Cód: <b>${targetTaxon.taxaId}</b>): Posee <b>${targetTaxon.degree} interacciones bióticas</b> en la cuenca socioecológica de Kennedy. Nicho: ${targetTaxon.role}.`;\n1292:       } else if (query.includes('cuanto') || query.includes('total') || query.includes('especies') || query.includes('nodos')) {\n1293:         const activeCount = nodes.filter(n => n.active).length;\n1294:         const edgeCount = edges.filter(e => e.active).length;\n1295:         botMsg = `La red socioecológica actual cuenta con <b>${activeCount} especies bióticas activas</b> y un total de <b>${edgeCount} relaciones ecológicas interconectadas</b>.`;\n1296:       } else if (query.includes('amenaza') || query.includes('ruido') || query.includes('contaminacion')) {\n1297:         targetTaxon = nodes.find(n => n.alert.includes('Alta') || n.alert.includes('Peligro'));\n1298:         botMsg = `Las principales presiones antropogénicas registradas son el ruido vehicular continuous (>75dB en Av. Cali) y la eutrofización hídrica en La Vaca. Un taxón altamente vulnerable es <b>${targetTaxon ? targetTaxon.label : 'Tingua bogotana'}</b>.`;\n1299:       } else {\n1300:         // Fallback: select most connected species matching topic\n1301:         targetTaxon = [...nodes].filter(n => n.active).sort((a, b) => b.degree - a.degree)[0];\n1302:         botMsg = `Entendido. He analizado la topología del enjambre para tu consulta. Te ubico en el taxón con mayor centralidad biótica: <b>${targetTaxon ? targetTaxon.label : 'Especie Principal'}</b> con ${targetTaxon ? targetTaxon.degree : 0} interacciones activas.`;\n1303:       }\n1304: \n1305:       setTimeout(() => {\n1306:         const bBubble = document.createElement('div');\n1307:         bBubble.className = 'msg-bubble msg-bot';\n1308:         bBubble.innerHTML = botMsg;\n1309:         chatBody.appendChild(bBubble);\n1310:         chatBody.scrollTop = chatBody.scrollHeight;\n1311: \n1312:         if (targetTaxon) {\n1313:           openInspector(targetTaxon);\n1314:         }\n1315:       }, 300);\n1316:     }\n1317: \n1318:     function showToast(msg) {\n1319:       const toast = document.getElementById('toastNotify');\n1320:       toast.innerText = msg;\n1321:       toast.style.display = 'block';\n1322:       setTimeout(() => { toast.style.display = 'none'; }, 2500);\n1323:     }\n1324: \n1325:     function toggleCat(catId) {\n1326:       opts.cats[catId] = !opts.cats[catId];\n1327:       const toggleEl = document.getElementById(`toggleCat${catId}`);\n1328:       if (toggleEl) toggleEl.classList.toggle('checked', opts.cats[catId]);\n1329:       recalculateDegreesAndSizes();\n1330:     }\n1331: \n1332:     function toggleSideDrawer() {\n1333:       document.getElementById('sideDrawer').classList.toggle('collapsed');\n1334:       document.getElementById('btnToggleSide').classList.toggle('active');\n1335:     }\n1336: \n1337:     function resetCamera() {\n1338:       targetRotX = 0.25; targetRotY = 0.55; targetZoom = 420; targetPanX = 0; targetPanY = 0;\n1339:     }\n1340: \n1341:     function setLayout(mode) {\n1342:       opts.layoutMode = mode;\n1343:       nodes.forEach((n, idx) => {\n1344:         if (mode === 'clustered') {\n1345:           // Explicitly separate into 4 distinct 3D spatial category clusters\n1346:           const centers = {\n1347:             0: { x: -220, y: -80, z: -100 }, // Flora Cluster (Top-Left)\n1348:             1: { x: 220, y: -80, z: 100 },   // Avifauna Cluster (Top-Right)\n1349:             2: { x: -220, y: 140, z: 100 },   // Microorganismos Cluster (Bottom-Left)\n1350:             3: { x: 220, y: 140, z: -100 }    // Herpetos / MIA Cluster (Bottom-Right)\n1351:           };\n1352:           const center = centers[n.cat] || { x: 0, y: 0, z: 0 };\n1353:           const a = idx * 0.4;\n1354:           const r = 40 + (idx % 12) * 5;\n1355:           n.ox = center.x + Math.cos(a) * r;\n1356:           n.oy = center.y + (idx % 6) * 14 - 35;\n1357:           n.oz = center.z + Math.sin(a) * r;\n1358:         } else if (mode === 'concentric') {\n1359:           // 3 Pristine Orbital 3D Rings (Inner 110px, Middle 190px, Outer 270px)\n1360:           const ringIndex = idx % 3;\n1361:           const radius = 110 + ringIndex * 80;\n1362:           const totalInRing = Math.ceil(nodes.length / 3);\n1363:           const posInRing = Math.floor(idx / 3);\n1364:           const angle = (posInRing / totalInRing) * Math.PI * 2;\n1365:           \n1366:           n.ox = Math.cos(angle) * radius;\n1367:           n.oy = (ringIndex - 1) * 45 + Math.sin(angle * 2) * 15;\n1368:           n.oz = Math.sin(angle) * radius;\n1369:         } else if (mode === 'hyperbolic') {\n1370:           const phi = Math.acos(1 - 2 * ((idx + 0.5) / nodes.length));\n1371:           const theta = Math.PI * (1 + Math.sqrt(5)) * idx;\n1372:           const rad = 170 + ((idx * 17) % 110);\n1373:           n.ox = rad * Math.sin(phi) * Math.cos(theta);\n1374:           n.oy = rad * Math.sin(phi) * Math.sin(theta);\n1375:           n.oz = rad * Math.cos(phi);\n1376:         }\n1377:       });\n1378:     }\n1379: \n1380:     function searchNode(q) {\n1381:       if (!q.trim()) { searchedId = null; return; }\n1382:       const found = nodes.find(n => n.active && (n.label.toLowerCase().includes(q.toLowerCase()) || n.sciname.toLowerCase().includes(q.toLowerCase()) || n.taxaId.toLowerCase() === q.toLowerCase()));\n1383:       if (found) {\n1384:         searchedId = found.id;\n1385:         openInspector(found);\n1386:       } else {\n1387:         searchedId = null;\n1388:       }\n1389:     }\n1390: \n1391:     function openInspector(node) {\n1392:       selectedNode = node;\n1393:       const modal = document.getElementById('nodeInspector');\n1394: \n1395:       document.getElementById('mNodeTitle').innerText = node.label;\n1396:       document.getElementById('mNodeSciName').innerText = node.sciname;\n1397:       document.getElementById('mDegreeVal').innerText = node.degree;\n1398:       document.getElementById('mTaxaCode').innerText = node.taxaId;\n1399:       document.getElementById('mRoleBox').innerText = node.role;\n1400:       document.getElementById('mLocBox').innerText = node.loc;\n1401:       document.getElementById('mAlertBox').innerText = node.alert;\n1402: \n1403:       const imgEl = document.getElementById('mNodeImg');\n1404:       if (node.photoUrl) {\n1405:         imgEl.src = node.photoUrl;\n1406:         imgEl.style.display = 'block';\n1407:       } else {\n1408:         imgEl.style.display = 'none';\n1409:       }\n1410: \n1411:       document.getElementById('mNeighborHeader').innerText = `Interacciones Bióticas Clasificadas (${node.degree})`;\n1412:       const listEl = document.getElementById('mNeighborList');\n1413:       listEl.innerHTML = '';\n1414: \n1415:       const interactionTypes = [\n1416:         { name: 'Depredación', color: '#ff0033', bg: 'rgba(255,0,51,0.2)' },\n1417:         { name: 'Herbivoría', color: '#00ff88', bg: 'rgba(0,255,136,0.2)' },\n1418:         { name: 'Dispersión', color: '#ff80a0', bg: 'rgba(255,128,160,0.2)' },\n1419:         { name: 'Mutualismo', color: '#ffee33', bg: 'rgba(255,238,51,0.2)' },\n1420:         { name: 'Nidificación', color: '#ffaa00', bg: 'rgba(255,170,0,0.2)' },\n1421:         { name: 'Visita Floral', color: '#d000ff', bg: 'rgba(208,0,255,0.2)' },\n1422:         { name: 'Anidamiento', color: '#a0522d', bg: 'rgba(160,82,45,0.2)' },\n1423:         { name: 'Parasitismo', color: '#ffff00', bg: 'rgba(255,255,0,0.2)' },\n1424:         { name: 'Alelopatía', color: '#888888', bg: 'rgba(136,136,136,0.2)' }\n1425:       ];\n1426: \n1427:       node.neighbors.forEach((nb, idx) => {\n1428:         // Classify specific interaction type based on ecological category pairing\n1429:         let inter = interactionTypes[0]; // default\n1430:         if (node.cat === 0 && nb.cat === 1) inter = interactionTypes[5]; // Flora -> Avifauna (Visita Floral)\n1431:         else if (node.cat === 1 && nb.cat === 0) inter = interactionTypes[2]; // Avifauna -> Flora (Dispersión)\n1432:         else if (node.cat === 1 && nb.cat === 3) inter = interactionTypes[0]; // Avifauna -> Fauna (Depredación)\n1433:         else if (node.cat === 3 && nb.cat === 0) inter = interactionTypes[1]; // Fauna -> Flora (Herbivoría)\n1434:         else if (node.cat === 0 && nb.cat === 0) inter = interactionTypes[8]; // Flora -> Flora (Alelopatía)\n1435:         else if (node.cat === 2) inter = interactionTypes[3]; // Micro -> Mutualismo\n1436:         else inter = interactionTypes[(idx + node.id) % interactionTypes.length];\n1437: \n1438:         const item = document.createElement('div');\n1439:         item.className = 'neighbor-row';\n1440:         item.innerHTML = `\n1441:           <div style=\"display:flex; flex-direction:column; gap:2px;\">\n1442:             <span><b>${nb.label}</b> (<i>${nb.sciname}</i>)</span>\n1443:             <span style=\"font-size:8.5px; font-weight:700; color:${inter.color}; background:${inter.bg}; padding:1px 5px; border-radius:3px; width:fit-content; border:1px solid ${inter.color};\">\n1444:               Tipo: ${inter.name}\n1445:             </span>\n1446:           </div>\n1447:           <span style=\"color:#00ffff; font-size:9px; font-family:monospace; align-self:flex-start;\">${nb.taxaId}</span>\n1448:         `;\n1449:         item.onclick = (e) => {\n1450:           e.stopPropagation();\n1451:           openInspector(nb);\n1452:         };\n1453:         listEl.appendChild(item);\n1454:       });\n1455: \n1456:       modal.style.display = 'block';\n1457:       focusSelectedNode(node);\n1458:     }\n1459: \n1460:     // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not