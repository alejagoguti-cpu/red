.proj.x, s.proj.y);\n1074:           ctx.lineTo(t.proj.x, t.proj.y);\n1075:           ctx.stroke();\n1076: \n1077:           // Flow Direction Indicator Badge\n1078:           const mx = (s.proj.x + t.proj.x) / 2;\n1079:           const my = (s.proj.y + t.proj.y) / 2;\n1080:           ctx.font = '9px monospace';\n1081:           ctx.fillStyle = isHov || isSel ? '#E7C878' : '#94a3b8';\n1082:           ctx.fillText(e.id, mx - 6, my - 4);\n1083: \n1084:           ctx.restore();\n1085:         });\n1086:       }\n1087: \n1088:       const sorted = [...nodes].filter(n => n.active && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n1089: \n1090:       sorted.forEach(n => {\n1091:         if (!n.proj.visible) return;\n1092: \n1093:         const px = Math.round(n.proj.x);\n1094:         const py = Math.round(n.proj.y);\n1095:         const isHov = hoveredNode && hoveredNode.id === n.id;\n1096:         const isSel = selectedNode && selectedNode.id === n.id;\n1097: \n1098:         const rad = isHov || isSel ? 18 : 14;\n1099:         const levelColor = palette.levelColors[n.level] || '#E7C878';\n1100: \n1101:         ctx.save();\n1102:         ctx.beginPath();\n1103:         ctx.arc(px, py, rad, 0, Math.PI * 2);\n1104:         ctx.fillStyle = levelColor;\n1105:         ctx.fill();\n1106: \n1107:         ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : '#000000';\n1108:         ctx.lineWidth = 2.5;\n1109:         ctx.stroke();\n1110: \n1111:         ctx.font = 'bold 11px monospace';\n1112:         ctx.fillStyle = '#000000';\n1113:         ctx.textAlign = 'center';\n1114:         ctx.textBaseline = 'middle';\n1115:         ctx.fillText(n.id, px, py);\n1116: \n1117:         // Always show label in 3D\n1118:         ctx.font = 'bold 11px ui-monospace, monospace';\n1119:         ctx.fillStyle = '#ffffff';\n1120:         ctx.textAlign = 'left';\n1121:         ctx.shadowColor = '#000000';\n1122:         ctx.shadowBlur = 6;\n1123:         ctx.fillText(`${n.label} [N${n.level}]`, px + rad + 6, py + 3);\n1124: \n1125:         ctx.restore();\n1126:       });\n1127: \n1128:       requestAnimationFrame(render);\n1129:     }\n1130: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
