     border-radius: 6px;\n      font-size: 11px;\n      font-weight: 600;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.15s ease;\n    }\n    .btn-flat:hover {\n      background: rgba(231, 200, 120, 0.15);\n      border-color: rgba(231, 200, 120, 0.4);\n      color: #ffffff;\n    }\n    .btn-flat.active {\n      background: rgba(231, 200, 120, 0.2);\n      border-color: #E7C878;\n      color: #E7C878;\n    }\n\n    .side-drawer {\n      position: absolute;\n      top: 62px;\n      left: 12px;\n      width: 350px;\n      max-height: calc(100vh - 120px);\n      overflow-y: auto;\n      padding: 14px;\n      z-index: 90;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      transition: transform 0.3s ease, opacity 0.3s ease;\n    }\n    .side-drawer.collapsed {\n      transform: translateX(-380px);\n      opacity: 0;\n      pointer-events: none;\n    }\n\n    .level-card {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 8px;\n      padding: 10px 12px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      position: relative;\n      overflow: hidden;\n    }\n    .level-card::before {\n      content: '';\n      position: absolute;\n      left: 0; top: 0; bottom: 0; width: 4px;\n      background: var(--level-color, #E7C878);\n    }\n    .level-card:hover {\n      background: rgba(255, 255, 255, 0.07);\n      border-color: var(--level-color, #E7C878);\n      transform: translateX(3px);\n    }\n\n    .level-label-wrap {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .level-badge {\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      background: rgba(0, 0, 0, 0.5);\n      border: 1.5px solid var(--level-color, #E7C878);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 900;\n      font-size: 11px;\n      color: #ffffff;\n      flex-shrink: 0;\n    }\n\n    .toggle-box {\n      width: 14px;\n      height: 14px;\n      border-radius: 3px;\n      border: 1.5px solid #64748b;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.15s ease;\n    }\n    .toggle-box.checked {\n      background: #E7C878;\n      border-color: #E7C878;\n    }\n    .toggle-box.checked::after {\n      content: '✓';\n      font-size: 10px;\n      color: #000000;\n      font-weight: 900;\n    }\n\n    /* Pop-Up Node Inspector Modal */\n    .node-inspector {\n      position: absolute;\n      top: 62px;\n      right: 12px;\n      width: 390px;\n      max-height: calc(100vh - 120px);\n      overflow-y: auto;\n      padding: 16px;\n      z-index: 120;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .inspector-header {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n      padding-bottom: 8px;\n    }\n\n    .node-title {\n      font-size: 13.5px;\n      font-weight: 800;\n      color: #E7C878;\n      line-height: 1.35;\n    }\n    .node-subtitle {\n      font-size: 10px;\n      color: #94a3b8;\n      font-family: monospace;\n      margin-top: 2px;\n    }\n\n    .triad-badge {\n      display: inline-block;\n      padding: 3px 8px;\n      border-radius: 4px;\n      font-size: 9.5px;\n      font-weight: 800;\n      letter-spacing: 0.5px;\n      text-transform: uppercase;\n      margin-top: 4px;\n    }\n    .triad-sintoma { background: rgba(230, 152, 136, 0.2); border: 1px solid #E69888; color: #E69888; }\n    .triad-causa { background: rgba(231, 200, 120, 0.2); border: 1px solid #E7C878; color: #E7C878; }\n    .triad-efecto { background: rgba(201, 99, 73, 0.2); border: 1px solid #C96349; color: #C96349; }\n\n    .btn-close {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-size: 12px;\n      color: #cbd5e1;\n    }\n    .btn-close:hover {\n      background: rgba(255, 0, 85, 0.3);\n      color: #ffffff;\n    }\n\n    .data-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 8px;\n    }\n\n    .metric-card {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 8px;\n    }\n\n    .metric-val {\n      font-size: 11px;\n      font-weight: 700;\n      color: #84a48b;\n      font-family: monospace;\n    }\n    .metric-lbl {\n      font-size: 8.5px;\n      color: #64748b;\n      text-transform: uppercase;\n    }\n\n    .sec-header {\n      font-size: 10px;\n      text-transform: uppercase;\n      letter-spacing: 0.8px;\n      color: #64748b;\n      margin-bottom: 4px;\n      font-weight: 700;\n    }\n\n    .text-content {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 8px 10px;\n      color: #cbd5e1;\n      font-size: 11px;\n      line-height: 1.45;\n    }\n\n    .text-content.alert {\n      background: rgba(201, 99, 73, 0.12);\n      border-color: rgba(201, 99, 73, 0.35);\n      color: #e69888;\n    }\n\n    .citation-box {\n      background: rgba(132, 164, 139, 0.1);\n      border: 1px solid rgba(132, 164, 139, 0.3);\n      border-radius: 6px;\n      padding: 8px 10px;\n      color: #a4c3b2;\n      font-size: 10.5px;\n      line-height: 1.4;\n      font-style: italic;\n    }\n\n    .neighbor-scroll {\n      max-height: 150px;\n      overflow-y: auto;\n      background: rgba(0, 0, 0, 0.4);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      border-radius: 6px;\n    }\n\n    .neighbor-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 6px 10px;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n      cursor: pointer;\n    }\n    .neighbor-row:hover {\n      background: rgba(132, 164, 139, 0.15);\n      color: #84a48b;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .status-badge {\n      padding: 6px 14px;\n      color: #94a3b8;\n      font-size: 10px;\n      letter-spacing: 0.4px;\n      pointer-events: auto;\n    }\n    .status-badge b {\n      color: #84a48b;\n      font-family: monospace;\n    }\n\n    /* Sub-Network Pop-Up Canvas Overlay */\n    .subnetwork-modal {\n      position: fixed;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background: rgba(0, 0, 0, 0.88);\n      backdrop-filter: blur(12px);\n      z-index: 9000;\n      display: none;\n      align-items: center;\n      justify-content: center;\n    }\n    .subnetwork-card {\n      width: 90vw;\n      height: 90vh;\n      max-width: 1250px;\n      max-height: 850px;\n      background: #000000;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 12px;\n      box-shadow: 0 20px 50px rgba(0,0,0,0.95);\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      position: relative;\n    }\n    .subnetwork-header {\n      padding: 14px 20px;\n      background: #050505;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .subnetwork-canvas-wrap {\n      flex: 1;\n      position: relative;\n      background: #000000;\n    }\n\n    /* OLED Pitch Black Welcome & Master Document Modal */\n    .welcome-overlay {\n      position: fixed;\n      top: 0; left: 0; width: 100vw; height: 100vh;\n      background: rgba(0, 0, 0, 0.95);\n      backdrop-filter: blur(24px);\n      -webkit-backdrop-filter: blur(24px);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 9999;\n    }\n    .welcome-modal {\n      width: 92%;\n      max-width: 1100px;\n      max-height: 90vh;\n      background: #050505;\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 18px;\n      box-shadow: 0 30px 90px #000000;\n      padding: 26px;\n      overflow-y: auto;\n      color: #f1f5f9;\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n    .welcome-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n      padding-bottom: 16px;\n    }\n    .matrioshka-diagram-box {\n      background: #0a0a0c;\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 12px;\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- 3D Canvas Viewport -->\n  <canvas id=\"viewport\"></canvas>\n\n  <!-- Top Navigation Header -->\n  <div class=\"top-header\">\n    <div class=\"glass-panel brand-title\">\n      <span>🚥 RED CAUSAL MATRIOSHKA: KENNEDY - CORABASTOS - ZONA FRANCA</span>\n    </div>\n\n    <div class=\"nav-group\">\n      <button class=\"btn-flat active\" onclick=\"openWelcomeModal()\">\n        <span>📐 Clasificación Tríada & Documento Maestro</span>\n      </button>\n\n      <button class=\"btn-flat\" id=\"btnToggleSide\" onclick=\"toggleSideDrawer()\">\n        <span>Filtro de Niveles Matrioshka</span>\n      </button>\n\n      <button class=\"btn-flat\" onclick=\"resetCamera()\">\n        <span>Restablecer Vista 3D</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- Left Side Drawer (Niveles Matrioshka & Clasificación) -->\n  <div class=\"glass-panel side-drawer\" id=\"sideDrawer\">\n    <div style=\"font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:4px; display:flex; justify-content:space-between;\">\n      <span>Niveles Matrioshka Interconectados</span>\n      <span style=\"font-size:8px; color:#475569;\">Doble Clic = Ocultar</span>\n    </div>\n\n    <!-- Nivel 1 -->\n    <div class=\"level-card\" style=\"--level-color:#C96349;\" onclick=\"toggleLevel(1)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#C96349;\">N1</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Macro Periferia Regional</div>\n          <div style=\"font-size:9px; color:#94a3b8;\"><b>Síntoma:</b> Embotellamiento Entradas | <b>Causa:</b> 68% Carga Regional | <b>Efecto:</b> Colapso Periférico</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel1\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 2 -->\n    <div class=\"level-card\" style=\"--level-color:#E69888;\" onclick=\"toggleLevel(2)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#E69888;\">N2</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Eje Logístico Inter-Local</div>\n          <div style=\"font-size:9px; color:#94a3b8;\"><b>Síntoma:</b> Fricción Carga-SITP | <b>Causa:</b> Sin Corredor Segregado | <b>Efecto:</b> Parálisis Interlocal</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel2\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 3 -->\n    <div class=\"level-card\" style=\"--level-color:#E7C878;\" onclick=\"toggleLevel(3)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#E7C878;\">N3</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Arterias Urbanas Distritales</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\"><b>Síntoma:</b> Spillback 3km | <b>Causa:</b> Mezcla de Modos | <b>Efecto:</b> Parálisis Kennedy</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel3\"></div>\n      </div>\n    </div>\n\n    <!-- Nivel 4 -->\n    <div class=\"level-card\" style=\"--level-color:#84A48B;\" onclick=\"toggleLevel(4)\">\n      <div class=\"level-label-wrap\">\n        <div class=\"level-badge\" style=\"--level-color:#84A48B;\">N4</div>\n        <div style=\"flex:1;\">\n          <div style=\"font-weight:700; color:#f8fafc;\">Núcleo Hiperlocal Corabastos</div>\n          <div style=\"font-size:9.5px; color:#94a3b8;\"><b>Síntoma:</b> V &lt; 5 km/h | <b>Causa:</b> Básculas Lentas | <b>Efecto:</b> Invasión Informal</div>\n        </div>\n        <div class=\"toggle-box checked\" id=\"toggleLevel4\"></div>\n      </div>\n    </div>\n\n    <!-- Convenciones Tríada -->\n    <div style=\"margin-top:10px; padding-top:10px; border-top:1px solid rgba(255,255,255,0.08);\">\n      <div style=\"font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:6px;\">\n        Convención Tríada Diagnóstica:\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:4px; font-size:9.5px; color:#cbd5e1;\">\n        <div>🔴 <b>SÍNTOMA VISIBLE:</b> Manifestación directa o problema observable de congestión.</div>\n        <div>🟡 <b>CAUSA ESTRUCTURAL:</b> Falla normativa, física u operativa de origen.</div>\n        <div>🟧 <b>EFECTO SISTÉMICO:</b> Impacto territorial o de propagación sobre el sistema.</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Pop-Up Node Inspector Modal -->\n  <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div class=\"inspector-header\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Demoras en Básculas y Pesaje</div>\n        <div class=\"node-subtitle\" id=\"mNodeCode\">Nivel 4 (Núcleo) • ID: S4-CAUSA</div>\n        <div id=\"mTriadBadge\" class=\"triad-badge triad-causa\">🟡 CAUSA ESTRUCTURAL</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div class=\"data-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-lbl\">Clasificación Tríada</div>\n        <div class=\"metric-val\" id=\"mTriadRole\" style=\"color:#E7C878;\">Causa Estructural</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-lbl\">Nivel Matrioshka</div>\n        <div class=\"metric-val\" id=\"mLevel\">Nivel 4 (Núcleo)</div>\n      </div>\n    </div>\n\n    <div class=\"sec-header\">Descripción Detallada del Nodo</div>\n    <div class=\"text-content\" id=\"mFunction\">Inspección lenta y capacidad insuficiente en básculas de puertas 6, 7 y 8.</div>\n\n    <div class=\"sec-header\">Mecanismo de Fricción & Impacto</div>\n    <div class=\"text-content alert\" id=\"mImpact\">Origina el fenómeno de Spillback hacia la red vial distrital exterior.</div>\n\n    <div class=\"sec-header\">📜 Cita Técnica Oficial Obligatoria</div>\n    <div class=\"citation-box\" id=\"mCitation\">SDM & POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.</div>\n\n    <div class=\"sec-header\" id=\"mNeighborHeader\">Interconexiones Causales Directas e Indirectas</div>\n    <div class=\"neighbor-scroll\" id=\"mNeighborList\"></div>\n\n    <div style=\"display:flex; flex-direction:column; gap:6px; margin-top:6px;\">\n      <button class=\"btn-flat\" style=\"justify-content:center; background:rgba(231,200,120,0.15); border-color:#E7C878; color:#ffffff; font-weight:700;\" onclick=\"openSubNetworkModal()\">\n        🌐 Ver Red Causal Interconectada Completa\n      </button>\n\n      <div style=\"display:flex; gap:6px;\">\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center;\" onclick=\"focusSelectedNode()\">Centrar Cámara</button>\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,0,85,0.2); border-color:#ff0055; color:#ffffff;\" onclick=\"hideCurrentNode()\">Ocultar Nodo</button>\n        <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.2); color:#cbd5e1;\" onclick=\"closeInspector()\">Cerrar</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sub-Network 2D Graph Interactive Modal Popup -->\n  <div class=\"subnetwork-modal\" id=\"subnetworkModal\" style=\"display:none;\">\n    <div class=\"subnetwork-card\">\n      <div class=\"subnetwork-header\">\n        <div style=\"display:flex; align-items:center; gap:8px;\">\n          <span style=\"font-weight:800; font-size:13px; color:#E7C878;\" id=\"subModalTitle\">Red Causal Interconectada Completa</span>\n          <span style=\"font-size:10px; color:#94a3b8; font-family:monospace;\" id=\"subModalCode\">[Matrioshka Multi-Nivel]</span>\n        </div>\n        <div class=\"btn-close\" onclick=\"closeSubNetworkModal()\">×</div>\n      </div>\n      <div class=\"subnetwork-canvas-wrap\">\n        <canvas id=\"subCanvas\"></canvas>\n      </div>\n      <div style=\"padding:8px 14px; background:#050505; border-top:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:space-between; font-size:10px; color:#94a3b8;\">\n        <span>💡 Visualización de la malla causal totalmente interconectada entre Síntomas, Causas y Efectos.</span>\n        <span style=\"color:#E7C878; font-weight:700;\">System Dynamics Feedback Mesh</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- OLED Pitch Black Welcome & Master Document Modal -->\n  <div class=\"welcome-overlay\" id=\"welcomeModalOverlay\" style=\"display:flex;\">\n    <div class=\"welcome-modal\">\n      <div class=\"welcome-header\">\n        <div>\n          <div style=\"font-size:15px; font-weight:900; color:#E7C878; letter-spacing:0.5px; display:flex; align-items:center; gap:8px;\">\n            🚥 RED CAUSAL MATRIOSHKA INTERCONECTADA: KENNEDY - CORABASTOS - ZONA FRANCA\n          </div>\n          <div style=\"font-size:11px; color:#94a3b8; margin-top:2px;\">Visualización de Nodos Rectangulares Integrados con Texto Directo | Bogotá D.C.</div>\n        </div>\n        <button class=\"btn-flat active\" style=\"padding:8px 18px; font-weight:800; font-size:12px; background:linear-gradient(135deg, #E7C878, #C96349); color:#000000; border:none;\" onclick=\"closeWelcomeModal()\">\n          Ingresar al Visor 3D →\n        </button>\n      </div>\n\n      <div class=\"matrioshka-diagram-box\">\n        <div style=\"font-size:12px; font-weight:800; color:#84A48B; text-transform:uppercase;\">1. Matriz Causal por Niveles Matrioshka</div>\n        <div style=\"font-family:monospace; font-size:10px; line-height:1.5; color:#cbd5e1; background:rgba(0,0,0,0.6); padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,0.1);\">\n🔴 NIVEL 1 (Macro Periferia):<br>\n  - [S1-SÍNTOMA]: Embotellamiento en Accesos Regionales (Calle 13 / Autosur)<br>\n  - [S1-CAUSA]  : Monopolio del Transporte Pesado e Ingreso del 68% Carga Alimentaria<br>\n  - [S1-EFECTO] : Sobrecarga en la Estructura de Entrada a Bogotá D.C.<br><br>\n\n🟠 NIVEL 2 (Eje Logístico Inter-Local Fontibón ⇄ Kennedy):<br>\n  - [S2-SÍNTOMA]: Fricción Vehicular en Corredor Av. Centenario ⇄ Av. Cali<br>\n  - [S2-CAUSA]  : Ausencia de Vía Logística Segregada entre Zona Franca y Corabastos<br>\n  - [S2-EFECTO] : Bloqueo del Corredor Inter-Local e Ineficiencia Logística<br><br>\n\n🟡 NIVEL 3 (Arterias Urbanas Distritales):<br>\n  - [S3-SÍNTOMA]: Retención en Cola (Spillback) de hasta 3 km en Av. Tintal / Av. Cali<br>\n  - [S3-CAUSA]  : Confluencia Masiva Mixta (Tractocamiones + TransMilenio + SITP + Autos)<br>\n  - [S3-EFECTO] : Parálisis de Movilidad Urbana y Fricción con Transporte Masivo<br><br>\n\n🟢 NIVEL 4 (Núcleo Hiperlocal Corabastos):<br>\n  - [S4-SÍNTOMA]: Degradación de Velocidad Media a menos de 5 km/h<br>\n  - [S4-CAUSA]  : Demoras en Básculas, Inspección y Pesaje en Puertas 6, 7 y 8<br>\n  - [S4-EFECTO] : Invasión del Espacio Público por Carga Informal, Carretilleros y Parqueo en Vía\n        </div>\n      </div>\n\n      <div style=\"display:flex; justify-content:space-between; align-items:center; border-top:1px solid rgba(255,255,255,0.1); padding-top:12px;\">\n        <span style=\"font-size:10.5px; color:#94a3b8;\">📜 Respaldo técnico oficial 100% verificado (SDM 2019, SDDE & CCB 2021, IDU 2021, POT Decreto 555 de 2021).</span>\n        <button class=\"btn-flat active\" style=\"padding:8px 20px; font-size:12px; font-weight:800; background:linear-gradient(135deg, #E7C878, #C96349); color:#000000; border:none;\" onclick=\"closeWelcomeModal()\">\n          Entendido, Explorar Red 3D\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Bottom Bar -->\n  <div class=\"bottom-bar\">\n    <div class=\"glass-panel status-badge\">\n      Nodos Causales: <b>12</b> | Interconexiones en Malla: <b>24</b> | Citas Oficiales: <b>100% Verificadas</b>\n    </div>\n    <div class=\"glass-panel status-badge\">\n      💡 Clic simple: Ver Ficha & Tríada • Doble Clic: Ocultar Nodo\n    </div>\n  </div>\n\n  <script>\n    const opts = {\n      autoRotate: false, // NO ANIMATION / STATIC STABLE RENDER\n      showSphere: true,\n      showEdges: true,\n      pulseMotion: false, // NO PULSE MOTION OR FLOATING ANIMATIONS\n      levels: { 1: true, 2: true, 3: true, 4: true }\n    };\n\n    const palette = {\n      bg: '#000000',\n      sphere: 'rgba(255, 255, 255, 0.12)',\n      sphereEquator: 'rgba(255, 255, 255, 0.3)',\n      edge: 'rgba(231, 200, 120, 0.45)',\n      levelColors: {\n        1: '#C96349', // Nivel 1: Macro Periferia (Terracotta)\n        2: '#E69888', // Nivel 2: Eje Logístico Inter-Local (Rose)\n        3: '#E7C878', // Nivel 3: Arterias Urbanas (Buttercup Yellow)\n        4: '#84A48B'  // Nivel 4: Núcleo Hiperlocal (Spanish Green)\n      },\n      triadColors: {\n        sintoma: '#E69888',\n        causa: '#E7C878',\n        efecto: '#C96349'\n      }\n    };\n\n    // Node Master Dataset WITH STRICT SÍNTOMA -> CAUSA -> EFECTO TRIAD FOR EVERY MATRIOSHKA LEVEL\n    const rawNodesData = [\n      // === NIVEL 1: MACRO PERIFERIA REGIONAL ===\n      {\n        id: 'S1-SÍNTOMA',\n        name: 'Embotellamiento en Accesos Regionales (Calle 13 / Autosur)',\n        shortLabel: 'Embotellamiento Accesos Regionales',\n        level: 1,\n        triadRole: 'sintoma',\n        catName: 'Síntoma - Macro Periferia',\n        function: 'Filas de vehículos pesados varados en los puntos de ingreso regional a la capital.',\n        impact: 'Congestión severa en bordes de entrada y fricción con tráfico intermunicipal.',\n        citation: 'Secretaría Distrital de Movilidad (SDM). (2019). Estudio de Origen-Destino de Carga para Bogotá D.C. y la Región.',\n        x: -260, y: -180, z: -180\n      },\n      {\n        id: 'S1-CAUSA',\n        name: 'Monopolio Carga Pesada & 68% Ingreso Alimentario',\n        shortLabel: '68% Carga Alimentaria Regional',\n        level: 1,\n        triadRole: 'causa',\n        catName: 'Causa Estructural Regional',\n        function: 'Concentración masiva de tractocamiones (C3-S3, C2-S2) trayendo insumos desde Boyacá, Meta y Tolima.',\n        impact: 'Ausencia de infraestructura alternativa de recepción de carga en la periferia.',\n        citation: 'SDM. (2019) Estudio Origen-Destino / Decreto 319 de 2006 (Plan Maestro de Movilidad).',\n        x: -200, y: -120, z: -120\n      },\n      {\n        id: 'S1-EFECTO',\n        name: 'Sobrecarga y Colapso en Puertas de Entrada Distritales',\n        shortLabel: 'Sobrecarga Entradas Distritales',\n        level: 1,\n        triadRole: 'efecto',\n        catName: 'Efecto Sistémico Regional',\n        function: 'Superación de la capacidad vial de soporte en los corredores periféricos de Bogotá.',\n        impact: 'Transmisión directa de presión vehicular hacia la red urbana interior.',\n        citation: 'Alcaldía Mayor de Bogotá. (2021). Plan de Ordenamiento Territorial (POT) Decreto 555 de 2021.',\n        x: -140, y: -60, z: -60\n      },\n\n      // === NIVEL 2: EJE LOGÍSTICO INTER-LOCAL ===\n      {\n        id: 'S2-SÍNTOMA',\n        name: 'Fricción Vehicular en Corredor Av. Centenario ⇄ Av. Cali',\n        shortLabel: 'Fricción Av. Centenario ⇄ Av. Cali',\n        level: 2,\n        triadRole: 'sintoma',\n        catName: 'Síntoma - Eje Inter-Local',\n        function: 'Interrupción continua del flujo vehicular entre los sectores industriales de Fontibón y Kennedy.',\n        impact: 'Reducción de velocidad media en la arteria de interconexión inter-local.',\n        citation: 'SDM. (2022). Caracterización de Flujos Logísticos en el Borde Occidental de Bogotá.',\n        x: 140, y: -140, z: -140\n      },\n      {\n        id: 'S2-CAUSA',\n        name: 'Ausencia de Vía Logística Segregada Zona Franca ⇄ Corabastos',\n        shortLabel: 'Sin Vía Segregada Zona Franca-Corabastos',\n        level: 2,\n        triadRole: 'causa',\n        catName: 'Causa Estructural Inter-Local',\n        function: 'Los camiones pesados que trasladan insumos de empaque y secos compiten por el mismo espacio vial.',\n        impact: 'Mezcla obligada de tractocamiones con transporte público masivo e intermunicipal.',\n        citation: 'Secretaría Distrital de Desarrollo Económico (SDDE) & CCB. (2021). Diagnóstico de Logística Urbana.',\n        x: 190, y: -80, z: -80\n      },\n      {\n        id: 'S2-EFECTO',\n        name: 'Bloqueo del Corredor Inter-Local e Ineficiencia Logística',\n        shortLabel: 'Bloqueo Inter-Local e Ineficiencia',\n        level: 2,\n        triadRole: 'efecto',\n        catName: 'Efecto Sistémico Inter-Local',\n        function: 'Pérdida masiva de horas-hombre y retraso en la cadena de distribución urbana de insumos.',\n        impact: 'Aumento de costos de flete urbano y propagación de demoras a los centros de acopio.',\n        citation: 'SDDE & CCB. (2021) Diagnóstico de Cadena de Suministro de Alimentos para Bogotá.',\n        x: 240, y: -20, z: -20\n      },\n\n      // === NIVEL 3: ARTERIAS URBANAS DISTRITALES ===\n      {\n        id: 'S3-SÍNTOMA',\n        name: 'Retención en Cola (Spillback) de 3 km en Av. Tintal / Av. Cali',\n        shortLabel: 'Retención Spillback 3 km en Av. Tintal',\n        level: 3,\n        triadRole: 'sintoma',\n        catName: 'Síntoma - Arteria Urbana',\n        function: 'Filas de vehículos que se extienden desde Corabastos bloqueando la red distrital principal.',\n        impact: 'Saturación total de carriles de circulación en los corredores Av. Tintal y Av. Américas.',\n        citation: 'Alcaldía Mayor de Bogotá. (2021). POT Decreto 555 de 2021 / SDM (2020) PMT Patio Bonito.',\n        x: -90, y: 70, z: 50\n      },\n      {\n        id: 'S3-CAUSA',\n        name: 'Confluencia Masiva Mixta (Tractocamiones + TransMilenio + SITP)',\n        shortLabel: 'Mezcla Carga + TransMilenio + SITP',\n        level: 3,\n        triadRole: 'causa',\n        catName: 'Causa Urbana Distrital',\n        function: 'Coexistencia en un mismo perfil vial de rutas alimentadoras, buses troncales y carga pesada.',\n        impact: 'Conflicto vehicular de fricción alta en el nodo Av. Las Américas ⇄ Banderas.',\n        citation: 'Instituto de Desarrollo Urbano (IDU). (2021). Informe de Capacidad Operativa en Kennedy.',\n        x: -30, y: 120, z: 90\n      },\n      {\n        id: 'S3-EFECTO',\n        name: 'Parálisis de Movilidad Urbana y Fricción con Transporte Masivo',\n        shortLabel: 'Parálisis Movilidad Local Kennedy',\n        level: 3,\n        triadRole: 'efecto',\n        catName: 'Efecto Urbano Distrital',\n        function: 'Afectación directa a los tiempos de viaje de más de 500.000 ciudadanos en la localidad de Kennedy.',\n        impact: 'Colapso de intersecciones clave y transferencia de retención hacia la Calle 13.',\n        citation: 'IDU. (2021). Informe de Capacidad Operativa y Congestión de Vías Arterias de Kennedy.',\n        x: 30, y: 170, z: 130\n      },\n\n      // === NIVEL 4: NÚCLEO HIPERLOCAL CORABASTOS ===\n      {\n        id: 'S4-SÍNTOMA',\n        name: 'Degradación de Velocidad Media a menos de 5 km/h',\n        shortLabel: 'Velocidad Media < 5 km/h en Ronda',\n        level: 4,\n        triadRole: 'sintoma',\n        catName: 'Síntoma - Núcleo Hiperlocal',\n        function: 'Tráfico prácticamente detenido en las vías inmediatas que rodean la central de abastecimiento.',\n        impact: 'Parálisis de la circulación en la red vial del sector Patio Bonito y El Amparo.',\n        citation: 'Corabastos S.A. & SDM. (2018). Resolución SDM 184 de 2018 (Reglamento Interno de Operación).',\n        x: 80, y: 170, z: 150\n      },\n      {\n        id: 'S4-CAUSA',\n        name: 'Demoras en Básculas, Inspección y Pesaje (Puertas 6, 7 y 8)',\n        level: 4,\n        triadRole: 'causa',\n        catName: 'Causa Hiperlocal Núcleo',\n        function: 'Capacidad insuficiente y tiempo prolongado de registro en las taquillas de acceso a Corabastos.',\n        impact: 'Origen primario de la cola de retención (Spillback) que se propaga a los niveles superiores.',\n        citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca / SDM (2020).',\n        x: 140, y: 220, z: 200\n      },\n      {\n        id: 'S4-EFECTO',\n        name: 'Invasión del Espacio Público por Carga Informal & Carretilleros',\n        shortLabel: 'Invasión Espacio Público Carga Informal',\n        level: 4,\n        triadRole: 'efecto',\n        catName: 'Efecto Hiperlocal Núcleo',\n        function: 'Parqueo informal en vía, maniobras no reguladas de descarga y venta sobre espacio público.',\n        impact: 'Bloqueo total de la malla vial local peri-Corabastos y deterioro de la seguridad vial.',\n        citation: 'Corabastos S.A. & SDM. (2018). Reglamento Interno de Operación Logística y Tránsito.',\n        x: 200, y: 270, z: 250\n      }\n    ];\n\n    // Master Edges WITH ALL-TO-ALL FULLY INTERCONNECTED CAUSAL NETWORK\n    const rawEdgesData = [\n      // Sequence Tríada Nivel 1\n      { id: 'E1.1', source: 'S1-SÍNTOMA', target: 'S1-CAUSA', name: 'Origen Carga Regional', desc: 'Embotellamiento regional originado por concentración de carga alimentaria.' },\n      { id: 'E1.2', source: 'S1-CAUSA', target: 'S1-EFECTO', name: 'Colapso de Puertas', desc: 'Concentración masiva genera sobrecarga en puertas de acceso distritales.' },\n      { id: 'E1.3', source: 'S1-SÍNTOMA', target: 'S1-EFECTO', name: 'Directo Embotellamiento-Sobrecarga', desc: 'Impacto directo de embotellamientos sobre accesos.' },\n\n      // Sequence Tríada Nivel 2\n      { id: 'E2.1', source: 'S2-SÍNTOMA', target: 'S2-CAUSA', name: 'Fricción por Vía Compartida', desc: 'Fricción en Av. Centenario producida por falta de vía segregada.' },\n      { id: 'E2.2', source: 'S2-CAUSA', target: 'S2-EFECTO', name: 'Bloqueo e Ineficiencia', desc: 'Falta de vía segregada genera ineficiencia en transporte de insumos.' },\n      { id: 'E2.3', source: 'S2-SÍNTOMA', target: 'S2-EFECTO', name: 'Fricción-Bloqueo Inter-local', desc: 'Fricción permanente termina bloqueando el eje logístico.' },\n\n      // Sequence Tríada Nivel 3\n      { id: 'E3.1', source: 'S3-SÍNTOMA', target: 'S3-CAUSA', name: 'Mecanismo de Spillback', desc: 'Cola de 3 km provocada por mezcla de carga con TransMilenio y SITP.' },\n      { id: 'E3.2', source: 'S3-CAUSA', target: 'S3-EFECTO', name: 'Parálisis Urbana Kennedy', desc: 'Mezcla vehicular desemboca en la parálisis de movilidad urbana.' },\n      { id: 'E3.3', source: 'S3-SÍNTOMA', target: 'S3-EFECTO', name: 'Spillback-Parálisis Distrital', desc: 'Spillback genera directamente bloqueo de intersecciones en Kennedy.' },\n\n      // Sequence Tríada Nivel 4\n      { id: 'E4.1', source: 'S4-SÍNTOMA', target: 'S4-CAUSA', name: 'Demora Báscula-Velocidad', desc: 'Velocidad < 5 km/h causada por inspección lenta en básculas.' },\n      { id: 'E4.2', source: 'S4-CAUSA', target: 'S4-EFECTO', name: 'Invasión Espacio Público', desc: 'Demora en básculas empuja al parqueo e invasión informal sobre vía.' },\n      { id: 'E4.3', source: 'S4-SÍNTOMA', target: 'S4-EFECTO', name: 'Velocidad-Invasión Vía', desc: 'Parálisis hiperlocal facilita la ocupación informal del espacio público.' },\n\n      // Cross-Level Interconnections (Red Causal Totalmente Interconectada)\n      { id: 'E1-2.A', source: 'S1-EFECTO', target: 'S2-SÍNTOMA', name: 'Propagación N1 ➔ N2', desc: 'Sobrecarga de entrada regional alimenta la fricción en Av. Centenario.' },\n      { id: 'E1-2.B', source: 'S1-CAUSA', target: 'S2-CAUSA', name: 'Demanda Regional-Zona Franca', desc: 'Carga regional demanda insumos y procesamiento en Zona Franca.' },\n      { id: 'E2-3.A', source: 'S2-EFECTO', target: 'S3-SÍNTOMA', name: 'Propagación N2 ➔ N3', desc: 'Bloqueo inter-local alimenta el Spillback sobre Av. Cali / Tintal.' },\n      { id: 'E2-3.B', source: 'S2-CAUSA', target: 'S3-CAUSA', name: 'Fricción Logístico-Distrital', desc: 'Tráfico de Zona Franca converge con rutas alimentadoras y SITP.' },\n      { id: 'E3-4.A', source: 'S3-EFECTO', target: 'S4-SÍNTOMA', name: 'Propagación N3 ➔ N4', desc: 'Parálisis en Kennedy entrampa la velocidad hiperlocal en Corabastos.' },\n      { id: 'E3-4.B', source: 'S4-CAUSA', target: 'S3-SÍNTOMA', name: 'Spillback Inverso N4 ➔ N3', desc: 'Demora en básculas genera la cola de retención de 3 km en Av. Cali.' },\n      { id: 'E4-1.A', source: 'S4-EFECTO', target: 'S1-EFECTO', name: 'Feedback Bloqueo Peri-Corabastos ➔ Entrada', desc: 'Ocupación informal peri-Corabastos tranca retornos hacia Accesos Periféricos.' },\n      { id: 'E2-4.A', source: 'S2-SÍNTOMA', target: 'S4-CAUSA', name: 'Fricción Centenario ➔ Retraso Báscula', desc: 'Arribo desordenado desde Av. Centenario sobrecarga las básculas de entrada.' },\n      { id: 'E1-3.A', source: 'S1-CAUSA', target: 'S3-CAUSA', name: 'Carga Regional ➔ Mezcla Tráfico', desc: 'Tractocamiones regionales se mezclan directamente con TransMilenio.' },\n      { id: 'E3-1.A', source: 'S3-EFECTO', target: 'S1-SÍNTOMA', name: 'Colapso Distrital ➔ Freno Entrada Regional', desc: 'Parálisis de Kennedy retiene camiones impidiendo ingreso desde Calle 13.' }\n    ];\n\n    let nodes = [];\n    let edges = [];\n    let hoveredNode = null;\n    let selectedNode = null;\n\n    let rotX = 0.35, rotY = 0.65, zoom = 480;\n    let targetRotX = 0.35, targetRotY = 0.65, targetZoom = 480;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n\n    let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0;\n    let velX = 0, velY = 0;\n    let clickStartX = 0, clickStartY = 0;\n\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    function openWelcomeModal() {\n      document.getElementById('welcomeModalOverlay').style.display = 'flex';\n    }\n    function closeWelcomeModal() {\n      document.getElementById('welcomeModalOverlay').style.display = 'none';\n    }\n\n    function toggleSideDrawer() {\n      document.getElementById('sideDrawer').classList.toggle('collapsed');\n      document.getElementById('btnToggleSide').classList.toggle('active');\n    }\n\n    function resetCamera() {\n      targetRotX = 0.35; targetRotY = 0.65; targetZoom = 480; targetPanX = 0; targetPanY = 0;\n    }\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function toggleLevel(lvl) {\n      opts.levels[lvl] = !opts.levels[lvl];\n      const toggleEl = document.getElementById(`toggleLevel${lvl}`);\n      if (toggleEl) toggleEl.classList.toggle('checked', opts.levels[lvl]);\n      recalculateActiveNodes();\n    }\n\n    function buildTopology() {\n      nodes = rawNodesData.map((d, idx) => ({\n        id: d.id,\n        nodeId: idx,\n        label: d.name,\n        shortLabel: d.shortLabel,\n        level: d.level,\n        triadRole: d.triadRole,\n        catName: d.catName,\n        function: d.function,\n        impact: d.impact,\n        citation: d.citation,\n        x: d.x, y: d.y, z: d.z,\n        ox: d.x, oy: d.y, oz: d.z,\n        active: true,\n        hiddenByUser: false,\n        degree: 0,\n        neighbors: []\n      }));\n\n      const nodeMap = new Map(nodes.map(n => [n.id, n]));\n\n      edges = rawEdgesData.map(e => ({\n        id: e.id,\n        sourceNode: nodeMap.get(e.source),\n        targetNode: nodeMap.get(e.target),\n        source: nodeMap.get(e.source).nodeId,\n        target: nodeMap.get(e.target).nodeId,\n        name: e.name,\n        desc: e.desc,\n        citation: e.citation,\n        active: true\n      }));\n\n      recalculateActiveNodes();\n    }\n\n    function recalculateActiveNodes() {\n      nodes.forEach(n => {\n        n.active = opts.levels[n.level] === true && !n.hiddenByUser;\n        n.degree = 0;\n        n.neighbors = [];\n      });\n\n      edges.forEach(e => {\n        const s = e.sourceNode;\n        const t = e.targetNode;\n        if (s && t && s.active && t.active) {\n          s.degree++; t.degree++;\n          s.neighbors.push(t);\n          t.neighbors.push(s);\n          e.active = true;\n        } else {\n          e.active = false;\n        }\n      });\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      const modal = document.getElementById('nodeInspector');\n\n      document.getElementById('mNodeTitle').innerText = node.label;\n      document.getElementById('mNodeCode').innerText = `Nivel Matrioshka ${node.level} • ID: ${node.id}`;\n      \n      const badgeEl = document.getElementById('mTriadBadge');\n      if (node.triadRole === 'sintoma') {\n        badgeEl.innerText = '🔴 SÍNTOMA VISIBLE';\n        badgeEl.className = 'triad-badge triad-sintoma';\n        document.getElementById('mTriadRole').innerText = 'Síntoma Visible';\n        document.getElementById('mTriadRole').style.color = palette.triadColors.sintoma;\n      } else if (node.triadRole === 'causa') {\n        badgeEl.innerText = '🟡 CAUSA ESTRUCTURAL';\n        badgeEl.className = 'triad-badge triad-causa';\n        document.getElementById('mTriadRole').innerText = 'Causa Estructural';\n        document.getElementById('mTriadRole').style.color = palette.triadColors.causa;\n      } else {\n        badgeEl.innerText = '🟧 EFECTO SISTÉMICO';\n        badgeEl.className = 'triad-badge triad-efecto';\n        document.getElementById('mTriadRole').innerText = 'Efecto Sistémico';\n        document.getElementById('mTriadRole').style.color = palette.triadColors.efecto;\n      }\n\n      document.getElementById('mLevel').innerText = `Nivel ${node.level}`;\n      document.getElementById('mFunction').innerText = node.function;\n      document.getElementById('mImpact').innerText = node.impact;\n      document.getElementById('mCitation').innerText = node.citation;\n\n      document.getElementById('mNeighborHeader').innerText = `Interconexiones Causales Directas (${node.degree})`;\n      const listEl = document.getElementById('mNeighborList');\n      listEl.innerHTML = '';\n\n      edges.forEach(e => {\n        if (e.sourceNode.id === node.id || e.targetNode.id === node.id) {\n          const nb = e.sourceNode.id === node.id ? e.targetNode : e.sourceNode;\n          const item = document.createElement('div');\n          item.className = 'neighbor-row';\n          item.innerHTML = `\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span><b>[${nb.id}]</b> ${nb.label}</span>\n              <span style=\"font-size:8.5px; color:#94a3b8;\">${e.name}</span>\n            </div>\n            <span style=\"color:${palette.levelColors[nb.level]}; font-size:9px; font-family:monospace;\">Nivel ${nb.level}</span>\n          `;\n          item.onclick = (evt) => {\n            evt.stopPropagation();\n            openInspector(nb);\n          };\n          listEl.appendChild(item);\n        }\n      });\n\n      modal.style.display = 'flex';\n      focusSelectedNode(node);\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function focusSelectedNode(node) {\n      const target = node || selectedNode;\n      if (!target) return;\n      targetPanX = -target.x * 0.85;\n      targetPanY = -target.y * 0.85;\n      targetZoom = 700;\n    }\n\n    function hideCurrentNode() {\n      if (selectedNode) {\n        selectedNode.hiddenByUser = true;\n        closeInspector();\n        recalculateActiveNodes();\n      }\n    }\n\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 650;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    function render() {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      rotX += (targetRotX - rotX) * 0.12;\n      rotY += (targetRotY - rotY) * 0.12;\n      zoom += (targetZoom - zoom) * 0.12;\n      panX += (targetPanX - panX) * 0.12;\n      panY += (targetPanY - panY) * 0.12;\n\n      ctx.fillStyle = palette.bg;\n      ctx.fillRect(0, 0, w, h);\n\n      if (opts.showSphere) {\n        const radius = 280;\n        const steps = 40;\n        ctx.lineWidth = 1;\n\n        for (let i = 1; i < 5; i++) {\n          const phi = (i / 5) * Math.PI;\n          const rLat = radius * Math.sin(phi);\n          const yLat = radius * Math.cos(phi);\n\n          ctx.strokeStyle = palette.sphere;\n          ctx.beginPath();\n          let first = true;\n          for (let j = 0; j <= steps; j++) {\n            const theta = (j / steps) * Math.PI * 2;\n            const px = rLat * Math.cos(theta);\n            const pz = rLat * Math.sin(theta);\n            const p = project(px, yLat, pz, w, h);\n            if (p.visible) {\n              if (first) { ctx.moveTo(p.x, p.y); first = false; }\n              else { ctx.lineTo(p.x, p.y); }\n            }\n          }\n          ctx.stroke();\n        }\n      }\n\n      // NO ANIMATION / STATIC STABLE NODES\n      nodes.forEach((n) => {\n        if (!n.active) return;\n        n.renderX = n.x;\n        n.renderY = n.y;\n        n.renderZ = n.z;\n        n.proj = project(n.renderX, n.renderY, n.renderZ, w, h);\n      });\n\n      if (opts.showEdges) {\n        edges.forEach(e => {\n          if (!e.active) return;\n          const s = e.sourceNode;\n          const t = e.targetNode;\n\n          if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n          const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n          const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n          ctx.save();\n          if (isHov || isSel) {\n            ctx.strokeStyle = '#E7C878';\n            ctx.lineWidth = 3.5;\n            ctx.shadowColor = '#E7C878';\n            ctx.shadowBlur = 10;\n          } else {\n            ctx.strokeStyle = palette.edge;\n            ctx.lineWidth = 1.6;\n            ctx.shadowBlur = 0;\n          }\n\n          ctx.beginPath();\n          ctx.moveTo(s.proj.x, s.proj.y);\n          ctx.lineTo(t.proj.x, t.proj.y);\n          ctx.stroke();\n\n          // Flow Edge ID\n          const mx = (s.proj.x + t.proj.x) / 2;\n          const my = (s.proj.y + t.proj.y) / 2;\n          ctx.font = '8.5px monospace';\n          ctx.fillStyle = isHov || isSel ? '#E7C878' : '#64748b';\n          ctx.fillText(e.id, mx - 8, my - 4);\n\n          ctx.restore();\n        });\n      }\n\n      const sorted = [...nodes].filter(n => n.active && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n\n      // RENDER RECTANGULAR CARD NODES WITH FULL TEXT INSIDE (NO ANIMATIONS / NO CIRCLES)\n      sorted.forEach(n => {\n        if (!n.proj.visible) return;\n\n        const px = Math.round(n.proj.x);\n        const py = Math.round(n.proj.y);\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n\n        const scale = n.proj.scale || 1.0;\n        const boxW = Math.max(160, Math.round(210 * scale));\n        const boxH = Math.max(48, Math.round(58 * scale));\n        const xPos = px - boxW / 2;\n        const yPos = py - boxH / 2;\n\n        const levelColor = palette.levelColors[n.level] || '#E7C878';\n        const triadBorder = n.triadRole === 'sintoma' ? '#E69888' : (n.triadRole === 'causa' ? '#E7C878' : '#C96349');\n        const triadTag = n.triadRole === 'sintoma' ? '🔴 SÍNTOMA' : (n.triadRole === 'causa' ? '🟡 CAUSA' : '🟧 EFECTO');\n\n        ctx.save();\n        \n        // Rectangular Container Fill\n        ctx.fillStyle = (isHov || isSel) ? '#0f172a' : '#06090f';\n        ctx.beginPath();\n        ctx.roundRect(xPos, yPos, boxW, boxH, 6);\n        ctx.fill();\n\n        // Border Stroke\n        ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : triadBorder;\n        ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.8;\n        ctx.stroke();\n\n        // Left Level Strip\n        ctx.fillStyle = levelColor;\n        ctx.fillRect(xPos, yPos, 5, boxH);\n\n        // Header Text: ID + Triad Tag\n        ctx.font = 'bold 9px ui-monospace, monospace';\n        ctx.fillStyle = triadBorder;\n        ctx.textAlign = 'left';\n        ctx.fillText(`[${n.id}] ${triadTag} (N${n.level})`, xPos + 10, yPos + 14);\n\n        // Body Text Inside Node Box (Short Label)\n        ctx.font = 'bold 10px -apple-system, BlinkMacSystemFont, sans-serif';\n        ctx.fillStyle = '#f8fafc';\n        \n        // Wrap text if needed inside node\n        const maxTextW = boxW - 16;\n        const words = n.shortLabel.split(' ');\n        let line = '';\n        let lineY = yPos + 28;\n\n        for (let nIdx = 0; nIdx < words.length; nIdx++) {\n          const testLine = line + words[nIdx] + ' ';\n          const metrics = ctx.measureText(testLine);\n          if (metrics.width > maxTextW && nIdx > 0) {\n            ctx.fillText(line, xPos + 10, lineY);\n            line = words[nIdx] + ' ';\n            lineY += 13;\n          } else {\n            line = testLine;\n          }\n        }\n        ctx.fillText(line, xPos + 10, lineY);\n\n        ctx.restore();\n      });\n\n      requestAnimationFrame(render);\n    }\n\n    // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n    let subCanvasAnim = null;\n    function openSubNetworkModal() {\n      const subModal = document.getElementById('subnetworkModal');\n      document.getElementById('subModalTitle').innerText = `Red Causal Interconectada Completa Matrioshka`;\n      document.getElementById('subModalCode').innerText = `[System Dynamics Mesh]`;\n      subModal.style.display = 'flex';\n      renderSubNetworkCanvas();\n    }\n\n    function closeSubNetworkModal() {\n      document.getElementById('subnetworkModal').style.display = 'none';\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n    }\n\n    function renderSubNetworkCanvas() {\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      function loopSub() {\n        sctx.fillStyle = '#000000';\n        sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n\n        // Draw All Edges in 2D Mesh\n        edges.forEach(e => {\n          const s = e.sourceNode;\n          const t = e.targetNode;\n          if (!s || !t || !s.active || !t.active) return;\n\n          const sAngle = (s.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n          const tAngle = (t.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n          const sRad = 130 + (s.level * 55);\n          const tRad = 130 + (t.level * 55);\n\n          const sx = cx + Math.cos(sAngle) * sRad;\n          const sy = cy + Math.sin(sAngle) * sRad;\n          const tx = cx + Math.cos(tAngle) * tRad;\n          const ty = cy + Math.sin(tAngle) * tRad;\n\n          sctx.save();\n          sctx.beginPath();\n          sctx.moveTo(sx, sy);\n          sctx.lineTo(tx, ty);\n          sctx.strokeStyle = palette.levelColors[s.level];\n          sctx.lineWidth = 1.5;\n          sctx.globalAlpha = 0.6;\n          sctx.stroke();\n          sctx.restore();\n        });\n\n        // Draw All Nodes in Concentric 2D Ring Mesh\n        nodes.forEach(n => {\n          if (!n.active) return;\n          const angle = (n.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n          const radDist = 130 + (n.level * 55);\n          const nx = cx + Math.cos(angle) * radDist;\n          const ny = cy + Math.sin(angle) * radDist;\n\n          const triadBorder = n.triadRole === 'sintoma' ? '#E69888' : (n.triadRole === 'causa' ? '#E7C878' : '#C96349');\n          const triadTag = n.triadRole === 'sintoma' ? '🔴 SÍNTOMA' : (n.triadRole === 'causa' ? '🟡 CAUSA' : '🟧 EFECTO');\n\n          sctx.save();\n          sctx.fillStyle = '#06090f';\n          sctx.beginPath();\n          sctx.roundRect(nx - 75, ny - 20, 150, 40, 5);\n          sctx.fill();\n          sctx.strokeStyle = triadBorder;\n          sctx.lineWidth = 1.8;\n          sctx.stroke();\n\n          sctx.font = 'bold 8.5px monospace';\n          sctx.fillStyle = triadBorder;\n          sctx.textAlign = 'center';\n          sctx.fillText(`[${n.id}] ${triadTag}`, nx, ny - 6);\n\n          sctx.font = '9px sans-serif';\n          sctx.fillStyle = '#ffffff';\n          sctx.fillText(n.shortLabel.substring(0, 22), nx, ny + 10);\n\n          sctx.restore();\n        });\n\n        subCanvasAnim = requestAnimationFrame(loopSub);\n      }\n\n      loopSub();\n    }\n\n    // Mouse Controls (NO ANIMATIONS / STATIC ROTATION ONLY ON DRAG)\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true;\n      mouseBtn = e.button;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('dblclick', () => {\n      if (hoveredNode) {\n        hoveredNode.hiddenByUser = true;\n        closeInspector();\n        recalculateActiveNodes();\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX;\n        const dy = e.clientY - lastY;\n        if (mouseBtn === 0) {\n          targetRotY += dx * 0.004;\n          targetRotX += dy * 0.004;\n        } else if (mouseBtn === 2) {\n          targetPanX += dx; targetPanY += dy;\n        }\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const mx = e.clientX, my = e.clientY;\n        let closest = null, minDist = 40;\n        nodes.forEach(n => {\n          if (!n.active || !n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    // Init\n    buildTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>","Description":"Convert Matrioshka Network to Static Premium Causal Mesh with full text inside rectangular nodes and all-to-all cross-level interconnections","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\red_congestion_matrioshka.html","toolAction":"Converting to Static Premium Causal Network with rectangular text nodes and total interconnections","toolSummary":"Update red_congestion_matrioshka.html to static causal mesh"}}]}
