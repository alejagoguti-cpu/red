ggleLevel(2)\">\n485:       <div class=\"level-label-wrap\">\n486:         <div class=\"level-badge\" style=\"--level-color:#E69888;\">N2</div>\n487:         <div style=\"flex:1;\">\n488:           <div style=\"font-weight:700; color:#f8fafc;\">Eje Logístico Inter-Local</div>\n489:           <div style=\"font-size:9px; color:#94a3b8;\"><b>Síntoma:</b> Fricción Carga-SITP | <b>Causa:</b> Sin Corredor Segregado | <b>Efecto:</b> Parálisis Interlocal</div>\n490:         </div>\n491:         <div class=\"toggle-box checked\" id=\"toggleLevel2\"></div>\n492:       </div>\n493:     </div>\n494: \n495:     <!-- Nivel 3 -->\n496:     <div class=\"level-card\" style=\"--level-color:#E7C878;\" onclick=\"toggleLevel(3)\">\n497:       <div class=\"level-label-wrap\">\n498:         <div class=\"level-badge\" style=\"--level-color:#E7C878;\">N3</div>\n499:         <div style=\"flex:1;\">\n500:           <div style=\"font-weight:700; color:#f8fafc;\">Arterias Urbanas Distritales</div>\n501:           <div style=\"font-size:9.5px; color:#94a3b8;\"><b>Síntoma:</b> Spillback 3km | <b>Causa:</b> Mezcla de Modos | <b>Efecto:</b> Parálisis Kennedy</div>\n502:         </div>\n503:         <div class=\"toggle-box checked\" id=\"toggleLevel3\"></div>\n504:       </div>\n505:     </div>\n506: \n507:     <!-- Nivel 4 -->\n508:     <div class=\"level-card\" style=\"--level-color:#84A48B;\" onclick=\"toggleLevel(4)\">\n509:       <div class=\"level-label-wrap\">\n510:         <div class=\"level-badge\" style=\"--level-color:#84A48B;\">N4</div>\n511:         <div style=\"flex:1;\">\n512:           <div style=\"font-weight:700; color:#f8fafc;\">Núcleo Hiperlocal Corabastos</div>\n513:           <div style=\"font-size:9.5px; color:#94a3b8;\"><b>Síntoma:</b> V &lt; 5 km/h | <b>Causa:</b> Básculas Lentas | <b>Efecto:</b> Invasión Informal</div>\n514:         </div>\n515:         <div class=\"toggle-box checked\" id=\"toggleLevel4\"></div>\n516:       </div>\n517:     </div>\n518: \n519:     <!-- Convenciones Tríada -->\n520:     <div style=\"margin-top:10px; padding-top:10px; border-top:1px solid rgba(255,255,255,0.08);\">\n521:       <div style=\"font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; color:#64748b; margin-bottom:6px;\">\n522:         Convención Tríada Diagnóstica:\n523:       </div>\n524:       <div style=\"display:flex; flex-direction:column; gap:4px; font-size:9.5px; color:#cbd5e1;\">\n525:         <div>🔴 <b>SÍNTOMA VISIBLE:</b> Manifestación directa o problema observable de congestión.</div>\n526:         <div>🟡 <b>CAUSA ESTRUCTURAL:</b> Falla normativa, física u operativa de origen.</div>\n527:         <div>🟧 <b>EFECTO SISTÉMICO:</b> Impacto territorial o de propagación sobre el sistema.</div>\n528:       </div>\n529:     </div>\n530:   </div>\n531: \n532:   <!-- Pop-Up Node Inspector Modal -->\n533:   <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n534:     <div class=\"inspector-header\">\n535:       <div>\n536:         <div class=\"node-title\" id=\"mNodeTitle\">Demoras en Básculas y Pesaje</div>\n537:         <div class=\"node-subtitle\" id=\"mNodeCode\">Nivel 4 (Núcleo) • ID: S4-CAUSA</div>\n538:         <div id=\"mTriadBadge\" class=\"triad-badge triad-causa\">🟡 CAUSA ESTRUCTURAL</div>\n539:       </div>\n540:       <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n541:     </div>\n542: \n543:     <div class=\"data-grid\">\n544:       <div class=\"metric-card\">\n545:         <div class=\"metric-lbl\">Clasificación Tríada</div>\n546:         <div class=\"metric-val\" id=\"mTriadRole\" style=\"color:#E7C878;\">Causa Estructural</div>\n547:       </div>\n548:       <div class=\"metric-card\">\n549:         <div class=\"metric-lbl\">Nivel Matrioshka</div>\n550:         <div class=\"metric-val\" id=\"mLevel\">Nivel 4 (Núcleo)</div>\n551:       </div>\n552:     </div>\n553: \n554:     <div class=\"sec-header\">Descripción Detallada del Nodo</div>\n555:     <div class=\"text-content\" id=\"mFunction\">Inspección lenta y capacidad insuficiente en básculas de puertas 6, 7 y 8.</div>\n556: \n557:     <div class=\"sec-header\">Mecanismo de Fricción & Impacto</div>\n558:     <div class=\"text-content alert\" id=\"mImpact\">Origina el fenómeno de Spillback hacia la red vial distrital exterior.</div>\n559: \n560:     <div class=\"sec-header\">📜 Cita Técnica Oficial Obligatoria</div>\n561:     <div class=\"citation-box\" id=\"mCitation\">SDM & POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.</div>\n562: \n563:     <div class=\"sec-header\" id=\"mNeighborHeader\">Interconexiones Causales Directas e Indirectas</div>\n564:     <div class=\"neighbor-scroll\" id=\"mNeighborList\"></div>\n565: \n566:     <div style=\"display:flex; flex-direction:column; gap:6px; margin-top:6px;\">\n567:       <button class=\"btn-flat\" style=\"justify-content:center; background:rgba(231,200,120,0.15); border-color:#E7C878; color:#ffffff; font-weight:700;\" onclick=\"openSubNetworkModal()\">\n568:         🌐 Ver Red Causal Interconectada Completa\n569:       </button>\n570: \n571:       <div style=\"display:flex; gap:6px;\">\n572:         <button class=\"btn-flat\" style=\"flex:1; justify-content:center;\" onclick=\"focusSelectedNode()\">Centrar Cámara</button>\n573:         <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,0,85,0.2); border-color:#ff0055; color:#ffffff;\" onclick=\"hideCurrentNode()\">Ocultar Nodo</button>\n574:         <button class=\"btn-flat\" style=\"flex:1; justify-content:center; background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.2); color:#cbd5e1;\" onclick=\"closeInspector()\">Cerrar</button>\n575:       </div>\n576:     </div>\n577:   </div>\n578: \n579:   <!-- Sub-Network 2D Graph Interactive Modal Popup -->\n580:   <div class=\"subnetwork-modal\" id=\"subnetworkModal\" style=\"display:none;\">\n581:     <div class=\"subnetwork-card\">\n582:       <div class=\"subnetwork-header\">\n583:         <div style=\"display:flex; align-items:center; gap:8px;\">\n584:           <span style=\"font-weight:800; font-size:13px; color:#E7C878;\" id=\"subModalTitle\">Red Causal Interconectada Completa</span>\n585:           <span style=\"font-size:10px; color:#94a3b8; font-family:monospace;\" id=\"subModalCode\">[Matrioshka Multi-Nivel]</span>\n586:         </div>\n587:         <div class=\"btn-close\" onclick=\"closeSubNetworkModal()\">×</div>\n588:       </div>\n589:       <div class=\"subnetwork-canvas-wrap\">\n590:         <canvas id=\"subCanvas\"></canvas>\n591:       </div>\n592: 