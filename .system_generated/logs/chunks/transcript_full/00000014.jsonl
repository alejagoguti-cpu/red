{"step_index":374,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-04T23:49:45Z","content":"Created At: 2026-10-04T18:49:45-05:00\nCompleted At: 2026-10-04T18:49:45-05:00\nFile Path: `file:///C:/Users/aleja/.gemini/antigravity/brain/d3de736b-bad3-4cd4-b3f7-8b59f3dfee52/hyperbolic_3d_network.html`\nTotal Lines: 1941\nTotal Bytes: 89084\nShowing lines 1460 to 1650\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1460:     // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n1461:     let subCanvasAnim = null;\n1462:     const subOpts = {\n1463:       cats: { 0: true, 1: true, 2: true, 3: true }\n1464:     };\n1465: \n1466:     function toggleSubCat(catId) {\n1467:       subOpts.cats[catId] = !subOpts.cats[catId];\n1468:       const btn = document.getElementById(`subToggle${catId}`);\n1469:       if (btn) btn.classList.toggle('active', subOpts.cats[catId]);\n1470:       renderSubNetworkCanvas();\n1471:     }\n1472: \n1473:     function openSubNetworkModal() {\n1474:       if (!selectedNode) return;\n1475:       const subModal = document.getElementById('subnetworkModal');\n1476:       document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n1477:       document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n1478:       subModal.style.display = 'flex';\n1479:       renderSubNetworkCanvas();\n1480:     }\n1481: \n1482:     function closeSubNetworkModal() {\n1483:       document.getElementById('subnetworkModal').style.display = 'none';\n1484:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1485:     }\n1486: \n1487:     function renderSubNetworkCanvas() {\n1488:       const subCanvas = document.getElementById('subCanvas');\n1489:       const wrap = subCanvas.parentElement;\n1490:       subCanvas.width = wrap.clientWidth;\n1491:       subCanvas.height = wrap.clientHeight;\n1492:       const sctx = subCanvas.getContext('2d');\n1493: \n1494:       const centerNode = selectedNode;\n1495:       // Filter neighbors based on sub-network active layer toggles\n1496:       const neighbors = (centerNode.neighbors || []).filter(nb => subOpts.cats[nb.cat] !== false);\n1497: \n1498:       // Organic 2D Mesh Network layout (No linear axis, no cross alignments)\n1499:       const cx = subCanvas.width / 2;\n1500:       const cy = subCanvas.height / 2;\n1501: \n1502:       // Dynamic degree calculation for the active sub-network view\n1503:       const activeSubDegree = neighbors.length;\n1504:       const centerTargetSize = Math.min(32, Math.max(18, 14 + Math.sqrt(activeSubDegree) * 2.8));\n1505: \n1506:       const subNodes = [\n1507:         { ...centerNode, sx: cx, sy: cy, isCenter: true, targetSize: centerTargetSize, activeDegree: activeSubDegree }\n1508:       ];\n1509: \n1510:       const totalNb = neighbors.length;\n1511:       neighbors.forEach((nb, idx) => {\n1512:         // Golden Ratio organic spiral distribution to prevent any 4-way cross or linear patterns\n1513:         const angle = idx * 2.39996 + 0.4; // Golden angle offset\n1514:         const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalNb));\n1515:         const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n1516:         \n1517:         const nx = cx + Math.cos(angle) * subRadius;\n1518:         const ny = cy + Math.sin(angle) * subRadius * 0.85; // Slight organic ellipse\n1519:         \n1520:         // Recalculate neighbor active sub-degree considering layer toggles\n1521:         const nbActiveDegree = (nb.neighbors || []).filter(nnb => subOpts.cats[nnb.cat] !== false).length;\n1522:         const nbTargetSize = Math.min(24, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 1.8));\n1523: \n1524:         subNodes.push({ ...nb, sx: nx, sy: ny, isCenter: false, angle, targetSize: nbTargetSize, activeDegree: nbActiveDegree });\n1525:       });\n1526: \n1527:       const interactionTypes = [\n1528:         { name: 'Depredación', color: '#ff0033' },\n1529:         { name: 'Herbivoría', color: '#00ff88' },\n1530:         { name: 'Dispersión', color: '#ff80a0' },\n1531:         { name: 'Mutualismo', color: '#ffee33' },\n1532:         { name: 'Nidificación', color: '#ffaa00' },\n1533:         { name: 'Visita Floral', color: '#d000ff' },\n1534:         { name: 'Anidamiento', color: '#a0522d' },\n1535:         { name: 'Parasitismo', color: '#ffff00' },\n1536:         { name: 'Alelopatía', color: '#888888' }\n1537:       ];\n1538: \n1539:       function drawSub() {\n1540:         sctx.fillStyle = '#020408';\n1541:         sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n1542: \n1543:         // Draw Sub-Network Edges with specific interaction colors\n1544:         neighbors.forEach((nb, idx) => {\n1545:           const targetSub = subNodes[idx + 1];\n1546: \n1547:           let inter = interactionTypes[0];\n1548:           if (centerNode.cat === 0 && nb.cat === 1) inter = interactionTypes[5];\n1549:           else if (centerNode.cat === 1 && nb.cat === 0) inter = interactionTypes[2];\n1550:           else if (centerNode.cat === 1 && nb.cat === 3) inter = interactionTypes[0];\n1551:           else if (centerNode.cat === 3 && nb.cat === 0) inter = interactionTypes[1];\n1552:           else if (centerNode.cat === 0 && nb.cat === 0) inter = interactionTypes[8];\n1553:           else if (centerNode.cat === 2) inter = interactionTypes[3];\n1554:           else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n1555: \n1556:           // Draw Glowing Edge\n1557:           sctx.save();\n1558:           sctx.beginPath();\n1559:           sctx.moveTo(cx, cy);\n1560:           sctx.lineTo(targetSub.sx, targetSub.sy);\n1561:           sctx.strokeStyle = inter.color;\n1562:           sctx.lineWidth = 2.5;\n1563:           sctx.shadowColor = inter.color;\n1564:           sctx.shadowBlur = 8;\n1565:           sctx.stroke();\n1566:           sctx.restore();\n1567: \n1568:           // Edge Label (Type)\n1569:           const mx = (cx + targetSub.sx) / 2;\n1570:           const my = (cy + targetSub.sy) / 2;\n1571:           sctx.save();\n1572:           sctx.font = '9px ui-monospace, monospace';\n1573:           sctx.fillStyle = '#ffffff';\n1574:           sctx.shadowColor = '#000000';\n1575:           sctx.shadowBlur = 4;\n1576:           sctx.fillText(inter.name, mx - 15, my - 4);\n1577:           sctx.restore();\n1578:         });\n1579: \n1580:         // Draw Sub-Network Nodes\n1581:         subNodes.forEach(sn => {\n1582:           const r = sn.targetSize;\n1583: \n1584:           sctx.save();\n1585:           sctx.beginPath();\n1586:           sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\n1587:           sctx.clip();\n1588: \n1589:           if (sn.imgObj && sn.imgObj.complete && sn.imgObj.naturalWidth !== 0) {\n1590:             sctx.drawImage(sn.imgObj, sn.sx - r, sn.sy - r, r * 2, r * 2);\n1591:           } else {\n1592:             sctx.fillStyle = palette.catColors[sn.cat] || '#00ffff';\n1593:             sctx.fillRect(sn.sx - r, sn.sy - r, r * 2, r * 2);\n1594:           }\n1595:           sctx.restore();\n1596: \n1597:           // Border Ring\n1598:           sctx.save();\n1599:           sctx.beginPath();\n1600:           sctx.arc(sn.sx, sn.sy, r + 1, 0, Math.PI * 2);\n1601:           sctx.strokeStyle = sn.isCenter ? '#00ffff' : palette.catColors[sn.cat];\n1602:           sctx.lineWidth = sn.isCenter ? 3.5 : 2;\n1603:           if (sn.isCenter) {\n1604:             sctx.shadowColor = '#00ffff';\n1605:             sctx.shadowBlur = 12;\n1606:           }\n1607:           sctx.stroke();\n1608:           sctx.restore();\n1609: \n1610:           // Node Text Label\n1611:           sctx.save();\n1612:           sctx.font = sn.isCenter ? '11px monospace' : '9.5px monospace';\n1613:           sctx.fillStyle = '#ffffff';\n1614:           sctx.shadowColor = '#000000';\n1615:           sctx.shadowBlur = 4;\n1616:           sctx.fillText(`${sn.label} [${sn.taxaId}] (k=${sn.activeDegree})`, sn.sx + r + 6, sn.sy + 4);\n1617:           sctx.restore();\n1618:         });\n1619:       }\n1620: \n1621:       drawSub();\n1622: \n1623:       // Click event inside Sub-Network canvas to switch focus to neighbor\n1624:       subCanvas.onclick = (e) => {\n1625:         const rect = subCanvas.getBoundingClientRect();\n1626:         const mx = e.clientX - rect.left;\n1627:         const my = e.clientY - rect.top;\n1628: \n1629:         subNodes.forEach(sn => {\n1630:           const r = sn.isCenter ? 26 : 20;\n1631:           if (Math.hypot(sn.sx - mx, sn.sy - my) < r) {\n1632:             if (!sn.isCenter) {\n1633:               closeSubNetworkModal();\n1634:               openInspector(nodes[sn.id]);\n1635:             }\n1636:           }\n1637:         });\n1638:       };\n1639:     }\n1640: \n1641:     function closeInspector() {\n1642:       selectedNode = null;\n1643:       document.getElementById('nodeInspector').style.display = 'none';\n1644:       targetZoom = 420;\n1645:       targetPanX = 0;\n1646:       targetPanY = 0;\n1647:     }\n1648: \n1649:     function focusSelectedNode(node) {\n1650:       const target = node || selectedNode;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":375,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-04T23:49:45Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Add organic dynamic motion (pulsing/floating position drift) to sub-network canvas nodes.","EndLine":1635,"Instruction":"Update renderSubNetworkCanvas to run a continuous requestAnimationFrame loop where sub-network nodes organically drift/pulse position over time instead of remaining static.","ReplacementContent":"    let subAnimTime = 0;\n    function renderSubNetworkCanvas() {\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const centerNode = selectedNode;\n      if (!centerNode) return;\n\n      // Filter neighbors based on sub-network active layer toggles\n      const neighbors = (centerNode.neighbors || []).filter(nb => subOpts.cats[nb.cat] !== false);\n\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      // Dynamic degree calculation for the active sub-network view\n      const activeSubDegree = neighbors.length;\n      const centerTargetSize = Math.min(32, Math.max(18, 14 + Math.sqrt(activeSubDegree) * 2.8));\n\n      const subNodes = [\n        { ...centerNode, baseSx: cx, baseSy: cy, sx: cx, sy: cy, isCenter: true, targetSize: centerTargetSize, activeDegree: activeSubDegree }\n      ];\n\n      const totalNb = neighbors.length;\n      neighbors.forEach((nb, idx) => {\n        const angle = idx * 2.39996 + 0.4; // Golden angle offset\n        const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalNb));\n        const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n        \n        const nx = cx + Math.cos(angle) * subRadius;\n        const ny = cy + Math.sin(angle) * subRadius * 0.85;\n        \n        const nbActiveDegree = (nb.neighbors || []).filter(nnb => subOpts.cats[nnb.cat] !== false).length;\n        const nbTargetSize = Math.min(24, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 1.8));\n\n        subNodes.push({ ...nb, baseSx: nx, baseSy: ny, sx: nx, sy: ny, isCenter: false, angle, targetSize: nbTargetSize, activeDegree: nbActiveDegree, phase: idx * 0.7 });\n      });\n\n      const interactionTypes = [\n        { name: 'Depredación', color: '#ff0033' },\n        { name: 'Herbivoría', color: '#00ff88' },\n        { name: 'Dispersión', color: '#ff80a0' },\n        { name: 'Mutualismo', color: '#ffee33' },\n        { name: 'Nidificación', color: '#ffaa00' },\n        { name: 'Visita Floral', color: '#d000ff' },\n        { name: 'Anidamiento', color: '#a0522d' },\n        { name: 'Parasitismo', color: '#ffff00' },\n        { name: 'Alelopatía', color: '#888888' }\n      ];\n\n      function loopSub() {\n        subAnimTime += 0.025;\n        sctx.fillStyle = '#020408';\n        sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n\n        // Update organic position drift (dynamic motion)\n        subNodes.forEach(sn => {\n          if (sn.isCenter) {\n            sn.sx = sn.baseSx + Math.sin(subAnimTime * 1.2) * 3;\n            sn.sy = sn.baseSy + Math.cos(subAnimTime * 1.0) * 3;\n          } else {\n            const waveX = Math.sin(subAnimTime * 1.5 + sn.phase) * 7;\n            const waveY = Math.cos(subAnimTime * 1.3 + sn.phase) * 7;\n            sn.sx = sn.baseSx + waveX;\n            sn.sy = sn.baseSy + waveY;\n          }\n        });\n\n        // Draw Sub-Network Edges with specific interaction colors\n        neighbors.forEach((nb, idx) => {\n          const targetSub = subNodes[idx + 1];\n          const centerSub = subNodes[0];\n\n          let inter = interactionTypes[0];\n          if (centerNode.cat === 0 && nb.cat === 1) inter = interactionTypes[5];\n          else if (centerNode.cat === 1 && nb.cat === 0) inter = interactionTypes[2];\n          else if (centerNode.cat === 1 && nb.cat === 3) inter = interactionTypes[0];\n          else if (centerNode.cat === 3 && nb.cat === 0) inter = interactionTypes[1];\n          else if (centerNode.cat === 0 && nb.cat === 0) inter = interactionTypes[8];\n          else if (centerNode.cat === 2) inter = interactionTypes[3];\n          else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n\n          // Draw Glowing Dynamic Edge\n          sctx.save();\n          sctx.beginPath();\n          sctx.moveTo(centerSub.sx, centerSub.sy);\n          sctx.lineTo(targetSub.sx, targetSub.sy);\n          sctx.strokeStyle = inter.color;\n          sctx.lineWidth = 2.5;\n          sctx.shadowColor = inter.color;\n          sctx.shadowBlur = 8;\n          sctx.stroke();\n          sctx.restore();\n\n          // Edge Label (Type)\n          const mx = (centerSub.sx + targetSub.sx) / 2;\n          const my = (centerSub.sy + targetSub.sy) / 2;\n          sctx.save();\n          sctx.font = '9px ui-monospace, monospace';\n          sctx.fillStyle = '#ffffff';\n          sctx.shadowColor = '#000000';\n          sctx.shadowBlur = 4;\n          sctx.fillText(inter.name, mx - 15, my - 4);\n          sctx.restore();\n        });\n\n        // Draw Sub-Network Nodes\n        subNodes.forEach(sn => {\n          const r = sn.targetSize;\n\n          sctx.save();\n          sctx.beginPath();\n          sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\n          sctx.clip();\n\n          if (sn.imgObj && sn.imgObj.complete && sn.imgObj.naturalWidth !== 0) {\n            sctx.drawImage(sn.imgObj, sn.sx - r, sn.sy - r, r * 2, r * 2);\n          } else {\n            sctx.fillStyle = palette.catColors[sn.cat] || '#00ffff';\n            sctx.fillRect(sn.sx - r, sn.sy - r, r * 2, r * 2);\n          }\n          sctx.restore();\n\n          // Border Ring\n          sctx.save();\n          sctx.beginPath();\n          sctx.arc(sn.sx, sn.sy, r + 1, 0, Math.PI * 2);\n          sctx.strokeStyle = sn.isCenter ? '#00ffff' : palette.catColors[sn.cat];\n          sctx.lineWidth = sn.isCenter ? 3.5 : 2;\n          if (sn.isCenter) {\n            sctx.shadowColor = '#00ffff';\n            sctx.shadowBlur = 12;\n          }\n          sctx.stroke();\n          sctx.restore();\n\n          // Node Text Label\n          sctx.save();\n          sctx.font = sn.isCenter ? '11px monospace' : '9.5px monospace';\n          sctx.fillStyle = '#ffffff';\n          sctx.shadowColor = '#000000';\n          sctx.shadowBlur = 4;\n          sctx.fillText(`${sn.label} [${sn.taxaId}] (k=${sn.activeDegree})`, sn.sx + r + 6, sn.sy + 4);\n          sctx.restore();\n        });\n\n        subCanvasAnim = requestAnimationFrame(loopSub);\n      }\n\n      loopSub();\n\n      // Click event inside Sub-Network canvas to switch focus to neighbor\n      subCanvas.onclick = (e) => {\n        const rect = subCanvas.getBoundingClientRect();\n        const mx = e.clientX - rect.left;\n        const my = e.clientY - rect.top;\n\n        subNodes.forEach(sn => {\n          const r = sn.targetSize || 20;\n          if (Math.hypot(sn.sx - mx, sn.sy - my) < r) {\n            if (!sn.isCenter) {\n              closeSubNetworkModal();\n              openInspector(nodes[sn.id]);\n            }\n          }\n        });\n      };\n    }","StartLine":1487,"TargetContent":"    function renderSubNetworkCanvas() {\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const centerNode = selectedNode;\n      // Filter neighbors based on sub-network active layer toggles\n      const neighbors = (centerNode.neighbors || []).filter(nb => subOpts.cats[nb.cat] !== false);\n\n      // Organic 2D Mesh Network layout (No linear axis, no cross alignments)\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      // Dynamic degree calculation for the active sub-network view\n      const activeSubDegree = neighbors.length;\n      const centerTargetSize = Math.min(32, Math.max(18, 14 + Math.sqrt(activeSubDegree) * 2.8));\n\n      const subNodes = [\n        { ...centerNode, sx: cx, sy: cy, isCenter: true, targetSize: centerTargetSize, activeDegree: activeSubDegree }\n      ];\n\n      const totalNb = neighbors.length;\n      neighbors.forEach((nb, idx) => {\n        // Golden Ratio organic spiral distribution to prevent any 4-way cross or linear patterns\n        const angle = idx * 2.39996 + 0.4; // Golden angle offset\n        const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalNb));\n        const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n        \n        const nx = cx + Math.cos(angle) * subRadius;\n        const ny = cy + Math.sin(angle) * subRadius * 0.85; // Slight organic ellipse\n        \n        // Recalculate neighbor active sub-degree considering layer toggles\n        const nbActiveDegree = (nb.neighbors || []).filter(nnb => subOpts.cats[nnb.cat] !== false).length;\n        const nbTargetSize = Math.min(24, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 1.8));\n\n        subNodes.push({ ...nb, sx: nx, sy: ny, isCenter: false, angle, targetSize: nbTargetSize, activeDegree: nbActiveDegree });\n      });\n\n      const interactionTypes = [\n        { name: 'Depredación', color: '#ff0033' },\n        { name: 'Herbivoría', color: '#00ff88' },\n        { name: 'Dispersión', color: '#ff80a0' },\n        { name: 'Mutualismo', color: '#ffee33' },\n        { name: 'Nidificación', color: '#ffaa00' },\n        { name: 'Visita Floral', color: '#d000ff' },\n        { name: 'Anidamiento', color: '#a0522d' },\n        { name: 'Parasitismo', color: '#ffff00' },\n        { name: 'Alelopatía', color: '#888888' }\n      ];\n\n      function drawSub() {\n        sctx.fillStyle = '#020408';\n        sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n\n        // Draw Sub-Network Edges with specific interaction colors\n        neighbors.forEach((nb, idx) => {\n          const targetSub = subNodes[idx + 1];\n\n          let inter = interactionTypes[0];\n          if (centerNode.cat === 0 && nb.cat === 1) inter = interactionTypes[5];\n          else if (centerNode.cat === 1 && nb.cat === 0) inter = interactionTypes[2];\n          else if (centerNode.cat === 1 && nb.cat === 3) inter = interactionTypes[0];\n          else if (centerNode.cat === 3 && nb.cat === 0) inter = interactionTypes[1];\n          else if (centerNode.cat === 0 && nb.cat === 0) inter = interactionTypes[8];\n          else if (centerNode.cat === 2) inter = interactionTypes[3];\n          else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n\n          // Draw Glowing Edge\n          sctx.save();\n          sctx.beginPath();\n          sctx.moveTo(cx, cy);\n          sctx.lineTo(targetSub.sx, targetSub.sy);\n          sctx.strokeStyle = inter.color;\n          sctx.lineWidth = 2.5;\n          sctx.shadowColor = inter.color;\n          sctx.shadowBlur = 8;\n          sctx.stroke();\n          sctx.restore();\n\n          // Edge Label (Type)\n          const mx = (cx + targetSub.sx) / 2;\n          const my = (cy + targetSub.sy) / 2;\n          sctx.save();\n          sctx.font = '9px ui-monospace, monospace';\n          sctx.fillStyle = '#ffffff';\n          sctx.shadowColor = '#000000';\n          sctx.shadowBlur = 4;\n          sctx.fillText(inter.name, mx - 15, my - 4);\n          sctx.restore();\n        });\n\n        // Draw Sub-Network Nodes\n        subNodes.forEach(sn => {\n          const r = sn.targetSize;\n\n          sctx.save();\n          sctx.beginPath();\n          sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\n          sctx.clip();\n\n          if (sn.imgObj && sn.imgObj.complete && sn.imgObj.naturalWidth !== 0) {\n            sctx.drawImage(sn.imgObj, sn.sx - r, sn.sy - r, r * 2, r * 2);\n          } else {\n            sctx.fillStyle = palette.catColors[sn.cat] || '#00ffff';\n            sctx.fillRect(sn.sx - r, sn.sy - r, r * 2, r * 2);\n          }\n          sctx.restore();\n\n          // Border Ring\n          sctx.save();\n          sctx.beginPath();\n          sctx.arc(sn.sx, sn.sy, r + 1, 0, Math.PI * 2);\n          sctx.strokeStyle = sn.isCenter ? '#00ffff' : palette.catColors[sn.cat];\n          sctx.lineWidth = sn.isCenter ? 3.5 : 2;\n          if (sn.isCenter) {\n            sctx.shadowColor = '#00ffff';\n            sctx.shadowBlur = 12;\n          }\n          sctx.stroke();\n          sctx.restore();\n\n          // Node Text Label\n          sctx.save();\n          sctx.font = sn.isCenter ? '11px monospace' : '9.5px monospace';\n          sctx.fillStyle = '#ffffff';\n          sctx.shadowColor = '#000000';\n          sctx.shadowBlur = 4;\n          sctx.fillText(`${sn.label} [${sn.taxaId}] (k=${sn.activeDegree})`, sn.sx + r + 6, sn.sy + 4);\n          sctx.restore();\n        });\n      }\n\n      drawSub();\n\n      // Click event inside Sub-Network canvas to switch focus to neighbor\n      subCanvas.onclick = (e) => {\n        const rect = subCanvas.getBoundingClientRect();\n        const mx = e.clientX - rect.left;\n        const my = e.clientY - rect.top;\n\n        subNodes.forEach(sn => {\n          const r = sn.isCenter ? 26 : 20;\n          if (Math.hypot(sn.sx - mx, sn.sy - my) < r) {\n            if (!sn.isCenter) {\n              closeSubNetworkModal();\n              openInspector(nodes[sn.id]);\n            }\n          }\n        });\n      };\n    }","TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\hyperbolic_3d_network.html","toolAction":"Enabling dynamic organic position motion in sub-network modal","toolSummary":"Make sub-network node positions dynamic and non-static"}}]}
