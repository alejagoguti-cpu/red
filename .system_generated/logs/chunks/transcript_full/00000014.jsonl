te.bg;\n1691:       ctx.fillRect(0, 0, w, h);\n1692: \n1693:       if (opts.showSphere) {\n1694:         const radius = 270;\n1695:         const steps = 48;\n1696:         ctx.lineWidth = 1;\n1697: \n1698:         for (let i = 1; i < 7; i++) {\n1699:           const phi = (i / 7) * Math.PI;\n1700:           const rLat = radius * Math.sin(phi);\n1701:           const yLat = radius * Math.cos(phi);\n1702: \n1703:           ctx.strokeStyle = palette.sphere;\n1704:           ctx.beginPath();\n1705:           let first = true;\n1706:           for (let j = 0; j <= steps; j++) {\n1707:             const theta = (j / steps) * Math.PI * 2;\n1708:             const px = rLat * Math.cos(theta);\n1709:             const pz = rLat * Math.sin(theta);\n1710:             const p = project(px, yLat, pz, w, h);\n1711:             if (p.visible) {\n1712:               if (first) { ctx.moveTo(p.x, p.y); first = false; }\n1713:               else { ctx.lineTo(p.x, p.y); }\n1714:             }\n1715:           }\n1716:           ctx.stroke();\n1717:         }\n1718: \n1719:         [0, Math.PI / 2].forEach(angle => {\n1720:           ctx.strokeStyle = palette.sphereEquator;\n1721:           ctx.beginPath();\n1722:           let first = true;\n1723:           for (let j = 0; j <= steps; j++) {\n1724:             const a = (j / steps) * Math.PI * 2;\n1725:             const px = radius * Math.cos(a);\n1726:             const py = angle === 0 ? 0 : radius * Math.sin(a);\n1727:             const pz = angle === 0 ? radius * Math.sin(a) : 0;\n1728:             const p = project(px, py, pz, w, h);\n1729:             if (p.visible) {\n1730:               if (first) { ctx.moveTo(p.x, p.y); first = false; }\n1731:               else { ctx.lineTo(p.x, p.y); }\n1732:             }\n1733:           }\n1734:           ctx.stroke();\n1735:         });\n1736:       }\n1737: \n1738:       nodes.forEach((n, idx) => {\n1739:         if (!n.active) return;\n1740: \n1741:         let rx = n.ox !== undefined ? n.ox : n.x;\n1742:         let ry = n.oy !== undefined ? n.oy : n.y;\n1743:         let rz = n.oz !== undefined ? n.oz : n.z;\n1744: \n1745:         n.x += (rx - n.x) * 0.08;\n1746:         n.y += (ry - n.y) * 0.08;\n1747:         n.z += (rz - n.z) * 0.08;\n1748: \n1749:         if (opts.pulseMotion && !n.isRoot) {\n1750:           const wave = Math.sin(animTime * 1.8 + idx * 0.3) * 2;\n1751:           n.renderX = n.x + (n.x / 200) * wave;\n1752:           n.renderY = n.y + (n.y / 200) * wave;\n1753:           n.renderZ = n.z + (n.z / 200) * wave;\n1754:         } else {\n1755:           n.renderX = n.x; n.renderY = n.y; n.renderZ = n.z;\n1756:         }\n1757: \n1758:         if (n.currentSize !== undefined && n.targetSize !== undefined) {\n1759:           n.currentSize += (n.targetSize - n.currentSize) * 0.15;\n1760:         } else {\n1761:           n.currentSize = n.targetSize || 8;\n1762:         }\n1763: \n1764:         n.proj = project(n.renderX, n.renderY, n.renderZ, w, h);\n1765:       });\n1766: \n1767:       if (opts.showEdges) {\n1768:         ctx.lineWidth = 1;\n1769:         edges.forEach(e => {\n1770:           if (!e.active) return;\n1771:           const s = nodes[e.source];\n1772:           const t = nodes[e.target];\n1773: \n1774:           if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n1775: \n1776:           const isHov = hoveredNode && (e.source === hoveredNode.id || e.target === hoveredNode.id);\n1777:           const isSel = selectedNode && (e.source === selectedNode.id || e.target === selectedNode.id);\n1778:           const isSrch = searchedId !== null && (e.source === searchedId || e.target === searchedId);\n1779: \n1780:           if (isHov || isSel || isSrch) {\n1781:             ctx.strokeStyle = '#00ffff';\n1782:             ctx.lineWidth = 3.5;\n1783:             ctx.shadowColor = '#00ffff';\n1784:             ctx.shadowBlur = 10;\n1785:           } else {\n1786:             ctx.strokeStyle = selectedNode ? 'rgba(60, 15, 30, 0.15)' : palette.edge;\n1787:             ctx.lineWidth = 1;\n1788:             ctx.shadowBlur = 0;\n1789:           }\n1790: \n1791:           ctx.beginPath();\n1792:           ctx.moveTo(s.proj.x, s.proj.y);\n1793:           ctx.lineTo(t.proj.x, t.proj.y);\n1794:           ctx.stroke();\n1795:           ctx.shadowBlur = 0;\n1796:         });\n1797:       }\n1798: \n1799:       // RENDER SPECIFIC ACCURATE REAL SPECIES PHOTOS IN 3D\n1800:       const sorted = [...nodes].filter(n => n.active && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n1801: \n1802:       sorted.forEach(n => {\n1803:         if (!n.proj.visible) return;\n1804: \n1805:         const px = Math.round(n.proj.x);\n1806:         const py = Math.round(n.proj.y);\n1807:         const isHov = hoveredNode && hoveredNode.id === n.id;\n1808:         const isSel = selectedNode && selectedNode.id === n.id;\n1809:         const isSrch = searchedId === n.id;\n1810: \n1811:         const alphaDepth = Math.max(0.35, Math.min(1.0, (n.proj.z + 500) / 800));\n1812:         let rad = Math.max(8, Math.round(n.currentSize * n.proj.scale * 0.95));\n1813:         if (isHov || isSel || isSrch) rad += 5;\n1814: \n1815:         // Clip Circular Real Photo Frame\n1816:         ctx.save();\n1817:         ctx.globalAlpha = (selectedNode && !isSel && !selectedNode.neighbors.includes(n)) ? alphaDepth * 0.25 : alphaDepth;\n1818: \n1819:         ctx.beginPath();\n1820:         ctx.arc(px, py, rad, 0, Math.PI * 2);\n1821:         ctx.clip();\n1822: \n1823:         if (n.imgObj && n.imgObj.complete && n.imgObj.naturalWidth !== 0) {\n1824:           ctx.drawImage(n.imgObj, px - rad, py - rad, rad * 2, rad * 2);\n1825:         } else {\n1826:           ctx.fillStyle = palette.catColors[n.cat];\n1827:           ctx.fillRect(px - rad, py - rad, rad * 2, rad * 2);\n1828:         }\n1829:         ctx.restore();\n1830: \n1831:         // Border Ring\n1832:         ctx.save();\n1833:         ctx.globalAlpha = alphaDepth;\n1834:         ctx.beginPath();\n1835:         ctx.arc(px, py, rad + 1, 0, Math.PI * 2);\n1836:         ctx.strokeStyle = (isHov || isSel || isSrch) ? '#ffffff' : palette.catColors[n.cat];\n1837:         ctx.lineWidth = (isHov || isSel || isSrch) ? 3 : 2;\n1838:         ctx.stroke();\n1839:         ctx.restore();\n1840: \n1841:         // Label on Hover\n1842:         if (isHov || isSel || isSrch) {\n1843:           ctx.save();\n1844:           ctx.globalAlpha = 1.0;\n1845:           ctx.font = \"11px ui-monospace, monospace\";\n1846:           ctx.fillStyle = \"#ffffff\";\n1847:           ctx.shadowColor = \"#000000\";\n1848:           ctx.shadowBlur = 4;\n1849:           ctx.fillText(`${n.label} [${n.taxaId}]`, px + rad + 6, py + 3);\n1850:           ctx.restore();\n1851:         }\n1852:       });\n1853: \n1854:       requestAnimationFrame(render);\n1855:     }\n1856: \n1857:     // --- MOUSE & DOUBLE CLICK HANDLERS ---\n1858:     canvas.addEventListener('mousedown', e => {\n1859:       isMouseDown = true;\n1860:       mouseBtn = e.button;\n1861:       lastX = e.clientX;\n1862:       lastY = e.clientY;\n1863:       clickStartX = e.clientX;\n1864:       clickStartY = e.clientY;\n1865:     });\n1866: \n1867:     window.addEventListener('mouseup', e => {\n1868:       isMouseDown = false;\n1869:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n1870: \n1871:       if (dragDist < 5 && mouseBtn === 0) {\n1872:         if (hoveredNode) {\n1873:           openInspector(hoveredNode);\n1874:         }\n1875:       }\n1876:     });\n1877: \n1878:     // DOBLE CLIC PARA OCULTAR NODO DE LA RED\n1879:     canvas.addEventListener('dblclick', e => {\n1880:       if (hoveredNode) {\n1881:         hideNodeByDoubleClick(hoveredNode);\n1882:       }\n1883:     });\n1884: \n1885:     canvas.addEventListener('mousemove', e => {\n1886:       if (isMouseDown) {\n1887:         const dx = e.clientX - lastX;\n1888:         const dy = e.clientY - lastY;\n1889:         if (mouseBtn === 0) {\n1890:           velY = dx * 0.003;\n1891:           velX = dy * 0.003;\n1892:           targetRotY += velY; targetRotX += velX;\n1893:         } else if (mouseBtn === 2) {\n1894:           targetPanX += dx; targetPanY += dy;\n1895:         }\n1896:         lastX = e.clientX; lastY = e.clientY;\n1897:       } else {\n1898:         const mx = e.clientX;\n1899:         const my = e.clientY;\n1900: \n1901:         let closest = null;\n1902:         let minDist = 14;\n1903: \n1904:         nodes.forEach(n => {\n1905:           if (!n.active || !n.proj || !n.proj.visible) return;\n1906:           const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n1907:           if (d < minDist) {\n1908:             minDist = d;\n1909:             closest = n;\n1910:           }\n1911:         });\n1912: \n1913:         if (closest !== hoveredNode) {\n1914:           hoveredNode = closest;\n1915:         }\n1916:       }\n1917:     });\n1918: \n1919:     canvas.addEventListener('contextmenu', e => e.preventDefault());\n1920:     canvas.addEventListener('wheel', e => {\n1921:       e.preventDefault();\n1922:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n1923:       targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n1924:     }, { passive: false });\n1925: \n1926:     // Init\n1927:     buildTopology();\n1928:     requestAnimationFrame(render);\n1929:   </script>\n1930: </body>\n1931: </html>\n1932: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
