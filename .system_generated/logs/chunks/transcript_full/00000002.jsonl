n        ['ABI-04', 'Dióxido de Nitrógeno (NO2)', 'Pluma de Diésel 48.2 µg/m3', 'Deterioro de capacidad olfativa en polinizadores nativos', 'Corredor de transporte pesado Av. Cali', 'Zonas de Baja Emisión (ZBE) requeridas', 'https://commons.wikimedia.org/wiki/Special:FilePath/NO2_pollution_map.png'],\n        ['ABI-05', 'Lixiviados Orgánicos & DBO5', '>180 mg/L DBO5 Vertimientos', 'Eutrofización acelerada, anoxia y muerte de peces', 'Humedal La Vaca (Corabastos / María Paz)', 'Muy Alto Nivel de Repulsión (Fuerza = 0.90)', 'https://commons.wikimedia.org/wiki/Special:FilePath/Water_eutrophication_diagram.png'],\n        ['ABI-06', 'Espejo de Agua Activo (NDWI)', 'NDWI > 0.3 (Atracción Hídrica)', 'Centro de atracción de hábitat para avifauna acuática', 'Centro de los 3 humedales de Kennedy', 'Fuerza Atractora Hídrica (-0.90)', 'https://commons.wikimedia.org/wiki/Special:FilePath/Wetland_water_reflection.jpg'],\n        ['ABI-07', 'Microplásticos & Residuos', 'Plastic Index Alto', 'Ingestión accidental por tinguas y fochas en litorales', 'Espejo y orillas de Techo y El Burro', 'Requiere limpieza mecánica continua SDA', 'https://commons.wikimedia.org/wiki/Special:FilePath/Plastic_pollution_in_water.jpg']\n      ];\n      abiData.forEach(b => taxa.push({ id: b[0], name: b[1], sciname: b[2], cat: 4, role: b[3], loc: b[4], alert: b[5], img: b[6] }));\n\n      // 6. FLORA & ARBOLADO CENSO SIGAU (SIGAU-00