{"step_index":1006,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-07T20:51:18Z","content":"Created At: 2026-10-07T15:51:18-05:00\nCompleted At: 2026-10-07T15:51:19-05:00\nFile Path: `file:///C:/Users/aleja/.gemini/antigravity/brain/d3de736b-bad3-4cd4-b3f7-8b59f3dfee52/red_ecosistema_kennedy.html`\nTotal Lines: 483\nTotal Bytes: 17370\nShowing lines 251 to 483\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n251:     const rawNodesData = [\n252:       // NODO CENTRO\n253:       { id: 'CORE', label: 'Ecosistema Agroalimentario & Logístico', category: 'Núcleo Central', cluster: 'core', desc: 'Centro neurálgico de abastecimiento alimentario y redistribución logística del Borde Occidental de Bogotá D.C.', citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca.', radius: 52, angle: 0, dist: 0 },\n254: \n255:       // NIVEL 1: PÚBLICOS / MACRO REGIONAL (Arriba - Tono Rosa Pastel)\n256:       { id: 'REG_MAIN', label: 'Región Central & Accesos', category: 'Macro Regional', cluster: 'macro', desc: 'Proveedor primario de carga agrícola e insumos pecuarios procesados en tractocamiones pesados C3-S3.', citation: 'SDM (2019) Estudio Origen-Destino de Carga.', radius: 36, angle: -Math.PI / 2, dist: 190 },\n257:       { id: 'REG_CALLE13', label: 'Corredor Calle 13 / Autosur', category: 'Macro Regional', cluster: 'macro', desc: 'Punto de ingreso del 68% de los alimentos de la capital.', citation: 'Decreto 319 de 2006 (Plan Maestro).', radius: 26, angle: -Math.PI / 2 - 0.35, dist: 280 },\n258:       { id: 'REG_PRODUCT', label: 'Boyacá / Meta / Tolima', category: 'Macro Regional', cluster: 'macro', desc: 'Despacho de alimentos perecederos y grano seco.', citation: 'SDDE & CCB (2021).', radius: 24, angle: -Math.PI / 2 + 0.35, dist: 280 },\n259: \n260:       // NIVEL 2: HUB LOGÍSTICO FONTIBÓN (Derecha Arriba - Tono Violeta Pastel)\n261:       { id: 'LOG_MAIN', label: 'Cluster Zona Franca Bogotá', category: 'Hub Logístico', cluster: 'hub', desc: 'Hub de empaques, secos, mercancía industrializada de importación e intermediación.', citation: 'SDDE & CCB (2021).', radius: 36, angle: -Math.PI / 6, dist: 200 },\n262:       { id: 'LOG_CENTENARIO', label: 'Av. Centenario ⇄ Av. Cali', category: 'Hub Logístico', cluster: 'hub', desc: 'Corredor de conexión pesada bidireccional entre Fontibón y Kennedy.', citation: 'SDM (2022) Flujos Logísticos.', radius: 26, angle: -Math.PI / 6 - 0.25, dist: 290 },\n263:       { id: 'LOG_EMPAQUES', label: 'Procesamiento Secos & Empaques', category: 'Hub Logístico', cluster: 'hub', desc: 'Suministro de empaques plásticos y costalería para Corabastos.', citation: 'SDDE (2021) Logística Urbana.', radius: 24, angle: -Math.PI / 6 + 0.25, dist: 290 },\n264: \n265:       // NIVEL 3: ARTERIAS URBANAS KENNEDY (Derecha Abajo - Tono Azul Celeste Pastel)\n266:       { id: 'URB_MAIN', label: 'Arterias Urbanas Kennedy', category: 'Arterias Distritales', cluster: 'arterias', desc: 'Malla vial colectora y distribuidora distrital.', citation: 'IDU (2021) Capacidad Operativa en Kennedy.', radius: 36, angle: Math.PI / 4, dist: 200 },\n267:       { id: 'URB_AMERICAS', label: 'Nodo Banderas / Av. Américas', category: 'Arterias Distritales', cluster: 'arterias', desc: 'Confluencia de rutas troncales de TransMilenio, alimentadores y camiones.', citation: 'IDU (2021).', radius: 26, angle: Math.PI / 4 - 0.25, dist: 290 },\n268:       { id: 'URB_TINTAL', label: 'Corredor Av. Tintal / Av. Cepeda', category: 'Arterias Distritales', cluster: 'arterias', desc: 'Vía afectada por retención en cola (Spillback) de 3 km.', citation: 'SDM (2020) PMT Patio Bonito.', radius: 26, angle: Math.PI / 4 + 0.25, dist: 290 },\n269: \n270:       // NIVEL 4: NÚCLEO HIPERLOCAL CORABASTOS (Izquierda Abajo - Tono Verde Menta Pastel)\n271:       { id: 'CORE_MAIN', label: 'Central Mayorista Corabastos', category: 'Núcleo Hiperlocal', cluster: 'corabastos', desc: 'Punto de recepción y comercialización final de carga agroalimentaria.', citation: 'Resolución SDM 184 de 2018.', radius: 36, angle: Math.PI * 3 / 4, dist: 200 },\n272:       { id: 'CORE_PUERTAS', label: 'Básculas Puertas 6, 7 y 8', category: 'Núcleo Hiperlocal', cluster: 'corabastos', desc: 'Embudos de pesaje que originan la cola de retención exterior.', citation: 'POT Decreto 555 de 2021.', radius: 26, angle: Math.PI * 3 / 4 - 0.25, dist: 290 },\n273:       { id: 'CORE_MALLA', label: 'Malla Local Peri-Corabastos', category: 'Núcleo Hiperlocal', cluster: 'corabastos', desc: 'Velocidad < 5 km/h por parqueo informal y bicipatines cargadores.', citation: 'Corabastos S.A. & SDM (2018).', radius: 26, angle: Math.PI * 3 / 4 + 0.25, dist: 290 }\n274:     ];\n275: \n276:     const edges = [\n277:       { source: 'CORE', target: 'REG_MAIN' },\n278:       { source: 'CORE', target: 'LOG_MAIN' },\n279:       { source: 'CORE', target: 'URB_MAIN' },\n280:       { source: 'CORE', target: 'CORE_MAIN' },\n281: \n282:       { source: 'REG_MAIN', target: 'REG_CALLE13' },\n283:       { source: 'REG_MAIN', target: 'REG_PRODUCT' },\n284: \n285:       { source: 'LOG_MAIN', target: 'LOG_CENTENARIO' },\n286:       { source: 'LOG_MAIN', target: 'LOG_EMPAQUES' },\n287: \n288:       { source: 'URB_MAIN', target: 'URB_AMERICAS' },\n289:       { source: 'URB_MAIN', target: 'URB_TINTAL' },\n290: \n291:       { source: 'CORE_MAIN', target: 'CORE_PUERTAS' },\n292:       { source: 'CORE_MAIN', target: 'CORE_MALLA' },\n293: \n294:       // Intersecciones transversales\n295:       { source: 'LOG_MAIN', target: 'CORE_MAIN' },\n296:       { source: 'REG_MAIN', target: 'LOG_MAIN' },\n297:       { source: 'URB_MAIN', target: 'CORE_MAIN' },\n298:       { source: 'CORE_PUERTAS', target: 'URB_TINTAL' }\n299:     ];\n300: \n301:     let nodes = [];\n302: \n303:     function resize() {\n304:       canvas.width = window.innerWidth;\n305:       canvas.height = window.innerHeight;\n306:     }\n307:     window.addEventListener('resize', resize);\n308:     resize();\n309: \n310:     function initTopology() {\n311:       const nodeMap = new Map();\n312:       nodes = rawNodesData.map((d, idx) => {\n313:         const x = Math.cos(d.angle) * d.dist;\n314:         const y = Math.sin(d.angle) * d.dist;\n315:         const n = { ...d, nodeId: idx, x, y };\n316:         nodeMap.set(d.id, n);\n317:         return n;\n318:       });\n319: \n320:       edges.forEach(e => {\n321:         e.sourceNode = nodeMap.get(e.source);\n322:         e.targetNode = nodeMap.get(e.target);\n323:       });\n324:     }\n325: \n326:     function resetZoom() {\n327:       targetScale = 1.0; targetPanX = 0; targetPanY = 0;\n328:     }\n329: \n330:     function openInspector(node) {\n331:       selectedNode = node;\n332:       document.getElementById('mNodeTitle').innerText = node.label;\n333:       document.getElementById('mNodeCategory').innerText = `Cluster: ${node.category}`;\n334:       document.getElementById('mNodeDesc').innerText = node.desc;\n335:       document.getElementById('mNodeCitation').innerText = node.citation;\n336:       document.getElementById('nodeInspector').style.display = 'flex';\n337:     }\n338: \n339:     function closeInspector() {\n340:       selectedNode = null;\n341:       document.getElementById('nodeInspector').style.display = 'none';\n342:     }\n343: \n344:     function render() {\n345:       const w = canvas.width, h = canvas.height;\n346:       const cx = w / 2 + panX;\n347:       const cy = h / 2 + panY;\n348: \n349:       scale += (targetScale - scale) * 0.12;\n350:       panX += (targetPanX - panX) * 0.12;\n351:       panY += (targetPanY - panY) * 0.12;\n352: \n353:       // 1. Fondo Blanco Puro\n354:       ctx.fillStyle = palette.bg;\n355:       ctx.fillRect(0, 0, w, h);\n356: \n357:       ctx.save();\n358:       ctx.translate(cx, cy);\n359:       ctx.scale(scale, scale);\n360: \n361:       // 2. Anillos Concéntricos Flat de Fondo (Guias Radiales)\n362:       [190, 280, 360].forEach(r => {\n363:         ctx.beginPath();\n364:         ctx.arc(0, 0, r, 0, Math.PI * 2);\n365:         ctx.strokeStyle = palette.ringLine;\n366:         ctx.lineWidth = 1;\n367:         ctx.setLineDash([4, 4]);\n368:         ctx.stroke();\n369:         ctx.setLineDash([]);\n370:       });\n371: \n372:       // 3. Render Edges (Líneas de Conexión Flat Limpias)\n373:       edges.forEach(e => {\n374:         const s = e.sourceNode, t = e.targetNode;\n375:         if (!s || !t) return;\n376: \n377:         const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n378:         const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n379: \n380:         ctx.save();\n381:         ctx.beginPath();\n382:         ctx.moveTo(s.x, s.y);\n383:         ctx.lineTo(t.x, t.y);\n384:         ctx.strokeStyle = (isHov || isSel) ? palette.edgeActive : palette.edgeLine;\n385:         ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.2;\n386:         ctx.stroke();\n387:         ctx.restore();\n388:       });\n389: \n390:       // 4. Render Nodos Círculos Flat Sólidos Pastel (Sin Gradientes 3D)\n391:       nodes.forEach(n => {\n392:         const isHov = hoveredNode && hoveredNode.id === n.id;\n393:         const isSel = selectedNode && selectedNode.id === n.id;\n394:         const cStyle = palette.clusters[n.cluster] || palette.clusters.core;\n395: \n396:         ctx.save();\n397: \n398:         // Relleno Sólido Flat Pastel\n399:         ctx.fillStyle = cStyle.fill;\n400:         ctx.beginPath();\n401:         ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);\n402:         ctx.fill();\n403: \n404:         // Borde Vectorial Limpio\n405:         ctx.strokeStyle = (isHov || isSel) ? '#0f172a' : cStyle.stroke;\n406:         ctx.lineWidth = (isHov || isSel) ? 3 : 1.8;\n407:         ctx.stroke();\n408: \n409:         // Texto Integrado Dentro o Debajo del Nodo\n410:         ctx.font = (isHov || isSel) ? 'bold 11px sans-serif' : '10px sans-serif';\n411:         ctx.fillStyle = cStyle.text;\n412:         ctx.textAlign = 'center';\n413:         ctx.textBaseline = 'middle';\n414: \n415:         // Wrap label text inside circle if it's large, or underneath\n416:         if (n.radius >= 36) {\n417:           const words = n.label.split(' ');\n418:           if (words.length > 2) {\n419:             ctx.fillText(words.slice(0, 2).join(' '), n.x, n.y - 6);\n420:             ctx.fillText(words.slice(2).join(' '), n.x, n.y + 8);\n421:           } else {\n422:             ctx.fillText(n.label, n.x, n.y);\n423:           }\n424:         } else {\n425:           ctx.fillText(n.label, n.x, n.y + n.radius + 12);\n426:         }\n427: \n428:         ctx.restore();\n429:       });\n430: \n431:       ctx.restore();\n432: \n433:       requestAnimationFrame(render);\n434:     }\n435: \n436:     // Controls\n437:     canvas.addEventListener('mousedown', e => {\n438:       isMouseDown = true;\n439:       lastX = e.clientX; lastY = e.clientY;\n440:       clickStartX = e.clientX; clickStartY = e.clientY;\n441:     });\n442: \n443:     window.addEventListener('mouseup', e => {\n444:       isMouseDown = false;\n445:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n446:       if (dragDist < 5 && hoveredNode) {\n447:         openInspector(hoveredNode);\n448:       }\n449:     });\n450: \n451:     canvas.addEventListener('mousemove', e => {\n452:       if (isMouseDown) {\n453:         targetPanX += e.clientX - lastX;\n454:         targetPanY += e.clientY - lastY;\n455:         lastX = e.clientX; lastY = e.clientY;\n456:       } else {\n457:         const w = canvas.width, h = canvas.height;\n458:         const cx = w / 2 + panX;\n459:         const cy = h / 2 + panY;\n460:         const mx = (e.clientX - cx) / scale;\n461:         const my = (e.clientY - cy) / scale;\n462: \n463:         let closest = null, minDist = 40;\n464:         nodes.forEach(n => {\n465:           const d = Math.hypot(n.x - mx, n.y - my);\n466:           if (d < minDist) { minDist = d; closest = n; }\n467:         });\n468:         hoveredNode = closest;\n469:       }\n470:     });\n471: \n472:     canvas.addEventListener('wheel', e => {\n473:       e.preventDefault();\n474:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n475:       targetScale = Math.max(0.5, Math.min(2.5, targetScale * zoomFactor));\n476:     }, { passive: false });\n477: \n478:     initTopology();\n479:     requestAnimationFrame(render);\n480:   </script>\n481: </body>\n482: </html>\n483: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":1007,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T20:51:19Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Única Red Radial Flat Ecosistémica de Kennedy - Corabastos - Zona Franca calcada 1:1 de la infografía radial de referencia (fondo blanco, sectores de arcos pastel transparentes, racimos de esferas flat pastel con textos en orbitales e interacción por clic/hover).","UserFacing":true},"CodeContent":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Ecosistema de Movilidad y Logística: Kennedy - Corabastos - Zona Franca</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body, html {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background-color: #ffffff;\n      color: #1e293b;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      font-size: 12px;\n      user-select: none;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    #viewport {\n      width: 100%;\n      height: 100%;\n      display: block;\n      cursor: grab;\n    }\n    #viewport:active {\n      cursor: grabbing;\n    }\n\n    .header-panel {\n      position: absolute;\n      top: 20px;\n      left: 50%;\n      transform: translateX(-50%);\n      text-align: center;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .main-title {\n      font-size: 20px;\n      font-weight: 800;\n      color: #334155;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n    }\n    .main-subtitle {\n      font-size: 12px;\n      color: #64748b;\n      margin-top: 4px;\n      font-weight: 500;\n    }\n\n    /* Inspector Popup */\n    .node-inspector {\n      position: absolute;\n      top: 80px;\n      right: 20px;\n      width: 360px;\n      background: rgba(255, 255, 255, 0.96);\n      border: 1px solid rgba(0, 0, 0, 0.1);\n      border-radius: 12px;\n      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);\n      padding: 18px;\n      z-index: 120;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .node-title {\n      font-size: 15px;\n      font-weight: 800;\n      color: #0f172a;\n    }\n    .node-subtitle {\n      font-size: 10px;\n      color: #64748b;\n      font-family: monospace;\n      text-transform: uppercase;\n      margin-top: 2px;\n    }\n\n    .btn-close {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #f1f5f9;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-size: 13px;\n      color: #475569;\n    }\n\n    .text-content {\n      background: #f8fafc;\n      border: 1px solid #e2e8f0;\n      border-radius: 8px;\n      padding: 10px 12px;\n      color: #334155;\n      font-size: 11.5px;\n      line-height: 1.5;\n    }\n\n    .citation-box {\n      background: rgba(132, 164, 139, 0.12);\n      border: 1px solid rgba(132, 164, 139, 0.35);\n      border-radius: 8px;\n      padding: 10px 12px;\n      color: #2e5a36;\n      font-size: 11px;\n      line-height: 1.4;\n      font-style: italic;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 20px;\n      left: 20px;\n      padding: 10px 18px;\n      background: rgba(255, 255, 255, 0.94);\n      border: 1px solid rgba(0, 0, 0, 0.08);\n      border-radius: 10px;\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\n      font-size: 11px;\n      color: #475569;\n      pointer-events: auto;\n      z-index: 100;\n    }\n  </style>\n</head>\n<body>\n\n  <canvas id=\"viewport\"></canvas>\n\n  <div class=\"header-panel\">\n    <div class=\"main-title\">ACTORES DE MOVILIDAD Y LOGÍSTICA EN KENNEDY</div>\n    <div class=\"main-subtitle\">CORABASTOS - ZONA FRANCA - BOGOTÁ D.C.</div>\n  </div>\n\n  <div class=\"node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid #e2e8f0; padding-bottom:8px;\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Título Nodo</div>\n        <div class=\"node-subtitle\" id=\"mNodeCategory\">Categoría Ecosistémica</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div style=\"font-size:10px; text-transform:uppercase; color:#64748b; font-weight:800;\">Función Operativa en el Ecosistema</div>\n    <div class=\"text-content\" id=\"mNodeDesc\">Descripción del actor.</div>\n\n    <div style=\"font-size:10px; text-transform:uppercase; color:#64748b; font-weight:800;\">📜 Cita Técnica Oficial Obligatoria</div>\n    <div class=\"citation-box\" id=\"mNodeCitation\">Cita oficial.</div>\n\n    <div style=\"display:flex; justify-content:flex-end; margin-top:4px;\">\n      <button style=\"background:#f1f5f9; border:1px solid #cbd5e1; padding:6px 12px; border-radius:6px; font-weight:700; cursor:pointer;\" onclick=\"closeInspector()\">Cerrar</button>\n    </div>\n  </div>\n\n  <div class=\"bottom-bar\">\n    💡 Clic en cualquier esfera o grupo de actores para ver su ficha técnica • Arrastra para desplazar el mapa\n  </div>\n\n  <script>\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    let scale = 1.0, targetScale = 1.0;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n    let isMouseDown = false, lastX = 0, lastY = 0, clickStartX = 0, clickStartY = 0;\n    let hoveredNode = null, selectedNode = null;\n\n    // Colores Pastel calcados exactamente del referente visual de la imagen\n    const colors = {\n      bg: '#ffffff',\n      publicos: { sector: 'rgba(250, 208, 196, 0.35)', fill: '#FAD0C4', stroke: '#E8A598', text: '#5C1D24' },   // Rosa Pastel (Públicos / Región)\n      privados: { sector: 'rgba(247, 225, 160, 0.35)', fill: '#F7E1A0', stroke: '#E3C676', text: '#594406' },   // Crema Pastel (Privados / Gremios)\n      operadores: { sector: 'rgba(226, 212, 240, 0.35)', fill: '#E2D4F0', stroke: '#BEA6DE', text: '#36124A' }, // Violeta Pastel (Operadores / Hub)\n      oferta: { sector: 'rgba(212, 237, 218, 0.35)', fill: '#D4EDDA', stroke: '#9BD4A7', text: '#11471D' },     // Verde Menta (Oferta / Corabastos)\n      demanda: { sector: 'rgba(208, 225, 253, 0.35)', fill: '#D0E1FD', stroke: '#9EC2FC', text: '#002E66' },    // Azul Pastel (Demanda / Arterias)\n      espacio: { sector: 'rgba(226, 232, 240, 0.35)', fill: '#E2E8F0', stroke: '#CBD5E1', text: '#334155' }     // Gris Pastel (Espacio / Malla)\n    };\n\n    // Dataset adaptado de Kennedy Bogotá conservando el esquema radial de la infografía\n    const rawNodesData = [\n      // === NODO CENTRAL MAESTRO ===\n      { id: 'CENTER', label: 'Ecosistema de Movilidad y Logística', category: 'Núcleo Central', cluster: 'privados', desc: 'Centro de coordinación de carga agroalimentaria y movilidad del Borde Occidental de Bogotá.', citation: 'POT Decreto 555 de 2021.', radius: 55, x: 0, y: 0 },\n\n      // === SECTOR 1: INSTITUCIONES PÚBLICAS & REGION (Arriba - Rosa Pastel) ===\n      { id: 'PUB_MAIN', label: 'Sector Público & Región', category: 'Actores Públicos', cluster: 'publicos', desc: 'Secretaría de Movilidad (SDM), Gobernación de Cundinamarca y Ministerios reguladores.', citation: 'SDM (2019) Estudio Origen-Destino.', radius: 42, x: 0, y: -220 },\n      { id: 'PUB_SDM', label: 'Sec. Distrital de Movilidad', category: 'Públicos', cluster: 'publicos', desc: 'Regulación de PMT y tráfico de carga.', citation: 'Resolución SDM 184 de 2018.', radius: 24, x: -75, y: -290 },\n      { id: 'PUB_IDU', label: 'Instituto de Desarrollo Urbano', category: 'Públicos', cluster: 'publicos', desc: 'Infraestructura vial y mantenimientos.', citation: 'IDU (2021) Informe Capacidad.', radius: 24, x: 0, y: -310 },\n      { id: 'PUB_CARGA', label: 'Accesos Calle 13 / Autosur', category: 'Públicos', cluster: 'publicos', desc: 'Portales de entrada del 68% de alimentos.', citation: 'Decreto 319 de 2006.', radius: 24, x: 75, y: -290 },\n\n      // === SECTOR 2: GREMIOS PRIVADOS & EMPRESAS (Derecha Arriba - Crema Pastel) ===\n      { id: 'PRIV_MAIN', label: 'Gremios & Transportadores', category: 'Sector Privado', cluster: 'privados', desc: 'Asociaciones camioneras (C3-S3), Cámara de Comercio de Bogotá y gremios de carga.', citation: 'SDDE & CCB (2021).', radius: 42, x: 220, y: -120 },\n      { id: 'PRIV_CAMION', label: 'Asociaciones de Carga Pesada', category: 'Privados', cluster: 'privados', desc: 'Operación de tractocamiones regionales.', citation: 'SDM (2019).', radius: 24, x: 290, y: -190 },\n      { id: 'PRIV_CCB', label: 'Cámara de Comercio Bogotá', category: 'Privados', cluster: 'privados', desc: 'Promoción logística y articulación empresarial.', citation: 'SDDE & CCB (2021).', radius: 24, x: 310, y: -110 },\n\n      // === SECTOR 3: OPERADORES & HUB ZONA FRANCA (Derecha Abajo - Violeta Pastel) ===\n      { id: 'OP_MAIN', label: 'Cluster Zona Franca Fontibón', category: 'Hub Logístico', cluster: 'operadores', desc: 'Operadores logísticos, procesamiento de secos, empaques y bodegaje industrial.', citation: 'SDDE (2021) Diagnóstico Logística.', radius: 42, x: 220, y: 150 },\n      { id: 'OP_CENTENARIO', label: 'Corredor Av. Centenario', category: 'Operadores', cluster: 'operadores', desc: 'Vía de interconexión pesada Fontibón-Kennedy.', citation: 'SDM (2022).', radius: 24, x: 310, y: 100 },\n      { id: 'OP_EMPAQUES', label: 'Procesamiento de Empaques', category: 'Operadores', cluster: 'operadores', desc: 'Suministro de plásticos y empaques para Corabastos.', citation: 'SDDE (2021).', radius: 24, x: 290, y: 210 },\n\n      // === SECTOR 4: CENTRAL MAYORISTA CORABASTOS (Abajo - Verde Menta) ===\n      { id: 'OFERT_MAIN', label: 'Central Mayorista Corabastos', category: 'Oferta Agroalimentaria', cluster: 'oferta', desc: 'Núcleo de recepción de 13.500 ton/día de alimentos y comercio mayorista.', citation: 'POT Decreto 555 de 2021.', radius: 46, x: 0, y: 250 },\n      { id: 'OFERT_BASCULAS', label: 'Básculas Puertas 6, 7 y 8', category: 'Oferta', cluster: 'oferta', desc: 'Control de pesaje e inspección de entrada.', citation: 'Res. SDM 184 de 2018.', radius: 24, x: -80, y: 320 },\n      { id: 'OFERT_COMERCIO', label: 'Comerciantes & Mayoristas', category: 'Oferta', cluster: 'oferta', desc: 'Bodegas de acopio y redistribución urbana.', citation: 'SDDE & CCB (2021).', radius: 24, x: 80, y: 320 },\n\n      // === SECTOR 5: ARTERIAS URBANAS & TRANSMILENIO (Izquierda Abajo - Azul Celeste) ===\n      { id: 'DEM_MAIN', label: 'Arterias Urbanas Kennedy', category: 'Movilidad Urbana', cluster: 'demanda', desc: 'Corredores de transporte público masivo (TransMilenio), SITP y vehículos particulares.', citation: 'IDU (2021) Capacidad Operativa.', radius: 42, x: -220, y: 150 },\n      { id: 'DEM_BANDERAS', label: 'Nodo Banderas / Av. Américas', category: 'Demanda', cluster: 'demanda', desc: 'Intersección modal de alto tráfico mixto.', citation: 'IDU (2021).', radius: 24, x: -300, y: 210 },\n      { id: 'DEM_TINTAL', label: 'Av. Tintal (Spillback 3km)', category: 'Demanda', cluster: 'demanda', desc: 'Retención de cola que satura la red distrital.', citation: 'SDM (2020) PMT Patio Bonito.', radius: 24, x: -310, y: 100 },\n\n      // === SECTOR 6: ESPACIO LOCAL & COMUNIDAD (Izquierda Arriba - Gris Pastel) ===\n      { id: 'GEO_MAIN', label: 'Malla Local Peri-Corabastos', category: 'Espacio Local', cluster: 'espacio', desc: 'Entorno barrial del sector Patio Bonito, El Amparo y espacio público ocupado.', citation: 'Corabastos S.A. & SDM (2018).', radius: 42, x: -220, y: -120 },\n      { id: 'GEO_CARRETAS', label: 'Carga Informal & Carretilleros', category: 'Espacio Local', cluster: 'espacio', desc: 'Descargue sobre vía y maniobras menores.', citation: 'Resolución SDM 184 de 2018.', radius: 24, x: -310, y: -170 },\n      { id: 'GEO_RESIDENTES', label: 'Comunidad Patio Bonito / Amparo', category: 'Espacio Local', cluster: 'espacio', desc: 'Habitantes afectados por degradación de velocidad < 5 km/h.', citation: 'POT Decreto 555 de 2021.', radius: 24, x: -290, y: -70 }\n    ];\n\n    const edges = [\n      { source: 'CENTER', target: 'PUB_MAIN' },\n      { source: 'CENTER', target: 'PRIV_MAIN' },\n      { source: 'CENTER', target: 'OP_MAIN' },\n      { source: 'CENTER', target: 'OFERT_MAIN' },\n      { source: 'CENTER', target: 'DEM_MAIN' },\n      { source: 'CENTER', target: 'GEO_MAIN' },\n\n      { source: 'PUB_MAIN', target: 'PUB_SDM' },\n      { source: 'PUB_MAIN', target: 'PUB_IDU' },\n      { source: 'PUB_MAIN', target: 'PUB_CARGA' },\n\n      { source: 'PRIV_MAIN', target: 'PRIV_CAMION' },\n      { source: 'PRIV_MAIN', target: 'PRIV_CCB' },\n\n      { source: 'OP_MAIN', target: 'OP_CENTENARIO' },\n      { source: 'OP_MAIN', target: 'OP_EMPAQUES' },\n\n      { source: 'OFERT_MAIN', target: 'OFERT_BASCULAS' },\n      { source: 'OFERT_MAIN', target: 'OFERT_COMERCIO' },\n\n      { source: 'DEM_MAIN', target: 'DEM_BANDERAS' },\n      { source: 'DEM_MAIN', target: 'DEM_TINTAL' },\n\n      { source: 'GEO_MAIN', target: 'GEO_CARRETAS' },\n      { source: 'GEO_MAIN', target: 'GEO_RESIDENTES' },\n\n      // Interconexiones cruzadas\n      { source: 'OP_MAIN', target: 'OFERT_MAIN' },\n      { source: 'OFERT_BASCULAS', target: 'DEM_TINTAL' },\n      { source: 'GEO_CARRETAS', target: 'OFERT_MAIN' }\n    ];\n\n    let nodes = [];\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function initTopology() {\n      const nodeMap = new Map();\n      nodes = rawNodesData.map((d, idx) => {\n        const n = { ...d, nodeId: idx };\n        nodeMap.set(d.id, n);\n        return n;\n      });\n\n      edges.forEach(e => {\n        e.sourceNode = nodeMap.get(e.source);\n        e.targetNode = nodeMap.get(e.target);\n      });\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      document.getElementById('mNodeTitle').innerText = node.label;\n      document.getElementById('mNodeCategory').innerText = `Categoría: ${node.category}`;\n      document.getElementById('mNodeDesc').innerText = node.desc;\n      document.getElementById('mNodeCitation').innerText = node.citation;\n      document.getElementById('nodeInspector').style.display = 'flex';\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function render() {\n      const w = canvas.width, h = canvas.height;\n      const cx = w / 2 + panX;\n      const cy = h / 2 + panY;\n\n      scale += (targetScale - scale) * 0.12;\n      panX += (targetPanX - panX) * 0.12;\n      panY += (targetPanY - panY) * 0.12;\n\n      ctx.fillStyle = colors.bg;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.save();\n      ctx.translate(cx, cy);\n      ctx.scale(scale, scale);\n\n      // 1. Dibujar Sectores de Fondo en Arcos Pastel (Igual al gráfico)\n      const sectors = [\n        { start: -Math.PI * 0.75, end: -Math.PI * 0.25, color: colors.publicos.sector, label: 'INSTITUCIONES & REGIÓN' },\n        { start: -Math.PI * 0.25, end: 0, color: colors.privados.sector, label: 'GREMIOS & CARGA' },\n        { start: 0, end: Math.PI * 0.4, color: colors.operadores.sector, label: 'HUB LOGÍSTICO FONTIBÓN' },\n        { start: Math.PI * 0.4, end: Math.PI * 0.75, color: colors.oferta.sector, label: 'CORABASTOS / OFERTA' },\n        { start: Math.PI * 0.75, end: Math.PI * 1.15, color: colors.demanda.sector, label: 'ARTERIAS / MOVILIDAD' },\n        { start: Math.PI * 1.15, end: Math.PI * 1.5, color: colors.espacio.sector, label: 'ESPACIO LOCAL' }\n      ];\n\n      sectors.forEach(s => {\n        ctx.beginPath();\n        ctx.moveTo(0, 0);\n        ctx.arc(0, 0, 360, s.start, s.end);\n        ctx.closePath();\n        ctx.fillStyle = s.color;\n        ctx.fill();\n      });\n\n      // 2. Anillos Concéntricos de Guía\n      [140, 240, 340].forEach(r => {\n        ctx.beginPath();\n        ctx.arc(0, 0, r, 0, Math.PI * 2);\n        ctx.strokeStyle = 'rgba(0, 0, 0, 0.05)';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n      });\n\n      // 3. Dibujar Conexiones Limpias entre Nodos\n      edges.forEach(e => {\n        const s = e.sourceNode, t = e.targetNode;\n        if (!s || !t) return;\n\n        const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n        const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(s.x, s.y);\n        ctx.lineTo(t.x, t.y);\n        ctx.strokeStyle = (isHov || isSel) ? '#0284c7' : 'rgba(0, 0, 0, 0.12)';\n        ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.2;\n        ctx.stroke();\n        ctx.restore();\n      });\n\n      // 4. Dibujar Esferas FLAT Pastel con Borde y Texto\n      nodes.forEach(n => {\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n        const cStyle = colors[n.cluster] || colors.privados;\n\n        ctx.save();\n\n        // Círculo Relleno Flat\n        ctx.fillStyle = cStyle.fill;\n        ctx.beginPath();\n        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Borde Sólido\n        ctx.strokeStyle = (isHov || isSel) ? '#0f172a' : cStyle.stroke;\n        ctx.lineWidth = (isHov || isSel) ? 3 : 1.8;\n        ctx.stroke();\n\n        // Texto Integrado en Círculo o Flotante\n        ctx.font = (isHov || isSel) ? 'bold 11px sans-serif' : '10px sans-serif';\n        ctx.fillStyle = cStyle.text;\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n\n        if (n.radius >= 38) {\n          const words = n.label.split(' ');\n          if (words.length > 2) {\n            ctx.fillText(words.slice(0, 2).join(' '), n.x, n.y - 7);\n            ctx.fillText(words.slice(2).join(' '), n.x, n.y + 8);\n          } else {\n            ctx.fillText(n.label, n.x, n.y);\n          }\n        } else {\n          ctx.fillText(n.label, n.x, n.y + n.radius + 12);\n        }\n\n        ctx.restore();\n      });\n\n      ctx.restore();\n\n      requestAnimationFrame(render);\n    }\n\n    // Eventos Mouse\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        targetPanX += e.clientX - lastX;\n        targetPanY += e.clientY - lastY;\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const w = canvas.width, h = canvas.height;\n        const cx = w / 2 + panX;\n        const cy = h / 2 + panY;\n        const mx = (e.clientX - cx) / scale;\n        const my = (e.clientY - cy) / scale;\n\n        let closest = null, minDist = 40;\n        nodes.forEach(n => {\n          const d = Math.hypot(n.x - mx, n.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetScale = Math.max(0.5, Math.min(2.5, targetScale * zoomFactor));\n    }, { passive: false });\n\n    initTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Reemplazo total del sitio por una ÚNICA red radial FLAT pastel calcada exactamente del mapa de referencia para el ecosistema de Kennedy - Corabastos - Zona Franca en Bogotá D.C.","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\index.html","toolAction":"Creating single flat radial network for Kennedy Bogota","toolSummary":"Create single flat radial network for Kennedy Bogota"}}]}
