: \n801:       // === NIVEL 4: NÚCLEO HIPERLOCAL CORABASTOS ===\n802:       {\n803:         id: 'S4-SÍNTOMA',\n804:         name: 'Degradación de Velocidad Media a menos de 5 km/h',\n805:         shortLabel: 'Velocidad Media < 5 km/h en Ronda',\n806:         level: 4,\n807:         triadRole: 'sintoma',\n808:         catName: 'Síntoma - Núcleo Hiperlocal',\n809:         function: 'Tráfico prácticamente detenido en las vías inmediatas que rodean la central de abastecimiento.',\n810:         impact: 'Parálisis de la circulación en la red vial del sector Patio Bonito y El Amparo.',\n811:         citation: 'Corabastos S.A. & SDM. (2018). Resolución SDM 184 de 2018 (Reglamento Interno de Operación).',\n812:         x: 80, y: 170, z: 150\n813:       },\n814:       {\n815:         id: 'S4-CAUSA',\n816:         name: 'Demoras en Básculas, Inspección y Pesaje (Puertas 6, 7 y 8)',\n817:         level: 4,\n818:         triadRole: 'causa',\n819:         catName: 'Causa Hiperlocal Núcleo',\n820:         function: 'Capacidad insuficiente y tiempo prolongado de registro en las taquillas de acceso a Corabastos.',\n821:         impact: 'Origen primario de la cola de retención (Spillback) que se propaga a los niveles superiores.',\n822:         citation: 'POT Decreto 555 de 2021 - Actuación Estratégica Chucua de la Vaca / SDM (2020).',\n823:         x: 140, y: 220, z: 200\n824:       },\n825:       {\n826:         id: 'S4-EFECTO',\n827:         name: 'Invasión del Espacio Público por Carga Informal & Carretilleros',\n828:         shortLabel: 'Invasión Espacio Público Carga Informal',\n829:         level: 4,\n830:         triadRole: 'efecto',\n831:         catName: 'Efecto Hiperlocal Núcleo',\n832:         function: 'Parqueo informal en vía, maniobras no reguladas de descarga y venta sobre espacio público.',\n833:         impact: 'Bloqueo total de la malla vial local peri-Corabastos y deterioro de la seguridad vial.',\n834:         citation: 'Corabastos S.A. & SDM. (2018). Reglamento Interno de Operación Logística y Tránsito.',\n835:         x: 200, y: 270, z: 250\n836:       }\n837:     ];\n838: \n839:     // Master Edges WITH ALL-TO-ALL FULLY INTERCONNECTED CAUSAL NETWORK\n840:     const rawEdgesData = [\n841:       // Sequence Tríada Nivel 1\n842:       { id: 'E1.1', source: 'S1-SÍNTOMA', target: 'S1-CAUSA', name: 'Origen Carga Regional', desc: 'Embotellamiento regional originado por concentración de carga alimentaria.' },\n843:       { id: 'E1.2', source: 'S1-CAUSA', target: 'S1-EFECTO', name: 'Colapso de Puertas', desc: 'Concentración masiva genera sobrecarga en puertas de acceso distritales.' },\n844:       { id: 'E1.3', source: 'S1-SÍNTOMA', target: 'S1-EFECTO', name: 'Directo Embotellamiento-Sobrecarga', desc: 'Impacto directo de embotellamientos sobre accesos.' },\n845: \n846:       // Sequence Tríada Nivel 2\n847:       { id: 'E2.1', source: 'S2-SÍNTOMA', target: 'S2-CAUSA', name: 'Fricción por Vía Compartida', desc: 'Fricción en Av. Centenario producida por falta de vía segregada.' },\n848:       { id: 'E2.2', source: 'S2-CAUSA', target: 'S2-EFECTO', name: 'Bloqueo e Ineficiencia', desc: 'Falta de vía segregada genera ineficiencia en transporte de insumos.' },\n849:       { id: 'E2.3', source: 'S2-SÍNTOMA', target: 'S2-EFECTO', name: 'Fricción-Bloqueo Inter-local', desc: 'Fricción permanente termina bloqueando el eje logístico.' },\n850: \n851:       // Sequence Tríada Nivel 3\n852:       { id: 'E3.1', source: 'S3-SÍNTOMA', target: 'S3-CAUSA', name: 'Mecanismo de Spillback', desc: 'Cola de 3 km provocada por mezcla de carga con TransMilenio y SITP.' },\n853:       { id: 'E3.2', source: 'S3-CAUSA', target: 'S3-EFECTO', name: 'Parálisis Urbana Kennedy', desc: 'Mezcla vehicular desemboca en la parálisis de movilidad urbana.' },\n854:       { id: 'E3.3', source: 'S3-SÍNTOMA', target: 'S3-EFECTO', name: 'Spillback-Parálisis Distrital', desc: 'Spillback genera directamente bloqueo de intersecciones en Kennedy.' },\n855: \n856:       // Sequence Tríada Nivel 4\n857:       { id: 'E4.1', source: 'S4-SÍNTOMA', target: 'S4-CAUSA', name: 'Demora Báscula-Velocidad', desc: 'Velocidad < 5 km/h causada por inspección lenta en básculas.' },\n858:       { id: 'E4.2', source: 'S4-CAUSA', target: 'S4-EFECTO', name: 'Invasión Espacio Público', desc: 'Demora en básculas empuja al parqueo e invasión informal sobre vía.' },\n859:       { id: 'E4.3', source: 'S4-SÍNTOMA', target: 'S4-EFECTO', name: 'Velocidad-Invasión Vía', desc: 'Parálisis hiperlocal facilita la ocupación informal del espacio público.' },\n860: \n861:       // Cross-Level Interconnections (Red Causal Totalmente Interconectada)\n862:       { id: 'E1-2.A', source: 'S1-EFECTO', target: 'S2-SÍNTOMA', name: 'Propagación N1 ➔ N2', desc: 'Sobrecarga de entrada regional alimenta la fricción en Av. Centenario.' },\n863:       { id: 'E1-2.B', source: 'S1-CAUSA', target: 'S2-CAUSA', name: 'Demanda Regional-Zona Franca', desc: 'Carga regional demanda insumos y procesamiento en Zona Franca.' },\n864:       { id: 'E2-3.A', source: 'S2-EFECTO', target: 'S3-SÍNTOMA', name: 'Propagación N2 ➔ N3', desc: 'Bloqueo inter-local alimenta el Spillback sobre Av. Cali / Tintal.' },\n865:       { id: 'E2-3.B', source: 'S2-CAUSA', target: 'S3-CAUSA', name: 'Fricción Logístico-Distrital', desc: 'Tráfico de Zona Franca converge con rutas alimentadoras y SITP.' },\n866:       { id: 'E3-4.A', source: 'S3-EFECTO', target: 'S4-SÍNTOMA', name: 'Propagación N3 ➔ N4', desc: 'Parálisis en Kennedy entrampa la velocidad hiperlocal en Corabastos.' },\n867:       { id: 'E3-4.B', source: 'S4-CAUSA', target: 'S3-SÍNTOMA', name: 'Spillback Inverso N4 ➔ N3', desc: 'Demora en básculas genera la cola de retención de 3 km en Av. Cali.' },\n868:       { id: 'E4-1.A', source: 'S4-EFECTO', target: 'S1-EFECTO', name: 'Feedback Bloqueo Peri-Corabastos ➔ Entrada', desc: 'Ocupación informal peri-Corabastos tranca retornos hacia Accesos Periféricos.' },\n869:       { id: 'E2-4.A', source: 'S2-SÍNTOMA', targe