  ctx.fillText(line, xPos + 10, lineY);\n1228:             line = words[nIdx] + ' ';\n1229:             lineY += 13;\n1230:           } else {\n1231:             line = testLine;\n1232:           }\n1233:         }\n1234:         ctx.fillText(line, xPos + 10, lineY);\n1235: \n1236:         ctx.restore();\n1237:       });\n1238: \n1239:       requestAnimationFrame(render);\n1240:     }\n1241: \n1242:     // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n1243:     let subCanvasAnim = null;\n1244:     function openSubNetworkModal() {\n1245:       const subModal = document.getElementById('subnetworkModal');\n1246:       document.getElementById('subModalTitle').innerText = `Red Causal Interconectada Completa Matrioshka`;\n1247:       document.getElementById('subModalCode').innerText = `[System Dynamics Mesh]`;\n1248:       subModal.style.display = 'flex';\n1249:       renderSubNetworkCanvas();\n1250:     }\n1251: \n1252:     function closeSubNetworkModal() {\n1253:       document.getElementById('subnetworkModal').style.display = 'none';\n1254:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1255:     }\n1256: \n1257:     function renderSubNetworkCanvas() {\n1258:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1259: \n1260:       const subCanvas = document.getElementById('subCanvas');\n1261:       const wrap = subCanvas.parentElement;\n1262:       subCanvas.width = wrap.clientWidth;\n1263:       subCanvas.height = wrap.clientHeight;\n1264:       const sctx = subCanvas.getContext('2d');\n1265: \n1266:       const cx = subCanvas.width / 2;\n1267:       const cy = subCanvas.height / 2;\n1268: \n1269:       function loopSub() {\n1270:         sctx.fillStyle = '#000000';\n1271:         sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n1272: \n1273:         // Draw All Edges in 2D Mesh\n1274:         edges.forEach(e => {\n1275:           const s = e.sourceNode;\n1276:           const t = e.targetNode;\n1277:           if (!s || !t || !s.active || !t.active) return;\n1278: \n1279:           const sAngle = (s.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n1280:           const tAngle = (t.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n1281:           const sRad = 130 + (s.level * 55);\n1282:           const tRad = 130 + (t.level * 55);\n1283: \n1284:           const sx = cx + Math.cos(sAngle) * sRad;\n1285:           const sy = cy + Math.sin(sAngle) * sRad;\n1286:           const tx = cx + Math.cos(tAngle) * tRad;\n1287:           const ty = cy + Math.sin(tAngle) * tRad;\n1288: \n1289:           sctx.save();\n1290:           sctx.beginPath();\n1291:           sctx.moveTo(sx, sy);\n1292:           sctx.lineTo(tx, ty);\n1293:           sctx.strokeStyle = palette.levelColors[s.level];\n1294:           sctx.lineWidth = 1.5;\n1295:           sctx.globalAlpha = 0.6;\n1296:           sctx.stroke();\n1297:           sctx.restore();\n1298:         });\n1299: \n1300:         // Draw All Nodes in Concentric 2D Ring Mesh\n1301:         nodes.forEach(n => {\n1302:           if (!n.active) return;\n1303:           const angle = (n.nodeId / nodes.length) * Math.PI * 2 - Math.PI / 2;\n1304:           const radDist = 130 + (n.level * 55);\n1305:           const nx = cx + Math.cos(angle) * radDist;\n1306:           const ny = cy + Math.sin(angle) * radDist;\n1307: \n1308:           const triadBorder = n.triadRole === 'sintoma' ? '#E69888' : (n.triadRole === 'causa' ? '#E7C878' : '#C96349');\n1309:           const triadTag = n.triadRole === 'sintoma' ? '🔴 SÍNTOMA' : (n.triadRole === 'causa' ? '🟡 CAUSA' : '🟧 EFECTO');\n1310: \n1311:           sctx.save();\n1312:           sctx.fillStyle = '#06090f';\n1313:           sctx.beginPath();\n1314:           sctx.roundRect(nx - 75, ny - 20, 150, 40, 5);\n1315:           sctx.fill();\n1316:           sctx.strokeStyle = triadBorder;\n1317:           sctx.lineWidth = 1.8;\n1318:           sctx.stroke();\n1319: \n1320:           sctx.font = 'bold 8.5px monospace';\n1321:           sctx.fillStyle = triadBorder;\n1322:           sctx.textAlign = 'center';\n1323:           sctx.fillText(`[${n.id}] ${triadTag}`, nx, ny - 6);\n1324: \n1325:           sctx.font = '9px sans-serif';\n1326:           sctx.fillStyle = '#ffffff';\n1327:           sctx.fillText(n.shortLabel.substring(0, 22), nx, ny + 10);\n1328: \n1329:           sctx.restore();\n1330:         });\n1331: \n1332:         subCanvasAnim = requestAnimationFrame(loopSub);\n1333:       }\n1334: \n1335:       loopSub();\n1336:     }\n1337: \n1338:     // Mouse Controls (NO ANIMATIONS / STATIC ROTATION ONLY ON DRAG)\n1339:     canvas.addEventListener('mousedown', e => {\n1340:       isMouseDown = true;\n1341:       mouseBtn = e.button;\n1342:       lastX = e.clientX; lastY = e.clientY;\n1343:       clickStartX = e.clientX; clickStartY = e.clientY;\n1344:     });\n1345: \n1346:     window.addEventListener('mouseup', e => {\n1347:       isMouseDown = false;\n1348:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n1349:       if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n1350:         openInspector(hoveredNode);\n1351:       }\n1352:     });\n1353: \n1354:     canvas.addEventListener('dblclick', () => {\n1355:       if (hoveredNode) {\n1356:         hoveredNode.hiddenByUser = true;\n1357:         closeInspector();\n1358:         recalculateActiveNodes();\n1359:       }\n1360:     });\n1361: \n1362:     canvas.addEventListener('mousemove', e => {\n1363:       if (isMouseDown) {\n1364:         const dx = e.clientX - lastX;\n1365:         const dy = e.clientY - lastY;\n1366:         if (mouseBtn === 0) {\n1367:           targetRotY += dx * 0.004;\n1368:           targetRotX += dy * 0.004;\n1369:         } else if (mouseBtn === 2) {\n1370:           targetPanX += dx; targetPanY += dy;\n1371:         }\n1372:         lastX = e.clientX; lastY = e.clientY;\n1373:       } else {\n1374:         const mx = e.clientX, my = e.clientY;\n1375:         let closest = null, minDist = 40;\n1376:         nodes.forEach(n => {\n1377:           if (!n.active || !n.proj || !n.proj.visible) return;\n1378:           const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n1379:           if (d < minDist) { minDist = d; closest = n; }\n1380:         });\n1381:         hoveredNode = closest;\n1382:       }\n1383:     });\n1384: \n1385:     canvas.addEventListener('contextmenu', e => e.preventDefault());\n1386:     canvas.addEventListener('wheel', e => {\n1387:       e.preventDefault();\n1388:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n1389:       targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n1390:     }, { passive: false });\n1391: \n1392:     // Init\n1393:     buildTopology();\n1394:     requestAnimationFrame(render);\n1395:   </script>\n1396: </body>\n1397: </html>\n1398: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
