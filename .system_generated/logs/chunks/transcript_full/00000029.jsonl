     const h = canvas.height;\n1084: \n1085:       rotX += (targetRotX - rotX) * 0.12;\n1086:       rotY += (targetRotY - rotY) * 0.12;\n1087:       zoom += (targetZoom - zoom) * 0.12;\n1088:       panX += (targetPanX - panX) * 0.12;\n1089:       panY += (targetPanY - panY) * 0.12;\n1090: \n1091:       ctx.fillStyle = palette.bg;\n1092:       ctx.fillRect(0, 0, w, h);\n1093: \n1094:       if (opts.showSphere) {\n1095:         const radius = 280;\n1096:         const steps = 40;\n1097:         ctx.lineWidth = 1;\n1098: \n1099:         for (let i = 1; i < 5; i++) {\n1100:           const phi = (i / 5) * Math.PI;\n1101:           const rLat = radius * Math.sin(phi);\n1102:           const yLat = radius * Math.cos(phi);\n1103: \n1104:           ctx.strokeStyle = palette.sphere;\n1105:           ctx.beginPath();\n1106:           let first = true;\n1107:           for (let j = 0; j <= steps; j++) {\n1108:             const theta = (j / steps) * Math.PI * 2;\n1109:             const px = rLat * Math.cos(theta);\n1110:             const pz = rLat * Math.sin(theta);\n1111:             const p = project(px, yLat, pz, w, h);\n1112:             if (p.visible) {\n1113:               if (first) { ctx.moveTo(p.x, p.y); first = false; }\n1114:               else { ctx.lineTo(p.x, p.y); }\n1115:             }\n1116:           }\n1117:           ctx.stroke();\n1118:         }\n1119:       }\n1120: \n1121:       // NO ANIMATION / STATIC STABLE NODES\n1122:       nodes.forEach((n) => {\n1123:         if (!n.active) return;\n1124:         n.renderX = n.x;\n1125:         n.renderY = n.y;\n1126:         n.renderZ = n.z;\n1127:         n.proj = project(n.renderX, n.renderY, n.renderZ, w, h);\n1128:       });\n1129: \n1130:       if (opts.showEdges) {\n1131:         edges.forEach(e => {\n1132:           if (!e.active) return;\n1133:           const s = e.sourceNode;\n1134:           const t = e.targetNode;\n1135: \n1136:           if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.