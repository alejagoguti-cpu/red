t lz = tz + r * (Math.cos(angle) * uz + Math.sin(angle) * vz);\n\n          const leafId = nodes.length;\n          nodes.push({\n            id: leafId,\n            label: `AS${1000 + leafId}`,\n            x: lx, y: ly, z: lz,\n            ox: lx, oy: ly, oz: lz,\n            level: 2,\n            cluster: t\n          });\n          edges.push({ source: trunkId, target: leafId });\n\n          if (l % 4 === 0) {\n            const subCount = 5;\n            for (let s = 0; s < subCount; s++) {\n              const sa = angle + (s - 2) * 0.15;\n              const sr = r + 20;\n              const sx = tx + sr * (Math.cos(sa) * ux + Math.sin(sa) * vx);\n              const sy = ty + sr * (Math.cos(sa) * uy + Math.sin(sa) * vy);\n              const sz = tz + sr * (Math.cos(sa) * uz + Math.sin(sa) * vz);\n\n              const subId = nodes.length;\n              nodes.push({\n                id: subId,\n                label: `AS${5000 + subId}`,\n                x: sx, y: sy, z: sz,\n                ox: sx, oy: sy, oz: sz,\n                level: 3,\n                cluster: t\n              });\n              edges.push({ source: leafId, target: subId });\n            }\n          }\n        }\n      }\n\n      recalculateNodeSizes();\n    }\n\n    function buildLunesRepoLayout() {\n      nodes = [];\n      edges = [];\n      const root = { id: 0, label: 'LUNES-Repository', x: 0, y: 0, z: 0, level: 0, cluster: 0, isRoot: true };\n      nodes.push(root);\n\n      const modules = ['core', 'graphics', 'hyperbolic', 'physics', 'ui', 'network', 'shaders', 'math'];\n      modules.forEach((mod, idx) => {\n        const a = (idx / modules.length) * Math.PI * 2;\n        const rad = 200;\n        const mx = Math.cos(a) * rad;\n        const my = Math.sin(a * 2) * 60;\n        const mz = Math.sin(a) * rad;\n\n        const mId = nodes.length;\n        nodes.push({ id: mId, label: `mod_${mod}`, x: mx, y: my, z: mz, ox: mx, oy: my, oz: mz, level: 1, cluster: idx, isHub: true });\n        edges.push({ source: 0, target: mId });\n\n        for (let f = 0; f < 35; f++) {\n          const fa = (f / 35) * Math.PI * 2;\n          const fr = 45;\n          const fx = mx + Math.cos(fa) * fr;\n          const fy = my + (Math.random() - 0.5) * 40;\n          const fz = mz + Math.sin(fa) * fr;\n\n          const fId = nodes.length;\n          nodes.push({ id: fId, label: `${mod}_file_${f}.cpp`, x: fx, y: fy, z: fz, ox: fx, oy: fy, oz: fz, level: 2, cluster: idx });\n          edges.push({ source: mId, target: fId });\n        }\n      });\n\n      recalculateNodeSizes();\n    }\n\n    function loadGraph(type) {\n      if (type === 'walrus_caida' || type === 'dense_tree') buildWalrusH3Layout();\n      else if (type === 'lunes_repo') buildLunesRepoLayout();\n    }\n\n    // --- 3D Projection ---\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 650;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    // --- Render Loop ---\n    function render() {\n      animTime += 0.012;\n      const w = canvas.width;\n      const h = canvas.height;\n\n      if (opts.autoRotate && !isMouseDown) {\n        rotY += velY * opts.rotateSpeed;\n      } else if (!isMouseDown) {\n        rotY += velY;\n        rotX += velX;\n        velX *= 0.93;\n        velY *= 0.93;\n      }\n\n      const pal = palettes[opts.colorScheme] || palettes.caida_original;\n\n      // 1. Clear background\n      ctx.fillStyle = pal.bg;\n      ctx.fillRect(0, 0, w, h);\n\n      // 2. Spherical Boundary Wireframe\n      if (opts.showSphere) {\n        const radius = 250;\n        const steps = 48;\n        ctx.lineWidth = 1;\n\n        for (let i = 1; i < 7; i++) {\n          const phi = (i / 7) * Math.PI;\n          const rLat = radius * Math.sin(phi);\n          const yLat = radius * Math.cos(phi);\n\n          ctx.strokeStyle = pal.sphere;\n          ctx.beginPath();\n          let first = true;\n          for (let j = 0; j <= steps; j++) {\n            const theta = (j / steps) * Math.PI * 2;\n            const px = rLat * Math.cos(theta);\n            const pz = rLat * Math.sin(theta);\n            const p = project(px, yLat, pz, w, h);\n            if (p.visible) {\n              if (first) { ctx.moveTo(p.x, p.y); first = false; }\n              else { ctx.lineTo(p.x, p.y); }\n            }\n          }\n          ctx.stroke();\n        }\n\n        [0, Math.PI / 2].forEach(angle => {\n          ctx.strokeStyle = pal.sphereEquator;\n          ctx.beginPath();\n          let first = true;\n          for (let j = 0; j <= steps; j++) {\n            const a = (j / steps) * Math.PI * 2;\n            const px = radius * Math.cos(a);\n            const py = angle === 0 ? 0 : radius * Math.sin(a);\n            const pz = angle === 0 ? radius * Math.sin(a) : 0;\n            const p = project(px, py, pz, w, h);\n            if (p.visible) {\n              if (first) { ctx.moveTo(p.x, p.y); first = false; }\n              else { ctx.lineTo(p.x, p.y); }\n            }\n          }\n          ctx.stroke();\n        });\n      }\n\n      // 3. Project Nodes\n      nodes.forEach((n, idx) => {\n        if (!n.visible) return;\n        let rx = n.ox !== undefined ? n.ox : n.x;\n        let ry = n.oy !== undefined ? n.oy : n.y;\n        let rz = n.oz !== undefined ? n.oz : n.z;\n\n        if (opts.pulseMotion && !n.isRoot) {\n          const pulse = Math.sin(animTime * 1.8 + idx * 0.4) * 2;\n          rx += (rx / 200) * pulse;\n          ry += (ry / 200) * pulse;\n          rz += (rz / 200) * pulse;\n        }\n\n        n.proj = project(rx, ry, rz, w, h);\n      });\n\n      // 4. Draw Edges\n      if (opts.showEdges) {\n        ctx.lineWidth = 1;\n        edges.forEach(e => {\n          const s = nodes[e.source];\n          const t = nodes[e.target];\n\n          if (!s || !t || !s.visible || !t.visible || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n          const isHov = hoveredNode && (e.source === hoveredNode.id || e.target === hoveredNode.id);\n          ctx.strokeStyle = isHov ? pal.edgeActive : pal.edge;\n          ctx.lineWidth = isHov ? 2 : 1;\n\n          ctx.beginPath();\n          ctx.moveTo(s.proj.x, s.proj.y);\n          ctx.lineTo(t.proj.x, t.proj.y);\n          ctx.stroke();\n        });\n      }\n\n      // 5. Draw Nodes (Crisp Pixel Squares - Dynamic Size according to Connection Count!)\n      if (opts.showNodes) {\n        const sorted = [...nodes].filter(n => n.visible && n.proj).sort((a, b) => a.proj.z - b.proj.z);\n\n        sorted.forEach(n => {\n          if (!n.proj.visible) return;\n\n          const px = Math.round(n.proj.x);\n          const py = Math.round(n.proj.y);\n          \n          let color = pal.colors[n.cluster % pal.colors.length];\n          if (opts.colorScheme === 'degree_spectrum') {\n            if (n.degree > 30) color = '#ff0000';\n            else if (n.degree > 15) color = '#ff8000';\n            else if (n.degree > 5) color = '#ffff00';\n            else if (n.degree > 2) color = '#00ff00';\n            else color = '#3366ff';\n          }\n\n          const isHov = hoveredNode && hoveredNode.id === n.id;\n          ctx.fillStyle = isHov ? '#ffffff' : color;\n\n          // Size dynamically derived from connection count (degree)\n          let sz = n.renderedSize || 2;\n          if (isHov) sz += 3;\n\n          if (opts.nodeShape === 'square') {\n            ctx.fillRect(px - Math.floor(sz/2), py - Math.floor(sz/2), sz, sz);\n          } else {\n            ctx.beginPath();\n            ctx.arc(px, py, sz / 1.5, 0, Math.PI * 2);\n            ctx.fill();\n          }\n\n          if (isHov || opts.showLabels) {\n            ctx.font = \"11px 'MS Sans Serif', Tahoma, sans-serif\";\n            ctx.fillStyle = \"#ffffff\";\n            ctx.fillText(`${n.label} (${n.degree} conex.)`, px + sz + 4, py + 3);\n          }\n        });\n      }\n\n      requestAnimationFrame(render);\n    }\n\n    // --- Mouse Input Handlers ---\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true;\n      mouseButton = e.button;\n      lastX = e.clientX;\n      lastY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', () => { isMouseDown = false; });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX;\n        const dy = e.clientY - lastY;\n\n        if (mouseButton === 0) {\n          velY = dx * 0.003;\n          velX = dy * 0.003;\n          rotY += velY;\n          rotX += velX;\n        } else if (mouseButton === 2) {\n          panX += dx;\n          panY += dy;\n        }\n\n        lastX = e.clientX;\n        lastY = e.clientY;\n      } else {\n        const rect = canvas.getBoundingClientRect();\n        const mx = e.clientX - rect.left;\n        const my = e.clientY - rect.top;\n\n        let closest = null;\n        let minDist = 10;\n\n        nodes.forEach(n => {\n          if (!n.visible || !n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) {\n            minDist = d;\n            closest = n;\n          }\n        });\n\n        if (closest !== hoveredNode) {\n          hoveredNode = closest;\n          if (hoveredNode) {\n            statusText.innerText = `Selected Node: ${hoveredNode.label} (ID: ${hoveredNode.id}) | CONEXIONES (GRADO): ${hoveredNode.degree} | TAMAÑO: ${hoveredNode.renderedSize}px`;\n          } else {\n            statusText.innerText = `Graph loaded. Nodos visibles: ${nodes.filter(n=>n.visible).length}`;\n          }\n        }\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      zoom *= e.deltaY < 0 ? 1.1 : 0.9;\n      zoom = Math.max(100, Math.min(2000, zoom));\n    }, { passive: false });\n\n    function resetView() {\n      rotX = 0.25; rotY = 0.55; zoom = 400; panX = 0; panY = 0;\n      statusText.innerText = \"Camera reset to default.\";\n    }\n\n    function updateMenuCheckmarks() {\n      document.getElementById('mSphere').innerText = opts.showSphere ? '[✓]' : '[ ]';\n      document.getElementById('mEdges').innerText = opts.showEdges ? '[✓]' : '[ ]';\n      document.getElementById('mNodes').innerText = opts.showNodes ? '[✓]' : '[ ]';\n      document.getElementById('mLegend').innerText = opts.showLegend ? '[✓]' : '[ ]';\n      document.getElementById('mDegreeSizing').innerText = opts.degreeSizing ? '[✓]' : '[ ]';\n      document.getElementById('mFilterLeafs').innerText = opts.filterLeafs ? '[✓]' : '[ ]';\n      document.getElementById('legendBox').style.display = opts.showLegend ? 'block' : 'none';\n    }\n\n    function toggleOption(key) {\n      opts[key] = !opts[key];\n      updateMenuCheckmarks();\n      if (key === 'degreeSizing' || key === 'filterLeafs') {\n        recalculateNodeSizes();\n      }\n    }\n\n    function setColorScheme(scheme) {\n      opts.colorScheme = scheme;\n      statusText.innerText = `Color scheme set to: ${scheme}.`;\n    }\n\n    function openDialog(id) {\n      document.getElementById(id).style.display = 'block';\n    }\n    function closeDialog(id) {\n      document.getElementById(id).style.display = 'none';\n    }\n\n    // --- Init ---\n    buildWalrusH3Layout();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Adds toggleable conventions panel and dynamic degree-proportional node sizing math (Size ∝ √Connections).","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\hyperbolic_3d_network.html","toolAction":"Writing node sizing conventions update","toolSummary":"Update 3D graph with dynamic connection sizing and convention toggles"}}]}
