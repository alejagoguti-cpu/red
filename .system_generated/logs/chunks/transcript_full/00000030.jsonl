{"step_index":932,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T20:30:54Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Visualizador interactivo 3D del ecosistema de Actores del Turismo en Valparaíso basado en la imagen de la infografía radial de esferas y burbujas concéntricas.","UserFacing":true},"CodeContent":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Ecosistema de Actores del Turismo en Valparaíso - Red 3D</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body, html {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background-color: #000000;\n      color: #f1f5f9;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      font-size: 12px;\n      user-select: none;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    #viewport {\n      width: 100%;\n      height: 100%;\n      display: block;\n      cursor: grab;\n    }\n    #viewport:active {\n      cursor: grabbing;\n    }\n\n    .glass-panel {\n      background: rgba(6, 9, 15, 0.92);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 8px;\n      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.85);\n    }\n\n    .top-header {\n      position: absolute;\n      top: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .brand-title {\n      padding: 8px 16px;\n      font-weight: 800;\n      letter-spacing: 0.5px;\n      color: #E7C878;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 12px;\n      text-transform: uppercase;\n      pointer-events: auto;\n    }\n\n    .nav-group {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      pointer-events: auto;\n    }\n\n    .btn-flat {\n      background: rgba(255, 255, 255, 0.04);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      color: #cbd5e1;\n      padding: 7px 12px;\n      border-radius: 6px;\n      font-size: 11px;\n      font-weight: 600;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.15s ease;\n    }\n    .btn-flat:hover {\n      background: rgba(231, 200, 120, 0.15);\n      border-color: rgba(231, 200, 120, 0.4);\n      color: #ffffff;\n    }\n\n    /* Node Inspector Modal */\n    .node-inspector {\n      position: absolute;\n      top: 62px;\n      right: 12px;\n      width: 360px;\n      max-height: calc(100vh - 120px);\n      overflow-y: auto;\n      padding: 16px;\n      z-index: 120;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .node-title {\n      font-size: 14px;\n      font-weight: 800;\n      color: #E7C878;\n    }\n    .node-subtitle {\n      font-size: 10px;\n      color: #94a3b8;\n      font-family: monospace;\n      margin-top: 2px;\n    }\n\n    .btn-close {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-size: 12px;\n      color: #cbd5e1;\n    }\n    .btn-close:hover {\n      background: rgba(255, 0, 85, 0.3);\n      color: #ffffff;\n    }\n\n    .text-content {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 10px;\n      color: #cbd5e1;\n      font-size: 11px;\n      line-height: 1.45;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .status-badge {\n      padding: 6px 14px;\n      color: #94a3b8;\n      font-size: 10px;\n      letter-spacing: 0.4px;\n      pointer-events: auto;\n    }\n    .status-badge b {\n      color: #84a48b;\n      font-family: monospace;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- 3D Canvas Viewport -->\n  <canvas id=\"viewport\"></canvas>\n\n  <!-- Top Navigation Header -->\n  <div class=\"top-header\">\n    <div class=\"glass-panel brand-title\">\n      <span>🏛️ ACTORES DEL TURISMO EN LA CIUDAD DE VALPARAÍSO</span>\n    </div>\n\n    <div class=\"nav-group\">\n      <button class=\"btn-flat\" onclick=\"resetCamera()\">Restablecer Vista 3D</button>\n    </div>\n  </div>\n\n  <!-- Pop-Up Node Inspector Modal -->\n  <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div style=\"display:flex; align-items:flex-start; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:8px;\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Título de Actor</div>\n        <div class=\"node-subtitle\" id=\"mNodeCategory\">Categoría Ecosistémica</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div style=\"font-size:10px; text-transform:uppercase; color:#64748b; font-weight:700;\">Rol y Función Operativa</div>\n    <div class=\"text-content\" id=\"mNodeDesc\">Descripción del rol dentro del ecosistema turístico de Valparaíso.</div>\n\n    <div style=\"display:flex; justify-content:flex-end; margin-top:8px;\">\n      <button class=\"btn-flat\" style=\"background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.2); color:#cbd5e1;\" onclick=\"closeInspector()\">Cerrar</button>\n    </div>\n  </div>\n\n  <!-- Bottom Bar -->\n  <div class=\"bottom-bar\">\n    <div class=\"glass-panel status-badge\">\n      Categorías Ecosistémicas: <b>Públicos • Privados • Operadores • Oferta • Demanda • Espacio Geográfico</b>\n    </div>\n    <div class=\"glass-panel status-badge\">\n      💡 Clic en cualquier nodo para inspeccionar detalles • Drag para rotar 3D\n    </div>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    let rotX = 0.2, rotY = 0.3, zoom = 450;\n    let targetRotX = 0.2, targetRotY = 0.3, targetZoom = 450;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n    let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0, clickStartX = 0, clickStartY = 0;\n    let hoveredNode = null, selectedNode = null;\n\n    // Master dataset de la infografía \"Actores del Turismo en Valparaíso\"\n    const rawNodesData = [\n      // NODO CENTRAL MAESTRO\n      { id: 'CENTER', label: 'Ecosistema Turístico Valparaíso', category: 'Núcleo', color: '#E7C878', desc: 'Conjunto coordinado de actores públicos, privados, oferentes y demanda turística de la ciudad.', x: 0, y: 0, z: 0, radius: 42 },\n\n      // CLUSTER 1: PÚBLICOS\n      { id: 'PUB_MAIN', label: 'Sector Público', category: 'Públicos', color: '#E69888', desc: 'Instituciones del Estado con atribuciones reguladoras, de fomento y protección patrimonial.', x: -180, y: -180, z: -50, radius: 30 },\n      { id: 'PUB_MUN', label: 'Municipalidad de Valparaíso', category: 'Públicos', color: '#E69888', desc: 'Dirección de Turismo, gestión municipal local y proyectos urbanos comunales.', x: -240, y: -220, z: -70, radius: 22 },\n      { id: 'PUB_MIN_CULT', label: 'Ministerio de las Culturas', category: 'Públicos', color: '#E69888', desc: 'Consejo de Monumentos Nacionales, protección del sitio Patrimonio Mundial de la Humanidad UNESCO.', x: -160, y: -260, z: -30, radius: 20 },\n      { id: 'PUB_MIN_ECON', label: 'Ministerio de Economía', category: 'Públicos', color: '#E69888', desc: 'Subsecretaría de Turismo y SERNATUR, fomento al desarrollo económico del sector.', x: -280, y: -140, z: -90, radius: 20 },\n\n      // CLUSTER 2: PRIVADOS Y GREMIOS\n      { id: 'PRIV_MAIN', label: 'Sector Privado y Gremios', category: 'Privados', color: '#C96349', desc: 'Organizaciones gremiales, asociaciones hoteleras, gastronómicas y comercio local.', x: 180, y: -180, z: -50, radius: 30 },\n      { id: 'PRIV_GREM', label: 'Confederaciones y Gremios', category: 'Privados', color: '#C96349', desc: 'Cámara de Comercio y Turismo de Valparaíso, gremios de hotelería y gastronomía.', x: 250, y: -230, z: -70, radius: 22 },\n      { id: 'PRIV_ONG', label: 'ONGs y Fundaciones', category: 'Privados', color: '#C96349', desc: 'Organizaciones comunitarias para la conservación patrimonial y desarrollo sustentable.', x: 220, y: -120, z: -30, radius: 18 },\n\n      // CLUSTER 3: OPERADORES DE MERCADO\n      { id: 'OP_MAIN', label: 'Operadores de Mercado', category: 'Operadores', color: '#84A48B', desc: 'Empresas intermediarias que facilitan la relación entre la oferta y la demanda turística.', x: 0, y: -210, z: 80, radius: 32 },\n      { id: 'OP_AGEN', label: 'Agencias de Viaje y Receptivos', category: 'Operadores', color: '#84A48B', desc: 'Tour operadores locales y agencias comunitarias de guías de turismo.', x: -60, y: -270, z: 100, radius: 20 },\n      { id: 'OP_TOURS', label: 'Operadores de Tours Urbanos', category: 'Operadores', color: '#84A48B', desc: 'Rutas por cerros, ascensores patrimoniales, navegaciones en la bahía y circuitos culturales.', x: 60, y: -270, z: 100, radius: 20 },\n\n      // CLUSTER 4: OFERTA TURÍSTICA Y SERVICIOS\n      { id: 'OF_MAIN', label: 'Oferta Turística', category: 'Oferta', color: '#84A48B', desc: 'Conjunto de servicios, equipamientos y atractivos que conforman la experiencia del visitante.', x: 220, y: 120, z: 50, radius: 32 },\n      { id: 'OF_ALOJ', label: 'Alojamiento', category: 'Oferta', color: '#84A48B', desc: 'Hoteles boutique en cerros, hostales patrimoniales, departamentos y residenciales.', x: 290, y: 50, z: 30, radius: 22 },\n      { id: 'OF_GAST', label: 'Gastronomía y Cafés', category: 'Oferta', color: '#84A48B', desc: 'Restaurantes de mariscos, picadas tradicionales, cafeterías de especialidad y bares nocturnos.', x: 310, y: 140, z: 70, radius: 22 },\n      { id: 'OF_ATRACT', label: 'Atractivos y Servicios', category: 'Oferta', color: '#84A48B', desc: 'Ascensores declarados Monumento Histórico, museos (La Sebastiana), miradores y galerías.', x: 240, y: 220, z: 40, radius: 22 },\n\n      // CLUSTER 5: DEMANDA Y TURISTAS\n      { id: 'DEM_MAIN', label: 'Demanda Turística', category: 'Demanda', color: '#558E9B', desc: 'Perfil y flujo de visitantes nacionales e internacionales que consumen la oferta de la ciudad.', x: -220, y: 120, z: 50, radius: 32 },\n      { id: 'DEM_INT', label: 'Turistas Internacionales (76%)', category: 'Demanda', color: '#558E9B', desc: 'Visitantes de Europa, Norteamérica y Latinoamérica atraídos por la arquitectura y cultura.', x: -300, y: 60, z: 30, radius: 22 },\n      { id: 'DEM_NAC', label: 'Turistas Nacionales (24%)', category: 'Demanda', color: '#558E9B', desc: 'Visitantes de Santiago y regiones cercanas en fin de semana y vacaciones.', x: -310, y: 170, z: 70, radius: 22 },\n\n      // CLUSTER 6: ESPACIO GEOGRÁFICO Y POBLACIÓN RESIDENTE\n      { id: 'GEO_MAIN', label: 'Espacio Geográfico y Residentes', category: 'Espacio', color: '#A4C3B2', desc: 'Base física donde conviven los residentes de la ciudad con la actividad turística.', x: 0, y: 220, z: -60, radius: 32 },\n      { id: 'GEO_CERROS', label: 'Cerros Patrimoniales', category: 'Espacio', color: '#A4C3B2', desc: 'Cerro Alegre, Cerro Concepción, Cerro Artavia, Cerro Bellavista y sus miradores.', x: -90, y: 280, z: -80, radius: 20 },\n      { id: 'GEO_PLAN', label: 'Plan de la Ciudad y Borde Costero', category: 'Espacio', color: '#A4C3B2', desc: 'Sector Almendral, Barrio Puerto, Plaza Sotomayor y frente marítimo del puerto.', x: 90, y: 280, z: -80, radius: 20 }\n    ];\n\n    const edges = [\n      { source: 'CENTER', target: 'PUB_MAIN' },\n      { source: 'CENTER', target: 'PRIV_MAIN' },\n      { source: 'CENTER', target: 'OP_MAIN' },\n      { source: 'CENTER', target: 'OF_MAIN' },\n      { source: 'CENTER', target: 'DEM_MAIN' },\n      { source: 'CENTER', target: 'GEO_MAIN' },\n\n      { source: 'PUB_MAIN', target: 'PUB_MUN' },\n      { source: 'PUB_MAIN', target: 'PUB_MIN_CULT' },\n      { source: 'PUB_MAIN', target: 'PUB_MIN_ECON' },\n\n      { source: 'PRIV_MAIN', target: 'PRIV_GREM' },\n      { source: 'PRIV_MAIN', target: 'PRIV_ONG' },\n\n      { source: 'OP_MAIN', target: 'OP_AGEN' },\n      { source: 'OP_MAIN', target: 'OP_TOURS' },\n\n      { source: 'OF_MAIN', target: 'OF_ALOJ' },\n      { source: 'OF_MAIN', target: 'OF_GAST' },\n      { source: 'OF_MAIN', target: 'OF_ATRACT' },\n\n      { source: 'DEM_MAIN', target: 'DEM_INT' },\n      { source: 'DEM_MAIN', target: 'DEM_NAC' },\n\n      { source: 'GEO_MAIN', target: 'GEO_CERROS' },\n      { source: 'GEO_MAIN', target: 'GEO_PLAN' },\n\n      // Interconexiones cruzadas de ecosistema\n      { source: 'OP_MAIN', target: 'OF_MAIN' },\n      { source: 'DEM_MAIN', target: 'OP_MAIN' },\n      { source: 'OF_MAIN', target: 'GEO_MAIN' },\n      { source: 'PUB_MAIN', target: 'PRIV_MAIN' }\n    ];\n\n    let nodes = [];\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function initTopology() {\n      const nodeMap = new Map();\n      nodes = rawNodesData.map((d, idx) => {\n        const n = { ...d, nodeId: idx };\n        nodeMap.set(d.id, n);\n        return n;\n      });\n\n      edges.forEach(e => {\n        e.sourceNode = nodeMap.get(e.source);\n        e.targetNode = nodeMap.get(e.target);\n      });\n    }\n\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 600;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    function resetCamera() {\n      targetRotX = 0.2; targetRotY = 0.3; targetZoom = 450; targetPanX = 0; targetPanY = 0;\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      document.getElementById('mNodeTitle').innerText = node.label;\n      document.getElementById('mNodeCategory').innerText = `Categoría: ${node.category}`;\n      document.getElementById('mNodeDesc').innerText = node.desc;\n      document.getElementById('nodeInspector').style.display = 'flex';\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function render() {\n      const w = canvas.width, h = canvas.height;\n\n      rotX += (targetRotX - rotX) * 0.12;\n      rotY += (targetRotY - rotY) * 0.12;\n      zoom += (targetZoom - zoom) * 0.12;\n      panX += (targetPanX - panX) * 0.12;\n      panY += (targetPanY - panY) * 0.12;\n\n      ctx.fillStyle = '#000000';\n      ctx.fillRect(0, 0, w, h);\n\n      // Project Nodes\n      nodes.forEach(n => {\n        n.proj = project(n.x, n.y, n.z, w, h);\n      });\n\n      // Render Edges\n      edges.forEach(e => {\n        const s = e.sourceNode, t = e.targetNode;\n        if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n        const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n        const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(s.proj.x, s.proj.y);\n        ctx.lineTo(t.proj.x, t.proj.y);\n        ctx.strokeStyle = (isHov || isSel) ? '#E7C878' : 'rgba(255, 255, 255, 0.15)';\n        ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.2;\n        ctx.stroke();\n        ctx.restore();\n      });\n\n      // Sort Nodes by Z Depth\n      const sorted = [...nodes].filter(n => n.proj && n.proj.visible).sort((a, b) => a.proj.z - b.proj.z);\n\n      // Render Bubble Spheres\n      sorted.forEach(n => {\n        const px = Math.round(n.proj.x);\n        const py = Math.round(n.proj.y);\n        const scale = n.proj.scale || 1.0;\n        const rad = Math.max(12, Math.round(n.radius * scale));\n\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n\n        ctx.save();\n        \n        // Sphere Radial Gradient\n        const grad = ctx.createRadialGradient(px - rad * 0.3, py - rad * 0.3, rad * 0.1, px, py, rad);\n        grad.addColorStop(0, '#ffffff');\n        grad.addColorStop(0.4, n.color);\n        grad.addColorStop(1, '#050505');\n\n        ctx.fillStyle = grad;\n        ctx.beginPath();\n        ctx.arc(px, py, rad, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Stroke\n        ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : 'rgba(255,255,255,0.4)';\n        ctx.lineWidth = (isHov || isSel) ? 3 : 1.2;\n        ctx.stroke();\n\n        // Label\n        ctx.font = isHov || isSel ? 'bold 11px -apple-system, sans-serif' : '10px -apple-system, sans-serif';\n        ctx.fillStyle = (isHov || isSel) ? '#ffffff' : '#cbd5e1';\n        ctx.textAlign = 'center';\n        ctx.fillText(n.label, px, py + rad + 14);\n\n        ctx.restore();\n      });\n\n      requestAnimationFrame(render);\n    }\n\n    // Controls\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true; mouseBtn = e.button;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX, dy = e.clientY - lastY;\n        if (mouseBtn === 0) {\n          targetRotY += dx * 0.004;\n          targetRotX += dy * 0.004;\n        } else if (mouseBtn === 2) {\n          targetPanX += dx; targetPanY += dy;\n        }\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const mx = e.clientX, my = e.clientY;\n        let closest = null, minDist = 35;\n        nodes.forEach(n => {\n          if (!n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    initTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Creación de la Red 3D interactiva para los Actores del Turismo en Valparaíso basada en el modelo de infografía radial de esferas subidas por el usuario.","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\red_actores_turismo_valparaiso.html","toolAction":"Creating interactive 3D network for Valparaíso Tourism Actors","toolSummary":"Create Valparaiso network html"}}]}
