44: \n245:       // CLUSTER 3: OPERADORES DE MERCADO\n246:       { id: 'OP_MAIN', label: 'Operadores de Mercado', category: 'Operadores', color: '#84A48B', desc: 'Empresas intermediarias que facilitan la relación entre la oferta y la demanda turística.', x: 0, y: -210, z: 80, radius: 32 },\n247:       { id: 'OP_AGEN', label: 'Agencias de Viaje y Receptivos', category: 'Operadores', color: '#84A48B', desc: 'Tour operadores locales y agencias comunitarias de guías de turismo.', x: -60, y: -270, z: 100, radius: 20 },\n248:       { id: 'OP_TOURS', label: 'Operadores de Tours Urbanos', category: 'Operadores', color: '#84A48B', desc: 'Rutas por cerros, ascensores patrimoniales, navegaciones en la bahía y circuitos culturales.', x: 60, y: -270, z: 100, radius: 20 },\n249: \n250:       // CLUSTER 4: OFERTA TURÍSTICA Y SERVICIOS\n251:       { id: 'OF_MAIN', label: 'Oferta Turística', category: 'Oferta', color: '#84A48B', desc: 'Conjunto de servicios, equipamientos y atractivos que conforman la experiencia del visitante.', x: 220, y: 120, z: 50, radius: 32 },\n252:       { id: 'OF_ALOJ', label: 'Alojamiento', category: 'Oferta', color: '#84A48B', desc: 'Hoteles boutique en cerros, hostales patrimoniales, departamentos y residenciales.', x: 290, y: 50, z: 30, radius: 22 },\n253:       { id: 'OF_GAST', label: 'Gastronomía y Cafés', category: 'Oferta', color: '#84A48B', desc: 'Restaurantes de mariscos, picadas tradicionales, cafeterías de especialidad y bares nocturnos.', x: 310, y: 140, z: 70, radius: 22 },\n254:       { id: 'OF_ATRACT', label: 'Atractivos y Servicios', category: 'Oferta', color: '#84A48B', desc: 'Ascensores declarados Monumento Histórico, museos (La Sebastiana), miradores y galerías.', x: 240, y: 220, z: 40, radius: 22 },\n255: \n256:       // CLUSTER 5: DEMANDA Y TURISTAS\n257:       { id: 'DEM_MAIN', label: 'Demanda Turística', category: 'Demanda', color: '#558E9B', desc: 'Perfil y flujo de visitantes nacionales e internacionales que consumen la oferta de la ciudad.', x: -220, y: 120, z: 50, radius: 32 },\n258:       { id: 'DEM_INT', label: 'Turistas Internacionales (76%)', category: 'Demanda', color: '#558E9B', desc: 'Visitantes de Europa, Norteamérica y Latinoamérica atraídos por la arquitectura y cultura.', x: -300, y: 60, z: 30, radius: 22 },\n259:       { id: 'DEM_NAC', label: 'Turistas Nacionales (24%)', category: 'Demanda', color: '#558E9B', desc: 'Visitantes de Santiago y regiones cercanas en fin de semana y vacaciones.', x: -310, y: 170, z: 70, radius: 22 },\n260: \n261:       // CLUSTER 6: ESPACIO GEOGRÁFICO Y POBLACIÓN RESIDENTE\n262:       { id: 'GEO_MAIN', label: 'Espacio Geográfico y Residentes', category: 'Espacio', color: '#A4C3B2', desc: 'Base física donde conviven los residentes de la ciudad con la actividad turística.', x: 0, y: 220, z: -60, radius: 32 },\n263:       { id: 'GEO_CERROS', label: 'Cerros Patrimoniales', category: 'Espacio', color: '#A4C3B2', desc: 'Cerro Alegre, Cerro Concepción, Cerro Artavia, Cerro Bellavista y sus miradores.', x: -90, y: 280, z: -80, radius: 20 },\n264:       { id: 'GEO_PLAN', label: 'Plan de la Ciudad y Borde Costero', category: 'Espacio', color: '#A4C3B2', desc: 'Sector Almendral, Barrio Puerto, Plaza Sotomayor y frente marítimo del puerto.', x: 90, y: 280, z: -80, radius: 20 }\n265:     ];\n266: \n267:     const edges = [\n268:       { source: 'CENTER', target: 'PUB_MAIN' },\n269:       { source: 'CENTER', target: 'PRIV_MAIN' },\n270:       { source: 'CENTER', target: 'OP_MAIN' },\n271:       { source: 'CENTER', target: 'OF_MAIN' },\n272:       { source: 'CENTER', target: 'DEM_MAIN' },\n273:       { source: 'CENTER', target: 'GEO_MAIN' },\n274: \n275:       { source: 'PUB_MAIN', target: 'PUB_MUN' },\n276:       { source: 'PUB_MAIN', target: 'PUB_MIN_CULT' },\n277:       { source: 'PUB_MAIN', target: 'PUB_MIN_ECON' },\n278: \n279:       { source: 'PRIV_MAIN', target: 'PRIV_GREM' },\n280:       { source: 'PRIV_MAIN', target: 'PRIV_ONG' },\n281: \n282:       { source: 'OP_MAIN', target: 'OP_AGEN' },\n283:       { source: 'OP_MAIN', target: 'OP_TOURS' },\n284: \n285:       { source: 'OF_MAIN', target: 'OF_ALOJ' },\n286:       { source: 'OF_MAIN', target: 'OF_GAST' },\n287:       { source: 'OF_MAIN', target: 'OF_ATRACT' },\n288: \n289:       { source: 'DEM_MAIN', target: 'DEM_INT' },\n290:       { source: 'DEM_MAIN', target: 'DEM_NAC' },\n291: \n292:       { source: 'GEO_MAIN', target: 'GEO_CERROS' },\n293:       { source: 'GEO_MAIN', target: 'GEO_PLAN' },\n294: \n295:       // Interconexiones cruzadas de ecosistema\n296:       { source: 'OP_MAIN', target: 'OF_MAIN' },\n297:       { source: 'DEM_MAIN', target: 'OP_MAIN' },\n298:       { source: 'OF_MAIN', target: 'GEO_MAIN' },\n299:       { source: 'PUB_MAIN', target: 'PRIV_MAIN' }\n300:     ];\n301: \n302:     let nodes = [];\n303: \n304:     function resize() {\n305:       canvas.width = window.innerWidth;\n306:       canvas.height = window.innerHeight;\n307:     }\n308:     window.addEventListener('resize', resize);\n309:     resize();\n310: \n311:     function initTopology() {\n312:       const nodeMap = new Map();\n313:       nodes = rawNodesData.map((d, idx) => {\n314:         const n = { ...d, nodeId: idx };\n315:         nodeMap.set(d.id, n);\n316:         return n;\n317:       });\n318: \n319:       edges.forEach(e => {\n320:         e.sourceNode = nodeMap.get(e.source);\n321:         e.targetNode = nodeMap.get(e.target);\n322:       });\n323:     }\n324: \n325:     function project(x, y, z, w, h) {\n326:       const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n327:       const x1 = x * cosY + z * sinY;\n328:       const z1 = -x * sinY + z * cosY;\n329: \n330:       const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n331:       const y2 = y * cosX - z1 * sinX;\n332:       const z2 = y * sinX + z1 * cosX;\n333: \n334:       const cx = x1 + panX;\n335:       const cy = y2 + panY;\n336: \n337:       const dist = 600;\n338:       const scale = zoom / (z2 + dist);\n339: \n340:       return {\n341:         x: w / 2 + cx * scale,\n342:         y: h / 2 + cy * scale,\n343:         z: z2,\n344:         scale,\n345:         visible: (z2 + dist) > 10\n346:       };\n347:     }\n348: \n349:     function resetCamera() {\n350:       targetRotX = 0.2; targetRotY = 0.3; targetZoom = 450; targetPanX = 0; targetPanY = 0;\n351:     }\n352: \n353:     function openInspector(node) {\n354:       selectedNode = node;\n355:       document.getElementById('mNodeTitle').innerText = node.label;\n356:       document.getElementById('mNodeCategory').innerText = `Categoría: ${node.category}`;\n357:       document.getElementById('mNodeDesc').innerText = node.desc;\n358:       document.getElementById('nodeInspector').style.display = 'flex';\n359:     }\n360: \n361:     function closeInspector() {\n362:       selectedNode = null;\n363:       document.getElementById('nodeInspector').style.display = 'none';\n364:     }\n365: \n366:     function render() {\n367:       const w = canvas.width, h = canvas.height;\n368: \n369:       rotX += (targetRotX - rotX) * 0.12;\n370:       rotY += (targetRotY - rotY) * 0.12;\n371:       zoom += (targetZoom - zoom) * 0.12;\n372:       panX += (targetPanX - panX) * 0.12;\n373:       panY += (targetPanY - panY) * 0.12;\n374: \n375:       ctx.fillStyle = '#000000';\n376:       ctx.fillRect(0, 0, w, h);\n377: \n378:       // Project Nodes\n379:       nodes.forEach(n => {\n380:         n.proj = project(n.x, n.y, n.z, w, h);\n381:       });\n382: \n383:       // Render Edges\n384:       edges.forEach(e => {\n385:         const s = e.sourceNode, t = e.targetNode;\n386:         if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n387: \n388:         const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n389:         const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n390: \n391:         ctx.save();\n392:         ctx.beginPath();\n393:         ctx.moveTo(s.proj.x, s.proj.y);\n394:         ctx.lineTo(t.proj.x, t.proj.y);\n395:         ctx.strokeStyle = (isHov || isSel) ? '#E7C878' : 'rgba(255, 255, 255, 0.15)';\n396:         ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.2;\n397:         ctx.stroke();\n398:         ctx.restore();\n399:       });\n400: \n401:       // Sort Nodes by Z Depth\n402:       const sorted = [...nodes].filter(n => n.proj && n.proj.visible).sort((a, b) => a.proj.z - b.proj.z);\n403: \n404:       // Render Bubble Spheres\n405:       sorted.forEach(n => {\n406:         const px = Math.round(n.proj.x);\n407:         const py = Math.round(n.proj.y);\n408:         const scale = n.proj.scale || 1.0;\n409:         const rad = Math.max(12, Math.round(n.radius * scale));\n410: \n411:         const isHov = hoveredNode && hoveredNode.id === n.id;\n412:         const isSel = selectedNode && selectedNode.id === n.id;\n413: \n414:         ctx.save();\n415:         \n416:         // Sphere Radial Gradient\n417:         const grad = ctx.createRadialGradient(px - rad * 0.3, py - rad * 0.3, rad * 0.1, px, py, rad);\n418:         grad.addColorStop(0, '#ffffff');\n419:         grad.addColorStop(0.4, n.color);\n420:         grad.addColorStop(1, '#050505');\n421: \n422:         ctx.fillStyle = grad;\n423:         ctx.beginPath();\n424:         ctx.arc(px, py, rad, 0, Math.PI * 2);\n425:         ctx.fill();\n426: \n427:         // Stroke\n428:         ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : 'rgba(255,255,255,0.4)';\n429:         ctx.lineWidth = (isHov || isSel) ? 3 : 1.2;\n430:         ctx.stroke();\n431: \n432:         // Label\n433:         ctx.font = isHov || isSel ? 'bold 11px -apple-system, sans-serif' : '10px -apple-system, sans-serif';\n434:         ctx.fillStyle = (isHov || isSel) ? '#ffffff' : '#cbd5e1';\n435:         ctx.textAlign = 'center';\n436:         ctx.fillText(n.label, px, py + rad + 14);\n437: \n438:         ctx.restore();\n439:       });\n440: \n441:       requestAnimationFrame(render);\n442:     }\n443: \n444:     // Controls\n445:     canvas.addEventListener('mousedown', e => {\n446:       isMouseDown = true; mouseBtn = e.button;\n447:       lastX = e.clientX; lastY = e.clientY;\n448:       clickStartX = e.clientX; clickStartY = e.clientY;\n449:     });\n450: \n451:     window.addEventListener('mouseup', e => {\n452:       isMouseDown = false;\n453:       const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n454:       if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n455:         openInspector(hoveredNode);\n456:       }\n457:     });\n458: \n459:     canvas.addEventListener('mousemove', e => {\n460:       if (isMouseDown) {\n461:         const dx = e.clientX - lastX, dy = e.clientY - lastY;\n462:         if (mouseBtn === 0) {\n463:           targetRotY += dx * 0.004;\n464:           targetRotX += dy * 0.004;\n465:         } else if (mouseBtn === 2) {\n466:           targetPanX += dx; targetPanY += dy;\n467:         }\n468:         lastX = e.clientX; lastY = e.clientY;\n469:       } else {\n470:         const mx = e.clientX, my = e.clientY;\n471:         let closest = null, minDist = 35;\n472:         nodes.forEach(n => {\n473:           if (!n.proj || !n.proj.visible) return;\n474:           const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n475:           if (d < minDist) { minDist = d; closest = n; }\n476:         });\n477:         hoveredNode = closest;\n478:       }\n479:     });\n480: \n481:     canvas.addEventListener('contextmenu', e => e.preventDefault());\n482:     canvas.addEventListener('wheel', e => {\n483:       e.preventDefault();\n484:       const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n485:       targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n486:     }, { passive: false });\n487: \n488:     initTopology();\n489:     requestAnimationFrame(render);\n490:   </script>\n491: </body>\n492: </html>\n493: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":944,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T20:38:26Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Red Causal Matrioshka 3D estática de Actores del Turismo en Valparaíso con tarjetas rectangulares y estructura Síntoma -> Causa -> Efecto por cada nivel.","UserFacing":true},"CodeContent":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Red Causal Matrioshka: Actores del Turismo en Valparaíso</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body, html {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background-color: #000000;\n      color: #f1f5f9;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      font-size: 12px;\n      user-select: none;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    #viewport {\n      width: 100%;\n      height: 100%;\n      display: block;\n      cursor: crosshair;\n    }\n\n    .glass-panel {\n      background: rgba(6, 9, 15, 0.92);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 8px;\n      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.85);\n    }\n\n    .top-header {\n      position: absolute;\n      top: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .brand-title {\n      padding: 8px 14px;\n      font-weight: 800;\n      letter-spacing: 0.5px;\n      color: #E7C878;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 12px;\n      text-transform: uppercase;\n      pointer-events: auto;\n    }\n\n    .nav-group {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      pointer-events: auto;\n    }\n\n    .btn-flat {\n      background: rgba(255, 255, 255, 0.04);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      color: #cbd5e1;\n      padding: 7px 12px;\n      border-radius: 6px;\n      font-size: 11px;\n      font-weight: 600;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.15s ease;\n    }\n    .btn-flat:hover {\n      background: rgba(231, 200, 120, 0.15);\n      border-color: rgba(231, 200, 120, 0.4);\n      color: #ffffff;\n    }\n\n    /* Inspector Drawer */\n    .node-inspector {\n      position: absolute;\n      top: 62px;\n      right: 12px;\n      width: 380px;\n      max-height: calc(100vh - 120px);\n      overflow-y: auto;\n      padding: 16px;\n      z-index: 120;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .node-title {\n      font-size: 13.5px;\n      font-weight: 800;\n      color: #E7C878;\n      line-height: 1.35;\n    }\n    .node-subtitle {\n      font-size: 10px;\n      color: #94a3b8;\n      font-family: monospace;\n      margin-top: 2px;\n    }\n\n    .triad-badge {\n      display: inline-block;\n      padding: 3px 8px;\n      border-radius: 4px;\n      font-size: 9.5px;\n      font-weight: 800;\n      letter-spacing: 0.5px;\n      text-transform: uppercase;\n      margin-top: 4px;\n    }\n    .triad-sintoma { background: rgba(230, 152, 136, 0.2); border: 1px solid #E69888; color: #E69888; }\n    .triad-causa { background: rgba(231, 200, 120, 0.2); border: 1px solid #E7C878; color: #E7C878; }\n    .triad-efecto { background: rgba(201, 99, 73, 0.2); border: 1px solid #C96349; color: #C96349; }\n\n    .btn-close {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      font-size: 12px;\n      color: #cbd5e1;\n    }\n\n    .text-content {\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 6px;\n      padding: 8px 10px;\n      color: #cbd5e1;\n      font-size: 11px;\n      line-height: 1.45;\n    }\n\n    .bottom-bar {\n      position: absolute;\n      bottom: 12px;\n      left: 12px;\n      right: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      z-index: 100;\n    }\n\n    .status-badge {\n      padding: 6px 14px;\n      color: #94a3b8;\n      font-size: 10px;\n      letter-spacing: 0.4px;\n      pointer-events: auto;\n    }\n    .status-badge b {\n      color: #84a48b;\n      font-family: monospace;\n    }\n  </style>\n</head>\n<body>\n\n  <canvas id=\"viewport\"></canvas>\n\n  <div class=\"top-header\">\n    <div class=\"glass-panel brand-title\">\n      <span>🏛️ RED CAUSAL MATRIOSHKA: ACTORES DEL TURISMO EN VALPARAÍSO</span>\n    </div>\n\n    <div class=\"nav-group\">\n      <button class=\"btn-flat\" onclick=\"resetCamera()\">Restablecer Vista 3D</button>\n    </div>\n  </div>\n\n  <!-- Inspector Modal -->\n  <div class=\"glass-panel node-inspector\" id=\"nodeInspector\" style=\"display:none;\">\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:8px;\">\n      <div>\n        <div class=\"node-title\" id=\"mNodeTitle\">Título Nodo</div>\n        <div class=\"node-subtitle\" id=\"mNodeCode\">ID Nodo</div>\n        <div id=\"mTriadBadge\" class=\"triad-badge triad-sintoma\">SÍNTOMA</div>\n      </div>\n      <div class=\"btn-close\" onclick=\"closeInspector()\">×</div>\n    </div>\n\n    <div style=\"font-size:9.5px; text-transform:uppercase; color:#64748b; font-weight:700;\">Diagnóstico & Función</div>\n    <div class=\"text-content\" id=\"mFunction\">Descripción</div>\n\n    <div style=\"font-size:9.5px; text-transform:uppercase; color:#64748b; font-weight:700;\">Impacto en el Ecosistema</div>\n    <div class=\"text-content\" id=\"mImpact\">Impacto</div>\n\n    <div style=\"display:flex; justify-content:flex-end; gap:6px;\">\n      <button class=\"btn-flat\" onclick=\"closeInspector()\">Cerrar</button>\n    </div>\n  </div>\n\n  <div class=\"bottom-bar\">\n    <div class=\"glass-panel status-badge\">\n      Niveles Matrioshka: <b>N1 Macro Estatal • N2 Gremios & Privados • N3 Mercado & Oferta • N4 Espacio Cerros & Residentes</b>\n    </div>\n    <div class=\"glass-panel status-badge\">\n      💡 Nodos rectangulares estáticos con texto integrado • Drag para rotar\n    </div>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('viewport');\n    const ctx = canvas.getContext('2d');\n\n    let rotX = 0.35, rotY = 0.65, zoom = 480;\n    let targetRotX = 0.35, targetRotY = 0.65, targetZoom = 480;\n    let panX = 0, panY = 0, targetPanX = 0, targetPanY = 0;\n    let isMouseDown = false, mouseBtn = 0, lastX = 0, lastY = 0, clickStartX = 0, clickStartY = 0;\n    let hoveredNode = null, selectedNode = null;\n\n    const palette = {\n      bg: '#000000',\n      levelColors: {\n        1: '#C96349', // N1 Macro\n        2: '#E69888', // N2 Gremios\n        3: '#E7C878', // N3 Oferta\n        4: '#84A48B'  // N4 Espacio\n      }\n    };\n\n    // Master dataset de Valparaíso adaptado a la lógica MATRIOSHKA (Síntoma - Causa - Efecto)\n    const rawNodesData = [\n      // === NIVEL 1: MACRO ESTATAL / POLÍTICA NACIONAL ===\n      {\n        id: 'VAL-N1-S',\n        name: 'Fragmentación en la Regulación del Sitio Patrimonio UNESCO',\n        shortLabel: 'Fragmentación Sitio UNESCO Valparaíso',\n        level: 1,\n        triadRole: 'sintoma',\n        function: 'Falta de ventanilla única entre Ministerio de las Culturas, SERNATUR y Gobierno Central.',\n        impact: 'Deterioro acelerado del casco histórico e inseguridad jurídica para inversionistas patrimoniales.',\n        x: -260, y: -180, z: -180\n      },\n      {\n        id: 'VAL-N1-C',\n        name: 'Burocracia Centralizada & Presupuesto Desarticulado',\n        shortLabel: 'Burocracia Centralizada Subsecretaría',\n        level: 1,\n        triadRole: 'causa',\n        function: 'Subsecretaría de Turismo y SERNATUR operan de forma desconectada de las necesidades comunales.',\n        impact: 'Retraso en la ejecución del Plan Maestro de Desarrollo Turístico Sustentable.',\n        x: -200, y: -120, z: -120\n      },\n      {\n        id: 'VAL-N1-E',\n        name: 'Pérdida de Competitividad Internacional de Valparaíso',\n        shortLabel: 'Pérdida Competitividad Marca Ciudad',\n        level: 1,\n        triadRole: 'efecto',\n        function: 'Disminución relativa en la llegada de visitantes internacionales de estancia prolongada.',\n        impact: 'Transferencia de flujo turístico hacia otros destinos regionales emergentes.',\n        x: -140, y: -60, z: -60\n      },\n\n      // === NIVEL 2: GREMIOS & ASOCIACIONES PRIVADAS ===\n      {\n        id: 'VAL-N2-S',\n        name: 'Fricción Operativa Comercio Formal vs. Informalidad',\n        shortLabel: 'Fricción Formalidad vs Informalidad',\n        level: 2,\n        triadRole: 'sintoma',\n        catName: 'Síntoma - N2 Gremios',\n        function: 'Conflicto entre la Cámara de Comercio y la ocupación no regulada del espacio público en el Plan.',\n        impact: 'Cierre de locales tradicionales en Barrio Puerto y sector Almendral.',\n        x: 140, y: -140, z: -140\n      },\n      {\n        id: 'VAL-N2-C',\n        name: 'Débil Articulación Gremial y Falta de Protocolos Unificados',\n        shortLabel: 'Sin Protocolo Integrado Comercio-Hoteles',\n        level: 2,\n        triadRole: 'causa',\n        function: 'Desconexión entre la Asociación de Hoteles Boutique y los gremios gastronómicos.',\n        impact: 'Oferta dispersa sin estándares homogéneos de calidad y servicio.',\n        x: 190, y: -80, z: -80\n      },\n      {\n        id: 'VAL-N2-E',\n        name: 'Fuga de Capitales y Cierre de Establecimientos Históricos',\n        shortLabel: 'Fuga de Inversión en Comercio Tradicional',\n        level: 2,\n        triadRole: 'efecto',\n        function: 'Desinversión en restauración de inmuebles de conservación histórica.',\n        impact: 'Abandono de fachadas e incremento del riesgo de deterioro estructural.',\n        x: 240, y: -20, z: -20\n      },\n\n      // === NIVEL 3: MERCADO, OPERADORES & OFERTA TURÍSTICA ===\n      {\n        id: 'VAL-N3-S',\n        name: 'Predominio de Turismo \"Pasadía\" de Bajo Retorno Económico',\n        shortLabel: 'Predominio Turista Pasadía (Sin Pernoctar)',\n        level: 3,\n        triadRole: 'sintoma',\n        function: 'Visitantes que permanecen menos de 6 horas en la ciudad sin consumir hotelería.',\n        impact: 'Baja tasa de ocupación en la planta hotelera de los cerros Alegre y Concepción.',\n        x: -90, y: 70, z: 50\n      },\n      {\n        id: 'VAL-N3-C',\n        name: 'Inoperatividad Parcial de Ascensores Patrimoniales',\n        shortLabel: 'Ascensores Fuera de Servicio (Báscula/Conexión)',\n        level: 3,\n        triadRole: 'causa',\n        function: 'Paro técnico y mantenimiento tardío en los elevadores históricos de la ciudad.',\n        impact: 'Desconexión física entre el Plan de la Ciudad y la red de miradores en los Cerros.',\n        x: -30, y: 120, z: 90\n      },\n      {\n        id: 'VAL-N3-E',\n        name: 'Saturación Puntual de Cerros Emblemáticos (Alegre / Concepción)',\n        shortLabel: 'Saturación en Cerros Alegre & Concepción',\n        level: 3,\n        triadRole: 'efecto',\n        function: 'Concentración excesiva del flujo turístico en solo 2 de los 42 cerros de Valparaíso.',\n        impact: 'Sobrecarga de servicios básicos y congestión en paseos peatonales (Atkinson, Dimalow).',\n        x: 30, y: 170, z: 130\n      },\n\n      // === NIVEL 4: ESPACIO GEOGRÁFICO & COMUNIDAD RESIDENTE ===\n      {\n        id: 'VAL-N4-S',\n        name: 'Gentrificación y Desplazamiento de Población Residente',\n        shortLabel: 'Gentrificación & Expulsión de Residentes',\n        level: 4,\n        triadRole: 'sintoma',\n        function: 'Aumento del costo de vida y conversión de viviendas familiares en hospedajes informales.',\n        impact: 'Pérdida de la identidad vecinal y del patrimonio inmaterial barrial.',\n        x: 80, y: 170, z: 150\n      },\n      {\n        id: 'VAL-N4-C',\n        name: 'Falta de Plan de Manejo Micro-Territorial y Seguridad Urbana',\n        shortLabel: 'Falta Control Micro-Territorial & Seguridad',\n        level: 4,\n        triadRole: 'causa',\n        function: 'Escasa presencia policial y desorden nocturno en ejes gastronómicos de los cerros.',\n        impact: 'Aumento en la percepción de inseguridad para turistas y comunidad residente.',\n        x: 140, y: 220, z: 200\n      },\n      {\n        id: 'VAL-N4-E',\n        name: 'Tensión Vecinos-Turismo y Devaluación del Espacio Público',\n        shortLabel: 'Tensión Comunitaria Vecinos vs Turismo',\n        level: 4,\n        triadRole: 'efecto',\n        function: 'Rechazo ciudadano hacia la actividad turística desregulada.',\n        impact: 'Ruptura del tejido social y deterioro ambiental de miradores y quebradas.',\n        x: 200, y: 270, z: 250\n      }\n    ];\n\n    const rawEdgesData = [\n      { id: 'E1', source: 'VAL-N1-S', target: 'VAL-N1-C' },\n      { id: 'E2', source: 'VAL-N1-C', target: 'VAL-N1-E' },\n      { id: 'E3', source: 'VAL-N2-S', target: 'VAL-N2-C' },\n      { id: 'E4', source: 'VAL-N2-C', target: 'VAL-N2-E' },\n      { id: 'E5', source: 'VAL-N3-S', target: 'VAL-N3-C' },\n      { id: 'E6', source: 'VAL-N3-C', target: 'VAL-N3-E' },\n      { id: 'E7', source: 'VAL-N4-S', target: 'VAL-N4-C' },\n      { id: 'E8', source: 'VAL-N4-C', target: 'VAL-N4-E' },\n      // Feedback loops inter-nivel Matrioshka\n      { id: 'E-N1-N2', source: 'VAL-N1-E', target: 'VAL-N2-S' },\n      { id: 'E-N2-N3', source: 'VAL-N2-E', target: 'VAL-N3-S' },\n      { id: 'E-N3-N4', source: 'VAL-N3-E', target: 'VAL-N4-S' },\n      { id: 'E-N4-N1', source: 'VAL-N4-E', target: 'VAL-N1-S' }\n    ];\n\n    let nodes = [], edges = [];\n\n    function resize() {\n      canvas.width = window.innerWidth;\n      canvas.height = window.innerHeight;\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    function buildTopology() {\n      nodes = rawNodesData.map((d, idx) => ({\n        ...d,\n        nodeId: idx,\n        ox: d.x, oy: d.y, oz: d.z\n      }));\n      const nodeMap = new Map(nodes.map(n => [n.id, n]));\n      edges = rawEdgesData.map(e => ({\n        ...e,\n        sourceNode: nodeMap.get(e.source),\n        targetNode: nodeMap.get(e.target)\n      }));\n    }\n\n    function project(x, y, z, w, h) {\n      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);\n      const x1 = x * cosY + z * sinY;\n      const z1 = -x * sinY + z * cosY;\n\n      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);\n      const y2 = y * cosX - z1 * sinX;\n      const z2 = y * sinX + z1 * cosX;\n\n      const cx = x1 + panX;\n      const cy = y2 + panY;\n\n      const dist = 650;\n      const scale = zoom / (z2 + dist);\n\n      return {\n        x: w / 2 + cx * scale,\n        y: h / 2 + cy * scale,\n        z: z2,\n        scale,\n        visible: (z2 + dist) > 10\n      };\n    }\n\n    function resetCamera() {\n      targetRotX = 0.35; targetRotY = 0.65; targetZoom = 480; targetPanX = 0; targetPanY = 0;\n    }\n\n    function openInspector(node) {\n      selectedNode = node;\n      document.getElementById('mNodeTitle').innerText = node.name;\n      document.getElementById('mNodeCode').innerText = `Nivel Matrioshka ${node.level} • ID: ${node.id}`;\n      document.getElementById('mFunction').innerText = node.function;\n      document.getElementById('mImpact').innerText = node.impact;\n      \n      const badge = document.getElementById('mTriadBadge');\n      if (node.triadRole === 'sintoma') {\n        badge.innerText = '🔴 SÍNTOMA VISIBLE';\n        badge.className = 'triad-badge triad-sintoma';\n      } else if (node.triadRole === 'causa') {\n        badge.innerText = '🟡 CAUSA ESTRUCTURAL';\n        badge.className = 'triad-badge triad-causa';\n      } else {\n        badge.innerText = '🟧 EFECTO SISTÉMICO';\n        badge.className = 'triad-badge triad-efecto';\n      }\n\n      document.getElementById('nodeInspector').style.display = 'flex';\n    }\n\n    function closeInspector() {\n      selectedNode = null;\n      document.getElementById('nodeInspector').style.display = 'none';\n    }\n\n    function render() {\n      const w = canvas.width, h = canvas.height;\n\n      rotX += (targetRotX - rotX) * 0.12;\n      rotY += (targetRotY - rotY) * 0.12;\n      zoom += (targetZoom - zoom) * 0.12;\n      panX += (targetPanX - panX) * 0.12;\n      panY += (targetPanY - panY) * 0.12;\n\n      ctx.fillStyle = palette.bg;\n      ctx.fillRect(0, 0, w, h);\n\n      nodes.forEach(n => {\n        n.proj = project(n.x, n.y, n.z, w, h);\n      });\n\n      // Render Edges\n      edges.forEach(e => {\n        const s = e.sourceNode, t = e.targetNode;\n        if (!s || !t || !s.proj || !t.proj || !s.proj.visible || !t.proj.visible) return;\n\n        const isHov = hoveredNode && (s.id === hoveredNode.id || t.id === hoveredNode.id);\n        const isSel = selectedNode && (s.id === selectedNode.id || t.id === selectedNode.id);\n\n        ctx.save();\n        ctx.strokeStyle = (isHov || isSel) ? '#E7C878' : 'rgba(231, 200, 120, 0.45)';\n        ctx.lineWidth = (isHov || isSel) ? 3.5 : 1.6;\n        ctx.beginPath();\n        ctx.moveTo(s.proj.x, s.proj.y);\n        ctx.lineTo(t.proj.x, t.proj.y);\n        ctx.stroke();\n        ctx.restore();\n      });\n\n      // Render Rectangular Card Nodes with Text Inside\n      const sorted = [...nodes].filter(n => n.proj && n.proj.visible).sort((a, b) => a.proj.z - b.proj.z);\n\n      sorted.forEach(n => {\n        const px = Math.round(n.proj.x);\n        const py = Math.round(n.proj.y);\n        const isHov = hoveredNode && hoveredNode.id === n.id;\n        const isSel = selectedNode && selectedNode.id === n.id;\n\n        const scale = n.proj.scale || 1.0;\n        const boxW = Math.max(160, Math.round(210 * scale));\n        const boxH = Math.max(48, Math.round(58 * scale));\n        const xPos = px - boxW / 2;\n        const yPos = py - boxH / 2;\n\n        const levelColor = palette.levelColors[n.level] || '#E7C878';\n        const triadBorder = n.triadRole === 'sintoma' ? '#E69888' : (n.triadRole === 'causa' ? '#E7C878' : '#C96349');\n        const triadTag = n.triadRole === 'sintoma' ? '🔴 SÍNTOMA' : (n.triadRole === 'causa' ? '🟡 CAUSA' : '🟧 EFECTO');\n\n        ctx.save();\n        ctx.fillStyle = (isHov || isSel) ? '#0f172a' : '#06090f';\n        ctx.beginPath();\n        ctx.roundRect(xPos, yPos, boxW, boxH, 6);\n        ctx.fill();\n\n        ctx.strokeStyle = (isHov || isSel) ? '#ffffff' : triadBorder;\n        ctx.lineWidth = (isHov || isSel) ? 2.5 : 1.8;\n        ctx.stroke();\n\n        ctx.fillStyle = levelColor;\n        ctx.fillRect(xPos, yPos, 5, boxH);\n\n        ctx.font = 'bold 9px ui-monospace, monospace';\n        ctx.fillStyle = triadBorder;\n        ctx.textAlign = 'left';\n        ctx.fillText(`[${n.id}] ${triadTag} (N${n.level})`, xPos + 10, yPos + 14);\n\n        ctx.font = 'bold 10px -apple-system, BlinkMacSystemFont, sans-serif';\n        ctx.fillStyle = '#f8fafc';\n        \n        const maxTextW = boxW - 16;\n        const words = n.shortLabel.split(' ');\n        let line = '';\n        let lineY = yPos + 28;\n\n        for (let nIdx = 0; nIdx < words.length; nIdx++) {\n          const testLine = line + words[nIdx] + ' ';\n          const metrics = ctx.measureText(testLine);\n          if (metrics.width > maxTextW && nIdx > 0) {\n            ctx.fillText(line, xPos + 10, lineY);\n            line = words[nIdx] + ' ';\n            lineY += 13;\n          } else {\n            line = testLine;\n          }\n        }\n        ctx.fillText(line, xPos + 10, lineY);\n\n        ctx.restore();\n      });\n\n      requestAnimationFrame(render);\n    }\n\n    // Mouse Controls\n    canvas.addEventListener('mousedown', e => {\n      isMouseDown = true; mouseBtn = e.button;\n      lastX = e.clientX; lastY = e.clientY;\n      clickStartX = e.clientX; clickStartY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', e => {\n      isMouseDown = false;\n      const dragDist = Math.hypot(e.clientX - clickStartX, e.clientY - clickStartY);\n      if (dragDist < 5 && mouseBtn === 0 && hoveredNode) {\n        openInspector(hoveredNode);\n      }\n    });\n\n    canvas.addEventListener('mousemove', e => {\n      if (isMouseDown) {\n        const dx = e.clientX - lastX, dy = e.clientY - lastY;\n        if (mouseBtn === 0) {\n          targetRotY += dx * 0.004;\n          targetRotX += dy * 0.004;\n        } else if (mouseBtn === 2) {\n          targetPanX += dx; targetPanY += dy;\n        }\n        lastX = e.clientX; lastY = e.clientY;\n      } else {\n        const mx = e.clientX, my = e.clientY;\n        let closest = null, minDist = 40;\n        nodes.forEach(n => {\n          if (!n.proj || !n.proj.visible) return;\n          const d = Math.hypot(n.proj.x - mx, n.proj.y - my);\n          if (d < minDist) { minDist = d; closest = n; }\n        });\n        hoveredNode = closest;\n      }\n    });\n\n    canvas.addEventListener('contextmenu', e => e.preventDefault());\n    canvas.addEventListener('wheel', e => {\n      e.preventDefault();\n      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;\n      targetZoom = Math.max(120, Math.min(1800, targetZoom * zoomFactor));\n    }, { passive: false });\n\n    buildTopology();\n    requestAnimationFrame(render);\n  </script>\n</body>\n</html>\n","Description":"Actualización de la Red 3D de Valparaíso para usar exactamente la plantilla Matrioshka estática con nodos rectangulares e integración de texto interno (Síntoma - Causa - Efecto).","Overwrite":true,"TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\red_actores_turismo_valparaiso.html","toolAction":"Converting Valparaiso network to strict Matrioshka static template","toolSummary":"Update Valparaiso network with Matrioshka template"}}]}
