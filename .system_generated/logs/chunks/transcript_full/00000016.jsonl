{"step_index":412,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-04T23:53:08Z","content":"Created At: 2026-10-04T18:53:08-05:00\nCompleted At: 2026-10-04T18:53:08-05:00\nFile Path: `file:///C:/Users/aleja/.gemini/antigravity/brain/d3de736b-bad3-4cd4-b3f7-8b59f3dfee52/hyperbolic_3d_network.html`\nTotal Lines: 2001\nTotal Bytes: 90674\nShowing lines 1460 to 1660\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1460: \n1461:     // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n1462:     let subCanvasAnim = null;\n1463:     const subOpts = {\n1464:       cats: { 0: true, 1: true, 2: true, 3: true }\n1465:     };\n1466: \n1467:     function toggleSubCat(catId) {\n1468:       subOpts.cats[catId] = !subOpts.cats[catId];\n1469:       const btn = document.getElementById(`subToggle${catId}`);\n1470:       if (btn) btn.classList.toggle('active', subOpts.cats[catId]);\n1471:       renderSubNetworkCanvas();\n1472:     }\n1473: \n1474:     function openSubNetworkModal() {\n1475:       if (!selectedNode) return;\n1476:       const subModal = document.getElementById('subnetworkModal');\n1477:       document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n1478:       document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n1479:       subModal.style.display = 'flex';\n1480:       renderSubNetworkCanvas();\n1481:     }\n1482: \n1483:     function closeSubNetworkModal() {\n1484:       document.getElementById('subnetworkModal').style.display = 'none';\n1485:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1486:     }\n1487: \n1488:     let subState = {\n1489:       nodes: [],\n1490:       links: []\n1491:     };\n1492: \n1493:     function renderSubNetworkCanvas() {\n1494:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1495: \n1496:       const subCanvas = document.getElementById('subCanvas');\n1497:       const wrap = subCanvas.parentElement;\n1498:       subCanvas.width = wrap.clientWidth;\n1499:       subCanvas.height = wrap.clientHeight;\n1500:       const sctx = subCanvas.getContext('2d');\n1501: \n1502:       const centerNode = selectedNode;\n1503:       if (!centerNode) return;\n1504: \n1505:       const cx = subCanvas.width / 2;\n1506:       const cy = subCanvas.height / 2;\n1507: \n1508:       // Filter neighbors based on sub-network active layer toggles\n1509:       const activeNeighbors = (centerNode.neighbors || []).filter(nb => subOpts.cats[nb.cat] !== false);\n1510:       const totalActive = activeNeighbors.length;\n1511: \n1512:       // Target layout calculation using golden angle mesh to prevent overlaps\n1513:       const targets = new Map();\n1514:       \n1515:       // Center node target\n1516:       targets.set(centerNode.id, {\n1517:         targetSx: cx,\n1518:         targetSy: cy,\n1519:         targetSize: Math.min(32, Math.max(18, 14 + Math.sqrt(totalActive) * 2.8)),\n1520:         activeDegree: totalActive,\n1521:         isCenter: true\n1522:       });\n1523: \n1524:       activeNeighbors.forEach((nb, idx) => {\n1525:         const angle = idx * 2.39996 + 0.4;\n1526:         const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalActive));\n1527:         const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n1528: \n1529:         const targetSx = cx + Math.cos(angle) * subRadius;\n1530:         const targetSy = cy + Math.sin(angle) * subRadius * 0.85;\n1531: \n1532:         const nbActiveDegree = (nb.neighbors || []).filter(nnb => subOpts.cats[nnb.cat] !== false).length;\n1533:         const targetSize = Math.min(24, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 1.8));\n1534: \n1535:         targets.set(nb.id, {\n1536:           targetSx,\n1537:           targetSy,\n1538:           targetSize,\n1539:           activeDegree: nbActiveDegree,\n1540:           isCenter: false\n1541:         });\n1542:       });\n1543: \n1544:       // Update or initialize subState nodes\n1545:       const existingMap = new Map(subState.nodes.map(n => [n.id, n]));\n1546:       const newSubNodes = [];\n1547: \n1548:       targets.forEach((t, id) => {\n1549:         const fullObj = id === centerNode.id ? centerNode : nodes[id];\n1550:         let existing = existingMap.get(id);\n1551: \n1552:         if (!existing) {\n1553:           existing = {\n1554:             ...fullObj,\n1555:             sx: t.isCenter ? cx : cx + (Math.random() - 0.5) * 40,\n1556:             sy: t.isCenter ? cy : cy + (Math.random() - 0.5) * 40,\n1557:             currentSize: t.targetSize,\n1558:             targetSx: t.targetSx,\n1559:             targetSy: t.targetSy,\n1560:             targetSize: t.targetSize,\n1561:             activeDegree: t.activeDegree,\n1562:             isCenter: t.isCenter\n1563:           };\n1564:         } else {\n1565:           existing.targetSx = t.targetSx;\n1566:           existing.targetSy = t.targetSy;\n1567:           existing.targetSize = t.targetSize;\n1568:           existing.activeDegree = t.activeDegree;\n1569:           existing.isCenter = t.isCenter;\n1570:         }\n1571:         newSubNodes.push(existing);\n1572:       });\n1573: \n1574:       subState.nodes = newSubNodes;\n1575: \n1576:       const interactionTypes = [\n1577:         { name: 'Depredación', color: '#ff0033' },\n1578:         { name: 'Herbivoría', color: '#00ff88' },\n1579:         { name: 'Dispersión', color: '#ff80a0' },\n1580:         { name: 'Mutualismo', color: '#ffee33' },\n1581:         { name: 'Nidificación', color: '#ffaa00' },\n1582:         { name: 'Visita Floral', color: '#d000ff' },\n1583:         { name: 'Anidamiento', color: '#a0522d' },\n1584:         { name: 'Parasitismo', color: '#ffff00' },\n1585:         { name: 'Alelopatía', color: '#888888' }\n1586:       ];\n1587: \n1588:       function loopSub() {\n1589:         sctx.fillStyle = '#020408';\n1590:         sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n1591: \n1592:         // Smooth physics lerp transition towards new restructured positions\n1593:         subState.nodes.forEach(sn => {\n1594:           sn.sx += (sn.targetSx - sn.sx) * 0.12;\n1595:           sn.sy += (sn.targetSy - sn.sy) * 0.12;\n1596:           sn.currentSize += (sn.targetSize - sn.currentSize) * 0.12;\n1597:         });\n1598: \n1599:         const centerSub = subState.nodes.find(n => n.isCenter);\n1600: \n1601:         // Draw Sub-Network Edges\n1602:         subState.nodes.forEach((sn, idx) => {\n1603:           if (sn.isCenter) return;\n1604: \n1605:           let inter = interactionTypes[0];\n1606:           if (centerNode.cat === 0 && sn.cat === 1) inter = interactionTypes[5];\n1607:           else if (centerNode.cat === 1 && sn.cat === 0) inter = interactionTypes[2];\n1608:           else if (centerNode.cat === 1 && sn.cat === 3) inter = interactionTypes[0];\n1609:           else if (centerNode.cat === 3 && sn.cat === 0) inter = interactionTypes[1];\n1610:           else if (centerNode.cat === 0 && sn.cat === 0) inter = interactionTypes[8];\n1611:           else if (centerNode.cat === 2) inter = interactionTypes[3];\n1612:           else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n1613: \n1614:           if (centerSub) {\n1615:             sctx.save();\n1616:             sctx.beginPath();\n1617:             sctx.moveTo(centerSub.sx, centerSub.sy);\n1618:             sctx.lineTo(sn.sx, sn.sy);\n1619:             sctx.strokeStyle = inter.color;\n1620:             sctx.lineWidth = 2.5;\n1621:             sctx.shadowColor = inter.color;\n1622:             sctx.shadowBlur = 8;\n1623:             sctx.stroke();\n1624:             sctx.restore();\n1625: \n1626:             const mx = (centerSub.sx + sn.sx) / 2;\n1627:             const my = (centerSub.sy + sn.sy) / 2;\n1628:             sctx.save();\n1629:             sctx.font = '9px ui-monospace, monospace';\n1630:             sctx.fillStyle = '#ffffff';\n1631:             sctx.shadowColor = '#000000';\n1632:             sctx.shadowBlur = 4;\n1633:             sctx.fillText(inter.name, mx - 15, my - 4);\n1634:             sctx.restore();\n1635:           }\n1636:         });\n1637: \n1638:         // Draw Sub-Network Nodes\n1639:         subState.nodes.forEach(sn => {\n1640:           const r = sn.currentSize;\n1641: \n1642:           sctx.save();\n1643:           sctx.beginPath();\n1644:           sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\n1645:           sctx.clip();\n1646: \n1647:           if (sn.imgObj && sn.imgObj.complete && sn.imgObj.naturalWidth !== 0) {\n1648:             sctx.drawImage(sn.imgObj, sn.sx - r, sn.sy - r, r * 2, r * 2);\n1649:           } else {\n1650:             sctx.fillStyle = palette.catColors[sn.cat] || '#00ffff';\n1651:             sctx.fillRect(sn.sx - r, sn.sy - r, r * 2, r * 2);\n1652:           }\n1653:           sctx.restore();\n1654: \n1655:           // Border Ring\n1656:           sctx.save();\n1657:           sctx.beginPath();\n1658:           sctx.arc(sn.sx, sn.sy, r + 1, 0, Math.PI * 2);\n1659:           sctx.strokeStyle = sn.isCenter ? '#00ffff' : palette.catColors[sn.cat];\n1660:           sctx.lineWidth = sn.isCenter ? 3.5 : 2;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
