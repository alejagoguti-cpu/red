{"step_index":430,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-04T23:53:59Z","content":"Created At: 2026-10-04T18:53:59-05:00\nCompleted At: 2026-10-04T18:53:59-05:00\nFile Path: `file:///C:/Users/aleja/.gemini/antigravity/brain/d3de736b-bad3-4cd4-b3f7-8b59f3dfee52/hyperbolic_3d_network.html`\nTotal Lines: 2007\nTotal Bytes: 92157\nShowing lines 1460 to 1650\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1460:       });\n1461: \n1462:       modal.style.display = 'block';\n1463:       focusSelectedNode(node);\n1464:     }\n1465: \n1466:     // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n1467:     let subCanvasAnim = null;\n1468:     const subOpts = {\n1469:       cats: { 0: true, 1: true, 2: true, 3: true }\n1470:     };\n1471: \n1472:     function toggleSubCat(catId) {\n1473:       subOpts.cats[catId] = !subOpts.cats[catId];\n1474:       const btn = document.getElementById(`subToggle${catId}`);\n1475:       if (btn) btn.classList.toggle('active', subOpts.cats[catId]);\n1476:       renderSubNetworkCanvas();\n1477:     }\n1478: \n1479:     function openSubNetworkModal() {\n1480:       if (!selectedNode) return;\n1481:       const subModal = document.getElementById('subnetworkModal');\n1482:       document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n1483:       document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n1484:       subModal.style.display = 'flex';\n1485:       renderSubNetworkCanvas();\n1486:     }\n1487: \n1488:     function closeSubNetworkModal() {\n1489:       document.getElementById('subnetworkModal').style.display = 'none';\n1490:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1491:     }\n1492: \n1493:     let subState = {\n1494:       nodes: [],\n1495:       links: []\n1496:     };\n1497: \n1498:     function renderSubNetworkCanvas() {\n1499:       if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n1500: \n1501:       const subCanvas = document.getElementById('subCanvas');\n1502:       const wrap = subCanvas.parentElement;\n1503:       subCanvas.width = wrap.clientWidth;\n1504:       subCanvas.height = wrap.clientHeight;\n1505:       const sctx = subCanvas.getContext('2d');\n1506: \n1507:       const centerNode = selectedNode;\n1508:       if (!centerNode) return;\n1509: \n1510:       const cx = subCanvas.width / 2;\n1511:       const cy = subCanvas.height / 2;\n1512: \n1513:       // Filter neighbors strictly based on active layer category toggles and active state\n1514:       const activeNeighbors = (centerNode.neighbors || []).filter(nb => nb.active && subOpts.cats[nb.cat] !== false);\n1515:       const totalActive = activeNeighbors.length;\n1516: \n1517:       // Target layout calculation using golden angle mesh\n1518:       const targets = new Map();\n1519:       \n1520:       // Center node target calculation\n1521:       targets.set(centerNode.id, {\n1522:         targetSx: cx,\n1523:         targetSy: cy,\n1524:         targetSize: Math.min(34, Math.max(18, 14 + Math.sqrt(totalActive) * 3.0)),\n1525:         activeDegree: totalActive,\n1526:         isCenter: true\n1527:       });\n1528: \n1529:       activeNeighbors.forEach((nb, idx) => {\n1530:         const angle = idx * 2.39996 + 0.4;\n1531:         const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalActive));\n1532:         const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n1533: \n1534:         const targetSx = cx + Math.cos(angle) * subRadius;\n1535:         const targetSy = cy + Math.sin(angle) * subRadius * 0.85;\n1536: \n1537:         // Recalculate neighbor degree against visible sub-network layers\n1538:         const nbActiveDegree = (nb.neighbors || []).filter(nnb => nnb.active && subOpts.cats[nnb.cat] !== false).length;\n1539:         const targetSize = Math.min(26, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 2.0));\n1540: \n1541:         targets.set(nb.id, {\n1542:           targetSx,\n1543:           targetSy,\n1544:           targetSize,\n1545:           activeDegree: nbActiveDegree,\n1546:           isCenter: false\n1547:         });\n1548:       });\n1549: \n1550:       // Synchronize subState nodes: ONLY keep nodes that exist in current active targets\n1551:       const existingMap = new Map(subState.nodes.map(n => [n.id, n]));\n1552:       const newSubNodes = [];\n1553: \n1554:       targets.forEach((t, id) => {\n1555:         const fullObj = id === centerNode.id ? centerNode : nodes[id];\n1556:         let existing = existingMap.get(id);\n1557: \n1558:         if (!existing) {\n1559:           existing = {\n1560:             ...fullObj,\n1561:             sx: t.isCenter ? cx : cx + (Math.random() - 0.5) * 40,\n1562:             sy: t.isCenter ? cy : cy + (Math.random() - 0.5) * 40,\n1563:             currentSize: 4, // start small for morphing\n1564:             targetSx: t.targetSx,\n1565:             targetSy: t.targetSy,\n1566:             targetSize: t.targetSize,\n1567:             activeDegree: t.activeDegree,\n1568:             isCenter: t.isCenter\n1569:           };\n1570:         } else {\n1571:           existing.targetSx = t.targetSx;\n1572:           existing.targetSy = t.targetSy;\n1573:           existing.targetSize = t.targetSize;\n1574:           existing.activeDegree = t.activeDegree;\n1575:           existing.isCenter = t.isCenter;\n1576:         }\n1577:         newSubNodes.push(existing);\n1578:       });\n1579: \n1580:       subState.nodes = newSubNodes;\n1581: \n1582:       const interactionTypes = [\n1583:         { name: 'Depredación', color: '#ff0033' },\n1584:         { name: 'Herbivoría', color: '#00ff88' },\n1585:         { name: 'Dispersión', color: '#ff80a0' },\n1586:         { name: 'Mutualismo', color: '#ffee33' },\n1587:         { name: 'Nidificación', color: '#ffaa00' },\n1588:         { name: 'Visita Floral', color: '#d000ff' },\n1589:         { name: 'Anidamiento', color: '#a0522d' },\n1590:         { name: 'Parasitismo', color: '#ffff00' },\n1591:         { name: 'Alelopatía', color: '#888888' }\n1592:       ];\n1593: \n1594:       function loopSub() {\n1595:         sctx.fillStyle = '#020408';\n1596:         sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n1597: \n1598:         // Smooth physics lerp transition towards new restructured positions\n1599:         subState.nodes.forEach(sn => {\n1600:           sn.sx += (sn.targetSx - sn.sx) * 0.12;\n1601:           sn.sy += (sn.targetSy - sn.sy) * 0.12;\n1602:           sn.currentSize += (sn.targetSize - sn.currentSize) * 0.12;\n1603:         });\n1604: \n1605:         const centerSub = subState.nodes.find(n => n.isCenter);\n1606: \n1607:         // Draw Sub-Network Edges\n1608:         subState.nodes.forEach((sn, idx) => {\n1609:           if (sn.isCenter) return;\n1610: \n1611:           let inter = interactionTypes[0];\n1612:           if (centerNode.cat === 0 && sn.cat === 1) inter = interactionTypes[5];\n1613:           else if (centerNode.cat === 1 && sn.cat === 0) inter = interactionTypes[2];\n1614:           else if (centerNode.cat === 1 && sn.cat === 3) inter = interactionTypes[0];\n1615:           else if (centerNode.cat === 3 && sn.cat === 0) inter = interactionTypes[1];\n1616:           else if (centerNode.cat === 0 && sn.cat === 0) inter = interactionTypes[8];\n1617:           else if (centerNode.cat === 2) inter = interactionTypes[3];\n1618:           else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n1619: \n1620:           if (centerSub) {\n1621:             sctx.save();\n1622:             sctx.beginPath();\n1623:             sctx.moveTo(centerSub.sx, centerSub.sy);\n1624:             sctx.lineTo(sn.sx, sn.sy);\n1625:             sctx.strokeStyle = inter.color;\n1626:             sctx.lineWidth = 2.5;\n1627:             sctx.shadowColor = inter.color;\n1628:             sctx.shadowBlur = 8;\n1629:             sctx.stroke();\n1630:             sctx.restore();\n1631: \n1632:             const mx = (centerSub.sx + sn.sx) / 2;\n1633:             const my = (centerSub.sy + sn.sy) / 2;\n1634:             sctx.save();\n1635:             sctx.font = '9px ui-monospace, monospace';\n1636:             sctx.fillStyle = '#ffffff';\n1637:             sctx.shadowColor = '#000000';\n1638:             sctx.shadowBlur = 4;\n1639:             sctx.fillText(inter.name, mx - 15, my - 4);\n1640:             sctx.restore();\n1641:           }\n1642:         });\n1643: \n1644:         // Draw Sub-Network Nodes\n1645:         subState.nodes.forEach(sn => {\n1646:           const r = sn.currentSize;\n1647: \n1648:           sctx.save();\n1649:           sctx.beginPath();\n1650:           sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":431,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-04T23:53:59Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Connect interaction type toggles to sub-network canvas render and dynamic degree calculation.","EndLine":1580,"Instruction":"Update subOpts to track active interaction types (0 to 8) and filter activeNeighbors based on whether their ecological interaction type is enabled.","ReplacementContent":"    // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n    let subCanvasAnim = null;\n    const subOpts = {\n      interactions: { 0: true, 1: true, 2: true, 3: true, 4: true, 5: true, 6: true, 7: true, 8: true }\n    };\n\n    function toggleSubInteraction(typeId) {\n      subOpts.interactions[typeId] = !subOpts.interactions[typeId];\n      const btn = document.getElementById(`subInterToggle${typeId}`);\n      if (btn) btn.classList.toggle('active', subOpts.interactions[typeId]);\n      renderSubNetworkCanvas();\n    }\n\n    function getInteractionType(nodeA, nodeB, idx) {\n      if (nodeA.cat === 0 && nodeB.cat === 1) return 5; // Visita Floral\n      if (nodeA.cat === 1 && nodeB.cat === 0) return 2; // Dispersión\n      if (nodeA.cat === 1 && nodeB.cat === 3) return 0; // Depredación\n      if (nodeA.cat === 3 && nodeB.cat === 0) return 1; // Herbivoría\n      if (nodeA.cat === 0 && nodeB.cat === 0) return 8; // Alelopatía\n      if (nodeA.cat === 2) return 3; // Mutualismo\n      return (idx + nodeA.id) % 9;\n    }\n\n    function openSubNetworkModal() {\n      if (!selectedNode) return;\n      const subModal = document.getElementById('subnetworkModal');\n      document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n      document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n      subModal.style.display = 'flex';\n      renderSubNetworkCanvas();\n    }\n\n    function closeSubNetworkModal() {\n      document.getElementById('subnetworkModal').style.display = 'none';\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n    }\n\n    let subState = {\n      nodes: [],\n      links: []\n    };\n\n    function renderSubNetworkCanvas() {\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const centerNode = selectedNode;\n      if (!centerNode) return;\n\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      // Filter neighbors strictly based on active interaction type toggles\n      const activeNeighbors = (centerNode.neighbors || []).filter((nb, idx) => {\n        if (!nb.active) return false;\n        const typeId = getInteractionType(centerNode, nb, idx);\n        return subOpts.interactions[typeId] !== false;\n      });\n      const totalActive = activeNeighbors.length;\n\n      // Target layout calculation using golden angle mesh\n      const targets = new Map();\n      \n      // Center node target calculation\n      targets.set(centerNode.id, {\n        targetSx: cx,\n        targetSy: cy,\n        targetSize: Math.min(34, Math.max(18, 14 + Math.sqrt(totalActive) * 3.0)),\n        activeDegree: totalActive,\n        isCenter: true\n      });\n\n      activeNeighbors.forEach((nb, idx) => {\n        const angle = idx * 2.39996 + 0.4;\n        const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalActive));\n        const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n\n        const targetSx = cx + Math.cos(angle) * subRadius;\n        const targetSy = cy + Math.sin(angle) * subRadius * 0.85;\n\n        // Recalculate neighbor degree against visible interaction types\n        const nbActiveDegree = (nb.neighbors || []).filter((nnb, nidx) => {\n          if (!nnb.active) return false;\n          const tId = getInteractionType(nb, nnb, nidx);\n          return subOpts.interactions[tId] !== false;\n        }).length;\n\n        const targetSize = Math.min(26, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 2.0));\n\n        targets.set(nb.id, {\n          targetSx,\n          targetSy,\n          targetSize,\n          activeDegree: nbActiveDegree,\n          isCenter: false,\n          interType: getInteractionType(centerNode, nb, idx)\n        });\n      });\n\n      // Synchronize subState nodes: ONLY keep nodes that exist in current active targets\n      const existingMap = new Map(subState.nodes.map(n => [n.id, n]));\n      const newSubNodes = [];\n\n      targets.forEach((t, id) => {\n        const fullObj = id === centerNode.id ? centerNode : nodes[id];\n        let existing = existingMap.get(id);\n\n        if (!existing) {\n          existing = {\n            ...fullObj,\n            sx: t.isCenter ? cx : cx + (Math.random() - 0.5) * 40,\n            sy: t.isCenter ? cy : cy + (Math.random() - 0.5) * 40,\n            currentSize: 4, // start small for morphing\n            targetSx: t.targetSx,\n            targetSy: t.targetSy,\n            targetSize: t.targetSize,\n            activeDegree: t.activeDegree,\n            isCenter: t.isCenter,\n            interType: t.interType\n          };\n        } else {\n          existing.targetSx = t.targetSx;\n          existing.targetSy = t.targetSy;\n          existing.targetSize = t.targetSize;\n          existing.activeDegree = t.activeDegree;\n          existing.isCenter = t.isCenter;\n          existing.interType = t.interType;\n        }\n        newSubNodes.push(existing);\n      });\n\n      subState.nodes = newSubNodes;","StartLine":1465,"TargetContent":"    // --- SUB-NETWORK 2D GRAPH POPUP MODAL LOGIC ---\n    let subCanvasAnim = null;\n    const subOpts = {\n      cats: { 0: true, 1: true, 2: true, 3: true }\n    };\n\n    function toggleSubCat(catId) {\n      subOpts.cats[catId] = !subOpts.cats[catId];\n      const btn = document.getElementById(`subToggle${catId}`);\n      if (btn) btn.classList.toggle('active', subOpts.cats[catId]);\n      renderSubNetworkCanvas();\n    }\n\n    function openSubNetworkModal() {\n      if (!selectedNode) return;\n      const subModal = document.getElementById('subnetworkModal');\n      document.getElementById('subModalTitle').innerText = `Sub-Red Directa: ${selectedNode.label}`;\n      document.getElementById('subModalCode').innerText = `[${selectedNode.taxaId}]`;\n      subModal.style.display = 'flex';\n      renderSubNetworkCanvas();\n    }\n\n    function closeSubNetworkModal() {\n      document.getElementById('subnetworkModal').style.display = 'none';\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n    }\n\n    let subState = {\n      nodes: [],\n      links: []\n    };\n\n    function renderSubNetworkCanvas() {\n      if (subCanvasAnim) cancelAnimationFrame(subCanvasAnim);\n\n      const subCanvas = document.getElementById('subCanvas');\n      const wrap = subCanvas.parentElement;\n      subCanvas.width = wrap.clientWidth;\n      subCanvas.height = wrap.clientHeight;\n      const sctx = subCanvas.getContext('2d');\n\n      const centerNode = selectedNode;\n      if (!centerNode) return;\n\n      const cx = subCanvas.width / 2;\n      const cy = subCanvas.height / 2;\n\n      // Filter neighbors strictly based on active layer category toggles and active state\n      const activeNeighbors = (centerNode.neighbors || []).filter(nb => nb.active && subOpts.cats[nb.cat] !== false);\n      const totalActive = activeNeighbors.length;\n\n      // Target layout calculation using golden angle mesh\n      const targets = new Map();\n      \n      // Center node target calculation\n      targets.set(centerNode.id, {\n        targetSx: cx,\n        targetSy: cy,\n        targetSize: Math.min(34, Math.max(18, 14 + Math.sqrt(totalActive) * 3.0)),\n        activeDegree: totalActive,\n        isCenter: true\n      });\n\n      activeNeighbors.forEach((nb, idx) => {\n        const angle = idx * 2.39996 + 0.4;\n        const distRatio = Math.sqrt((idx + 1) / Math.max(1, totalActive));\n        const subRadius = 90 + distRatio * (Math.min(cx, cy) - 130);\n\n        const targetSx = cx + Math.cos(angle) * subRadius;\n        const targetSy = cy + Math.sin(angle) * subRadius * 0.85;\n\n        // Recalculate neighbor degree against visible sub-network layers\n        const nbActiveDegree = (nb.neighbors || []).filter(nnb => nnb.active && subOpts.cats[nnb.cat] !== false).length;\n        const targetSize = Math.min(26, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 2.0));\n\n        targets.set(nb.id, {\n          targetSx,\n          targetSy,\n          targetSize,\n          activeDegree: nbActiveDegree,\n          isCenter: false\n        });\n      });\n\n      // Synchronize subState nodes: ONLY keep nodes that exist in current active targets\n      const existingMap = new Map(subState.nodes.map(n => [n.id, n]));\n      const newSubNodes = [];\n\n      targets.forEach((t, id) => {\n        const fullObj = id === centerNode.id ? centerNode : nodes[id];\n        let existing = existingMap.get(id);\n\n        if (!existing) {\n          existing = {\n            ...fullObj,\n            sx: t.isCenter ? cx : cx + (Math.random() - 0.5) * 40,\n            sy: t.isCenter ? cy : cy + (Math.random() - 0.5) * 40,\n            currentSize: 4, // start small for morphing\n            targetSx: t.targetSx,\n            targetSy: t.targetSy,\n            targetSize: t.targetSize,\n            activeDegree: t.activeDegree,\n            isCenter: t.isCenter\n          };\n        } else {\n          existing.targetSx = t.targetSx;\n          existing.targetSy = t.targetSy;\n          existing.targetSize = t.targetSize;\n          existing.activeDegree = t.activeDegree;\n          existing.isCenter = t.isCenter;\n        }\n        newSubNodes.push(existing);\n      });\n\n      subState.nodes = newSubNodes;","TargetFile":"C:\\Users\\aleja\\.gemini\\antigravity\\brain\\d3de736b-bad3-4cd4-b3f7-8b59f3dfee52\\hyperbolic_3d_network.html","toolAction":"Updating sub-network render logic to use interaction type filters","toolSummary":"Connect interaction type toggles to rendering"}}]}
