 { name: 'Anidamiento', color: '#a0522d' },\n1585:         { name: 'Parasitismo', color: '#ffff00' },\n1586:         { name: 'Alelopatía', color: '#888888' }\n1587:       ];\n1588: \n1589:       function loopSub() {\n1590:         sctx.fillStyle = '#020408';\n1591:         sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n1592: \n1593:         // Smooth physics lerp transition towards new restructured positions\n1594:         subState.nodes.forEach(sn => {\n1595:           sn.sx += (sn.targetSx - sn.sx) * 0.12;\n1596:           sn.sy += (sn.targetSy - sn.sy) * 0.12;\n1597:           sn.currentSize += (sn.targetSize - sn.currentSize) * 0.12;\n1598:         });\n1599: \n1600:         const centerSub = subState.nodes.find(n => n.isCenter);\n1601: \n1602:         // Draw Sub-Network Edges\n1603:         subState.nodes.forEach((sn, idx) => {\n1604:           if (sn.isCenter) return;\n1605: \n1606:           let inter = interactionTypes[0];\n1607:           if (centerNode.cat === 0 && sn.cat === 1) inter = interactionTypes[5];\n1608:           else if (centerNode.cat === 1 && sn.cat === 0) inter = interactionTypes[2];\n1609:           else if (centerNode.cat === 1 && sn.cat === 3) inter = interactionTypes[0];\n1610:           else if (centerNode.cat === 3 && sn.cat === 0) inter = interactionTypes[1];\n1611:           else if (centerNode.cat === 0 && sn.cat === 0) inter = interactionTypes[8];\n1612:           else if (centerNode.cat === 2) inter = interactionTypes[3];\n1613:           else inter = interactionTypes[(idx + centerNode.id) % interactionTypes.length];\n1614: \n1615:           if (centerSub) {\n1616:             sctx.save();\n1617:             sctx.beginPath();\n1618:             sctx.moveTo(centerSub.sx, centerSub.sy);\n1619:             sctx.lineTo(sn.sx, sn.sy);\n1620:             sctx.strokeStyle = inter.color;\n1621:             sctx.lineWidth = 2.5;\n1622:             sctx.shadowColor = inter.color;\n1623:             sctx.shadowBlur = 8;\n1624:             sctx.stroke();\n1625:             sctx.restore();\n1626: \n1627:             const mx = (centerSub.sx + sn.sx) / 2;\n1628:             const my = (centerSub.sy + sn.sy) / 2;\n1629:             sctx.save();\n1630:             sctx.font = '9px ui-monospace, monospace';\n1631:             sctx.fillStyle = '#ffffff';\n1632:             sctx.shadowColor = '#000000';\n1633:             sctx.shadowBlur = 4;\n1634:             sctx.fillText(inter.name, mx - 15, my - 4);\n1635:             sctx.restore();\n1636:           }\n1637:         });\n1638: \n1639:         // Draw Sub-Network Nodes\n1640:         subState.nodes.forEach(sn => {\n1641:           const r = sn.currentSize;\n1642: \n1643:           sctx.save();\n1644:           sctx.beginPath();\n1645:           sctx.arc(sn.sx, sn.sy, r, 0, Math.PI * 2);\n1646:           sctx.clip();\n1647: \n1648:           if (sn.imgObj && sn.imgObj.complete && sn.imgObj.naturalWidth !== 0) {\n1649:             sctx.drawImage(sn.imgObj, sn.sx - r, sn.sy - r, r * 2, r * 2);\n1650:           } else {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
