m, gIdx) => {\n          const { nb, idx } = item;\n          const spreadAngle = (gIdx - (group.length - 1) / 2) * 0.45;\n          const offsetRadius = 35 + (gIdx % 3) * 22;\n\n          const targetSx = hubCx + Math.cos(cluster.angle + spreadAngle) * offsetRadius;\n          const targetSy = hubCy + Math.sin(cluster.angle + spreadAngle) * offsetRadius * 0.85;\n\n          const nbActiveDegree = (nb.neighbors || []).filter((nnb, nidx) => {\n            if (!nnb.active) return false;\n            const tId = getInteractionType(nb, nnb, nidx);\n            return subOpts.interactions[tId] !== false;\n          }).length;\n\n          const targetSize = Math.min(26, Math.max(12, 10 + Math.sqrt(nbActiveDegree) * 2.0));\n\n          targets.set(nb.id, {\n            targetSx,\n            targetSy,\n            targetSize,\n            activeDegree: nbActiveDegree,\n            isCenter: false,\n            interType: getInteractionType(centerNode, nb, idx)\n          });\n        });\n      });\n\n      // Synchronize subState nodes: ONLY keep nodes that exist in current active targets\n      const existingMap = new Map(subState.nodes.map(n => [n.id, n]));\n      const newSubNodes = [];\n\n      targets.forEach((t, id) => {\n        const fullObj = id === centerNode.id ? centerNode : nodes[id];\n        let existing = existingMap.get(id);\n\n        if (!existing) {\n          existing = {\n            ...fullObj,\n            sx: t.isCenter ? cx : cx + (Math.random() - 0.5) * 60,\n            sy: t.isCenter ? cy : cy + (Math.random() - 0.5) * 60,\n            currentSize: 4,\n            targetSx: t.targetSx,\n            targetSy: t.targetSy,\n            targetSize: t.targetSize,\n            activeDegree: t.activeDegree,\n            isCenter: t.isCenter,\n            interType: t.interType\n          };\n        } else {\n          existing.targetSx = t.targetSx;\n          existing.targetSy = t.targetSy;\n          existing.targetSize = t.targetSize;\n          existing.activeDegree = t.activeDegree;\n          existing.isCenter = t.isCenter;\n          existing.interType = t.interType;\n        }\n        newSubNodes.push(existing);\n      });\n\n      subState.nodes = newSubNodes;\n\n      const interactionTypes = [\n        { name: 'Depredación', color: '#C96349' },\n        { name: 'Herbivoría', color: '#84A48B' },\n        { name: 'Dispersión', color: '#E69888' },\n        { name: 'Mutualismo', color: '#E7C878' },\n        { name: 'Nidificación', color: '#F79E70' },\n        { name: 'Visita Floral', color: '#A386A9' },\n        { name: 'Anidamiento', color: '#D1A996' },\n        { name: 'Parasitismo', color: '#C6B3CA' },\n        { name: 'Alelopatía', color: '#6B9080' }\n      ];\n\n      function loopSub() {\n        sctx.fillStyle = '#000000';\n        sctx.fillRect(0, 0, subCanvas.width, subCanvas.height);\n\n        // Smooth physics lerp transition towards new restructured positions\n        subState.nodes.forEach(sn => {\n          sn.sx += (sn.targetSx - sn.sx) * 0.12;\n          sn.sy += (sn.targetSy - sn.sy) * 0.12;\n          sn.currentSize += (sn.targetSize - sn.currentSize) * 0.12;\n        });\n\n        const subNodeMap = new Map(subState.nodes.map(n => [n.id, n]));\n\n        // Draw Inter-Neighbor Decentralized Cross-Links first\n        subState.nodes.forEach(snA => {\n          if (!snA.neighbors) return;\n          snA.neighbors.forEach((nbB, nidx) => {\n            const snB = subNodeMap.get(nbB.id);\n            if (snB && snA.id < snB.id && !snA.isCenter && !snB.isCenter) {\n              const typeId = getInteractionType(snA, snB, nidx);\n              if (subOpts.interactions[typeId] !== false) {\n                const inter = interactionTypes[typeId] || interactionTypes[0];\n                sctx.save();\n                sctx.beginPath();\n                sctx.moveTo(snA.sx, snA.sy);\n                sctx.lineTo(snB.sx, snB.sy);\n                sctx.strokeStyle = inter.color;\n                