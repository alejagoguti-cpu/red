ce: a.id, target: b.id });\\n            }\\n          }\\n        }\\n      }\\n\\n      recalculateDegreesAndSizes();\\n    }\"","StartLine":"804","TargetContent":"\"    function buildTopology() {\\n      const fullTaxa = buildFull180Dataset();\\n      nodes = [];\\n      edges = [];\\n\\n      fullTaxa.forEach((tData, idx) => {\\n        const imgObj = getPreloadedImage(tData.img, tData.id, tData.name, tData.cat);\\n\\n        if (idx === 0) {\\n          nodes.push({ id: 0, taxaId: tData.id, label: tData.name, sciname: tData.sciname, cat: tData.cat, role: tData.role, loc: tData.loc, alert: tData.alert, photoUrl: tData.img || generateSpeciesSvgDataUri(tData.id, tData.name, tData.cat), imgObj, x: 0, y: 0, z: 0, level: 0, hiddenByUser: false });\\n          return;\\n        }\\n\\n        const phi = Math.acos(1 - 2 * (idx / fullTaxa.length));\\n        const theta = Math.PI * (1 + Math.sqrt(5)) * idx;\\n\\n        const rad = tData.cat === 4 ? 290 : (tData.cat === 0 ? 180 + (idx % 4) * 25 : 230);\\n        const nx = rad * Math.sin(phi) * Math.cos(theta);\\n        const ny = rad * Math.sin(phi) * Math.sin(theta);\\n        const nz = rad * Math.cos(phi);\\n\\n        const nodeId = nodes.length;\\n        nodes.push({\\n          id: nodeId, taxaId: tData.id, label: tData.name, sciname: tData.sciname, cat: tData.cat, role: tData.role, loc: tData.loc, alert: tData.alert, photoUrl: tData.img || generateSpeciesSvgDataUri(tData.id, tData.name, tData.cat), imgObj,\\n          x: nx, y: ny, z: nz, ox: nx, oy: ny, oz: nz, level: tData.cat === 0 ? 1 : 2, hiddenByUser: false\\n        });\\n\\n        edges.push({ source: 0, target: nodeId });\\n      });\\n\\n      for (let i = 1; i < nodes.length; i++) {\\n        for (let j = i + 1; j < nodes.length; j++) {\\n          const a = nodes[i];\\n          const b = nodes[j];\\n          if (a.cat === b.cat || (a.cat === 0 && b.cat === 1) || (a.cat === 0 && b.cat === 3)) {\\n            const dist = Math.hypot(a.x - b.x, a.